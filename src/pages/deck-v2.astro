---
import Base from "../layouts/Base.astro";
import WorksStory from "../components/WorksStory.astro";
import { DECK_V2 as DECK } from "../deck-v2-copy";
import { OPEN_COPY } from "../open-copy";

const { problem, solution, built, more, demo, outro } = DECK;
const cover = OPEN_COPY.hero;
const total = 8;

// 02 Problem: the bait rate, sampled as it falls from `from` to zero. The line and the number read the same samples.
const SAMPLES = 120;
const curve = Array.from({ length: SAMPLES + 1 }, (_, i) => {
  const x = i / SAMPLES;
  const v = problem.from * (1 - x) ** 1.5 * (1 + 0.1 * Math.sin(9 * x) + 0.05 * Math.sin(23 * x));
  return Math.round(Math.min(problem.from, Math.max(0, v)) * 10) / 10;
});
const askAt = [
  { x: 34, y: 12 },
  { x: 56, y: 36 },
  { x: 77, y: 56 },
];
---
<Base title={DECK.title} description={DECK.description} canonical="https://mamoru.lol/deck-v2">
  <main class="deck" id="deck" aria-roledescription="carousel" aria-label={DECK.title}>
    <header class="lockup">
      <img src="/mark-two-stones.png" width="26" height="26" alt="" />
      <span>Mamoru</span>
    </header>

    <!-- 01 Cover: the landing hero -->
    <section class="slide cover" data-slide="1" aria-roledescription="slide" aria-label="Mamoru">
      <div class="center">
        <img class="mark rise" src="/mark-two-stones.png" width="84" height="84" alt="" style="--d:0" />
        <h1 class="hero rise" style="--d:1">
          <span>{cover.line1}</span>
          <span>{cover.line2}</span>
        </h1>
        <p class="lede rise" style="--d:2">
          {cover.lede.split(". ").filter(Boolean).map((part) => (
            <span>{part.endsWith(".") ? part : `${part}.`}</span>
          ))}
        </p>
      </div>
    </section>

    <!-- 02 Problem: a rate falls to zero in ten seconds, the doubts come up, one question is left -->
    <section class="slide fall" data-slide="2" data-steps="1" aria-roledescription="slide" aria-label={problem.aria}>
      <div class="stage" aria-hidden="true" data-curve={JSON.stringify(curve)} data-from={problem.from} data-days={problem.days}>
        <p class="day">{problem.day} <span class="js-day">1</span></p>
        <p class="rate">
          <span class="js-apy">{problem.from}</span><span class="pct">%</span><span class="doubt">?</span><span class="unit">{problem.unit}</span>
        </p>
        <div class="chart">
          <svg viewBox="0 0 1000 300" preserveAspectRatio="none">
            <line class="floor" x1="0" y1="290" x2="1000" y2="290" />
            <path class="line js-line" d="" />
          </svg>
          <span class="tip js-tip"></span>
          {problem.asks.map((ask, i) => (
            <span class="ask" style={`--x:${askAt[i]?.x ?? 50}%;--y:${askAt[i]?.y ?? 50}%`}>{ask}</span>
          ))}
        </div>
      </div>
      <p class="question">
        {problem.question.map((line) => <span>{line}</span>)}
      </p>
    </section>

    <!-- 03 How it works: the landing section, as it is -->
    <section class="slide how" data-slide="3" aria-roledescription="slide" aria-label={OPEN_COPY.works.heading}>
      <WorksStory />
    </section>

    <!-- 04 Solution -->
    <section class="slide solution" data-slide="4" aria-roledescription="slide" aria-label={solution.heading}>
      <div class="split">
        <div class="copy">
          <p class="eyebrow rise" style="--d:0">02 · {solution.eyebrow}</p>
          <h2 class="rise" style="--d:1">
            {solution.heading.map((line) => <span>{line}</span>)}
          </h2>
          <ul class="points">
            {solution.points.map((p, i) => <li class="rise" style={`--d:${i + 2}`}>{p}</li>)}
          </ul>
          <dl class="versus rise" style={`--d:${solution.points.length + 2}`}>
            {solution.versus.map((v) => (
              <div class:list={{ ours: v.who === "Mamoru" }}>
                <dt>{v.who}</dt>
                <dd>{v.note}</dd>
              </div>
            ))}
          </dl>
        </div>
        <figure class="garden" aria-hidden="true">
          <svg viewBox="0 0 400 300">
            {[0, 1, 2, 3].map((r) => (
              <ellipse class="ring" cx="200" cy="150" rx={78 + r * 22} ry={60 + r * 17} pathLength="1" style={`--r:${r}`} />
            ))}
            <ellipse class="shadow" cx="204" cy="196" rx="54" ry="8" />
            <g class="settle" transform="translate(200 150)">
              <path d="M-34 -34 C-24 -52 8 -54 26 -42 C42 -31 40 -6 30 16 C19 40 -2 50 -21 45 C-41 40 -48 17 -46 -4 C-45 -17 -41 -26 -34 -34 Z" />
              <path class="half" d="M37 -3 C52 3 58 22 51 37 C46 48 34 52 21 51 Z" />
            </g>
          </svg>
          <figcaption class="rise" style="--d:5">{solution.caption}</figcaption>
        </figure>
      </div>
    </section>

    <!-- 05 How it's built -->
    <section class="slide built" data-slide="5" aria-roledescription="slide" aria-label={built.heading}>
      <div class="wide">
        <p class="eyebrow rise" style="--d:0">03 · {built.eyebrow}</p>
        <h2 class="rise" style="--d:1">{built.heading}</h2>
        <ol class="layers">
          {built.layers.map((l, i) => (
            <li class="rise" style={`--d:${i + 2}`}>
              <span class="who">{l.who}</span>
              <span class="what">{l.what}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 06 One more thing -->
    <section class="slide more" data-slide="6" data-steps="1" aria-roledescription="slide" aria-label={more.teaser}>
      <p class="teaser-line">{more.teaser}</p>
      <div class="reveal">
        <p class="eyebrow rise" style="--d:0">{more.eyebrow}</p>
        <h2 class="rise" style="--d:1">{more.heading}</h2>
        <p class="lede rise" style="--d:2">{more.lede}</p>
        <div class="verdicts rise" style="--d:3">
          {more.verdicts.map((v) => (
            <span class={`verdict ${v.tone}`}><b>{v.label}</b>{v.note}</span>
          ))}
        </div>
        <a class="link rise" style="--d:4" href={more.href} target="_blank" rel="noopener noreferrer">{more.hrefLabel}</a>
      </div>
    </section>

    <!-- 07 Demo -->
    <section class="slide demo" data-slide="7" aria-roledescription="slide" aria-label="Demo">
      <div class="center">
        <p class="eyebrow rise" style="--d:0">{demo.eyebrow}</p>
        <h2 class="demo-title rise" style="--d:1">{demo.heading}</h2>
        <div class="go rise" style="--d:2">
          <img class="qr" src="/deck-qr-app.svg" width="96" height="96" alt="QR code for app.mamoru.lol" />
          <a class="cta" href={demo.href} target="_blank" rel="noopener noreferrer">{demo.hrefLabel}</a>
        </div>
        <ol class="path rise" style="--d:3">
          {demo.path.map((s) => <li>{s}</li>)}
        </ol>
      </div>
    </section>

    <!-- 08 Outro -->
    <section class="slide outro" data-slide="8" aria-roledescription="slide" aria-label={outro.heading}>
      <div class="wide">
        <p class="eyebrow rise" style="--d:0">{outro.eyebrow}</p>
        <h2 class="rise" style="--d:1">{outro.heading}</h2>
        <ul class="futures">
          {outro.futures.map((f, i) => (
            <li class:list={["rise", { lead: f.lead }]} style={`--d:${i + 2}`}>
              <span class="who">{f.title}</span>
              <span class="what">{f.body}</span>
            </li>
          ))}
        </ul>
        <div class="outro-foot rise" style={`--d:${outro.futures.length + 2}`}>
          <button type="button" class="cta ghost js-restart">{outro.restart}</button>
          <span class="links">
            {outro.links.map((l) => <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a>)}
          </span>
        </div>
      </div>
    </section>

    <nav class="dots" aria-label="Slides">
      {Array.from({ length: total }, (_, i) => (
        <button type="button" class="dot" data-go={i + 1} aria-label={`Slide ${i + 1}`}></button>
      ))}
    </nav>
    <p class="count" aria-live="polite"><span class="js-now">01</span> / {String(total).padStart(2, "0")}</p>
  </main>

  <script>
    const deck = document.getElementById("deck")!;
    const slides = [...deck.querySelectorAll<HTMLElement>(".slide")];
    const dots = [...deck.querySelectorAll<HTMLButtonElement>(".dot")];
    const now = deck.querySelector<HTMLElement>(".js-now")!;
    let at = 0;
    let step = 0;
    let shown = -1;

    const fromHash = () => {
      const n = Number(location.hash.slice(1));
      return Number.isInteger(n) && n >= 1 && n <= slides.length ? n - 1 : 0;
    };

    function show(i: number, s = 0) {
      at = Math.max(0, Math.min(slides.length - 1, i));
      step = s;
      slides.forEach((el, k) => {
        el.classList.toggle("on", k === at);
        el.classList.toggle("past", k < at);
        el.dataset.step = k === at ? String(step) : "0";
        el.inert = k !== at;
      });
      const onFall = slides[at]?.classList.contains("fall") === true;
      // Once the fall has given way to the question, its stage stays out of sight until the fall starts again.
      if (onFall && step > 0) fall?.classList.add("spent");
      playFall(onFall && step === 0);
      if (at !== shown && slides[at]?.classList.contains("how")) {
        slides[at]?.querySelector("#works")?.dispatchEvent(new Event("works:restart"));
      }
      shown = at;
      dots.forEach((d, k) => d.setAttribute("aria-current", k === at ? "step" : "false"));
      now.textContent = String(at + 1).padStart(2, "0");
      const hash = `#${at + 1}`;
      // Inside the staging preview the page has a cross-origin <base>, and the browser refuses the new URL.
      try {
        if (location.hash !== hash) history.replaceState(null, "", hash);
      } catch {}
    }

    // 02 Problem: ten seconds. The rate falls to zero, 0%? blinks in red, then the question takes the slide.
    const FALL_WAIT = 400;
    const FALL_FOR = 7200;
    const BLINK_FOR = 2400;
    const GREEN = [47, 93, 80];
    const RED = [155, 44, 44];
    const ASK_AT = [0.28, 0.5, 0.72];
    const quiet = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const fall = deck.querySelector<HTMLElement>(".fall");
    const stage = fall?.querySelector<HTMLElement>(".stage");
    const apy = fall?.querySelector<HTMLElement>(".js-apy");
    const day = fall?.querySelector<HTMLElement>(".js-day");
    const line = fall?.querySelector<SVGPathElement>(".js-line");
    const tip = fall?.querySelector<HTMLElement>(".js-tip");
    const asks = [...(fall?.querySelectorAll<HTMLElement>(".ask") ?? [])];
    const curve: number[] = JSON.parse(stage?.dataset.curve ?? "[]");
    const from = Number(stage?.dataset.from ?? 0) || 1;
    const days = Number(stage?.dataset.days ?? 1);
    const yOf = (v: number) => 10 + (1 - v / from) * 280;
    let fallTimers: number[] = [];
    let fallFrame = 0;

    function drawFall(p: number) {
      if (!stage || !apy || !day || !line || !tip || curve.length < 2) return;
      const last = curve.length - 1;
      const at = p * last;
      const i = Math.min(last - 1, Math.floor(at));
      const v = curve[i]! + (curve[i + 1]! - curve[i]!) * (at - i);
      const heat = Math.min(1, (1 - v / from) * 1.15);
      const tone = GREEN.map((g, k) => Math.round(g + (RED[k]! - g) * heat));
      let d = "";
      for (let k = 0; k <= i; k++) d += `${k ? "L" : "M"}${((k / last) * 1000).toFixed(1)} ${yOf(curve[k]!).toFixed(1)}`;
      d += `L${(p * 1000).toFixed(1)} ${yOf(v).toFixed(1)}`;
      line.setAttribute("d", d);
      stage.style.setProperty("--tone", `rgb(${tone.join(" ")})`);
      tip.style.left = `${p * 100}%`;
      tip.style.top = `${(yOf(v) / 300) * 100}%`;
      apy.textContent = String(Math.round(v));
      day.textContent = String(1 + Math.floor(p * (days - 1) + 1e-6));
      asks.forEach((a, k) => a.classList.toggle("show", p >= ASK_AT[k]!));
      stage.classList.toggle("zero", p >= 1);
    }

    function playFall(on: boolean) {
      fallTimers.forEach((t) => clearTimeout(t));
      fallTimers = [];
      cancelAnimationFrame(fallFrame);
      // Leave the last frame in place while the stage fades; the rate only goes back to the top when the fall starts again.
      if (!on) return;
      fall?.classList.remove("spent");
      drawFall(0);
      const here = at;
      const done = () => {
        if (at === here && step === 0) show(here, 1);
      };
      if (quiet) {
        fallTimers.push(window.setTimeout(done, 0));
        return;
      }
      fallTimers.push(
        window.setTimeout(() => {
          const t0 = performance.now();
          const tick = (t: number) => {
            const p = Math.min(1, (t - t0) / FALL_FOR);
            drawFall(p);
            if (p < 1) fallFrame = requestAnimationFrame(tick);
            else fallTimers.push(window.setTimeout(done, BLINK_FOR));
          };
          fallFrame = requestAnimationFrame(tick);
        }, FALL_WAIT),
      );
    }

    function next() {
      const steps = Number(slides[at]?.dataset.steps ?? 0);
      if (step < steps) show(at, step + 1);
      else if (at < slides.length - 1) show(at + 1);
    }
    function prev() {
      if (step > 0) show(at, step - 1);
      else if (at > 0) {
        const steps = Number(slides[at - 1]?.dataset.steps ?? 0);
        show(at - 1, steps);
      }
    }

    document.addEventListener("keydown", (e) => {
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      const k = e.key;
      if (k === "ArrowRight" || k === "PageDown" || k === " " || k === "Enter") {
        if (k === "Enter" && (e.target as HTMLElement).closest("a,button")) return;
        e.preventDefault();
        next();
      } else if (k === "ArrowLeft" || k === "PageUp" || k === "Backspace") {
        e.preventDefault();
        prev();
      } else if (k === "Home") show(0);
      else if (k === "End") show(slides.length - 1);
      else if (k === "f") {
        if (document.fullscreenElement) document.exitFullscreen();
        else document.documentElement.requestFullscreen?.();
      }
    });

    // Click the right two thirds to advance, the left third to go back.
    deck.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a,button")) return;
      if (e.clientX < window.innerWidth / 3) prev();
      else next();
    });

    let x0: number | null = null;
    deck.addEventListener("touchstart", (e) => { x0 = e.touches[0]?.clientX ?? null; }, { passive: true });
    deck.addEventListener("touchend", (e) => {
      const x1 = e.changedTouches[0]?.clientX;
      if (x0 === null || x1 === undefined) return;
      const dx = x1 - x0;
      x0 = null;
      if (Math.abs(dx) < 48) return;
      if (dx < 0) next();
      else prev();
    });

    dots.forEach((d) => d.addEventListener("click", () => show(Number(d.dataset.go) - 1)));
    deck.querySelector(".js-restart")?.addEventListener("click", () => show(0));
    window.addEventListener("hashchange", () => {
      if (fromHash() !== at) show(fromHash());
    });

    show(fromHash());
    requestAnimationFrame(() => deck.classList.add("ready"));
  </script>
</Base>

<style>
  :global(html),
  :global(body) {
    height: 100%;
    overflow: hidden;
  }
  /* Type grows with the screen, so a projector reads like a laptop. */
  :global(html) {
    font-size: clamp(16px, 1.12vw, 26px);
  }

  .deck {
    --ease: cubic-bezier(0.2, 0.8, 0.2, 1);
    --muted: color-mix(in srgb, var(--ink) 60%, var(--paper));
    position: relative;
    width: 100vw;
    height: 100dvh;
    overflow: hidden;
    user-select: none;
    cursor: default;
  }

  .lockup {
    position: absolute;
    top: clamp(1rem, 3vh, 2rem);
    left: clamp(1rem, 4vw, 3rem);
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 1.05rem;
    letter-spacing: 0.02em;
  }

  /* Slides stack in place and cross-fade. */
  .slide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(4.5rem, 10vh, 7rem) clamp(1.25rem, 7vw, 7rem);
    opacity: 0;
    visibility: hidden;
    transform: translateX(1.5rem);
    transition:
      opacity 0.9s var(--ease),
      transform 1.1s var(--ease),
      visibility 0s linear 0.9s;
  }
  .slide.past {
    transform: translateX(-1.5rem);
  }
  .slide.on {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 0.9s var(--ease) 0.15s,
      transform 1.1s var(--ease) 0.15s,
      visibility 0s;
  }

  /* Pieces rise in, one after another, when their slide arrives. */
  .rise {
    opacity: 0;
    transform: translateY(12px);
  }
  .on .rise {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.8s ease,
      transform 1s var(--ease);
    transition-delay: calc(0.35s + var(--d, 0) * 0.14s);
  }

  .center {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(0.9rem, 2.2vh, 1.4rem);
  }
  .wide {
    width: min(68rem, 100%);
  }
  .split {
    width: min(72rem, 100%);
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0 0 clamp(1rem, 2.5vh, 1.75rem);
    font-size: 0.75rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--emerald);
  }
  .eyebrow::after {
    content: "";
    width: 2rem;
    height: 1px;
    background: currentColor;
  }
  .center .eyebrow {
    margin: 0;
  }
  .center .eyebrow::after {
    display: none;
  }

  h1,
  h2 {
    margin: 0;
    font-weight: 400;
  }
  h2 {
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    line-height: 1.08;
    letter-spacing: 0.005em;
  }
  h2 span {
    display: block;
  }

  .lede {
    margin: 0;
    max-width: 34ch;
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    line-height: 1.45;
    color: var(--muted);
  }
  .kicker {
    margin: clamp(0.5rem, 2vh, 1.25rem) 0 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--stone);
  }

  .points {
    list-style: none;
    margin: clamp(1.5rem, 4vh, 2.5rem) 0 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }
  .points li {
    position: relative;
    padding-left: 1.6rem;
    font-size: clamp(1.05rem, 1.7vw, 1.3rem);
    line-height: 1.4;
    color: color-mix(in srgb, var(--ink) 80%, var(--paper));
  }
  .points li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 0.7rem;
    height: 1px;
    background: var(--emerald);
  }

  /* 01 Cover: the landing hero, with the landing's own proportions (open.astro .hero). */
  .cover .center {
    gap: 0;
  }
  .cover .mark {
    width: clamp(4.15rem, 6.25vw, 5.35rem);
    height: auto;
  }
  .cover .hero {
    display: flex;
    flex-direction: column;
    margin: clamp(0.78rem, 2.6vh, 1.22rem) 0 0;
    font-size: clamp(2.4rem, 8vw, 5.2rem);
    line-height: 0.95;
    letter-spacing: 0.04em;
  }
  .cover .lede {
    margin: clamp(1.1rem, 3vh, 1.8rem) 0 0;
    max-width: none;
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    line-height: 1.35;
    color: var(--ink);
  }
  .cover .lede span {
    display: block;
  }

  /* 02 Problem: the rate goes from green to red as it falls, and the line falls with it. */
  .fall .stage {
    --tone: var(--emerald);
    width: min(64rem, 100%);
    transition: opacity 0.25s ease;
  }
  .fall.spent .stage {
    opacity: 0;
  }
  .day {
    margin: 0 0 clamp(0.4rem, 1.5vh, 0.9rem);
    font-family: var(--font-mono);
    font-size: clamp(0.75rem, 1.1vw, 0.9rem);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--stone);
    font-variant-numeric: tabular-nums;
  }
  .rate {
    margin: 0;
    font-size: clamp(4rem, 13vw, 10rem);
    line-height: 1;
    letter-spacing: 0.01em;
    color: var(--tone);
    font-variant-numeric: tabular-nums;
  }
  .rate .doubt {
    display: none;
  }
  .zero .rate .doubt {
    display: inline;
  }
  /* The end of the fall: 0%? breathes twice in the alert red the app uses. */
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }
  .zero .rate {
    color: #9b2c2c;
    animation: blink 1.2s ease-in-out 2;
  }
  .zero .rate .unit {
    visibility: hidden;
  }
  .rate .unit {
    margin-left: 0.5em;
    font-family: var(--font-mono);
    font-size: 0.2em;
    letter-spacing: 0.2em;
    vertical-align: 0.9em;
  }
  .chart {
    position: relative;
    height: min(18rem, 34vh);
    margin-top: clamp(1rem, 3vh, 2rem);
  }
  .chart svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .floor {
    stroke: var(--wash);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .line {
    fill: none;
    stroke: var(--tone);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .tip {
    position: absolute;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--tone);
