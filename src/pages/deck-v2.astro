---
import Base from "../layouts/Base.astro";
import { DECK_V2 as DECK } from "../deck-v2-copy";

const { hook, problem, solution, built, more, demo, outro } = DECK;
const total = 6;
---
<Base title={DECK.title} description={DECK.description} canonical="https://mamoru.lol/deck-v2">
  <main class="deck" id="deck" aria-roledescription="carousel" aria-label={DECK.title}>
    <header class="lockup">
      <img src="/mark-two-stones.png" width="26" height="26" alt="" />
      <span>Mamoru</span>
    </header>

    <!-- 01 Hook, then the problem. The hook plays once and gives way to the problem copy; a click skips ahead. -->
    <section class="slide hook" data-slide="1" data-steps="1" aria-roledescription="slide" aria-label={hook.aria}>
      <div class="act act-title">
        <img class="mark" src="/mark-two-stones.png" width="56" height="56" alt="" />
        <p class="name">{hook.name}</p>
        <h1 class="claim">
          {hook.claim.map((line) => <span>{line}</span>)}
        </h1>
        <p class="formula">
          <span>{hook.formula[0]}</span>
          <i aria-hidden="true">→</i>
          <span class="unknown">{hook.formula[1]}</span>
          <i aria-hidden="true">→</i>
          <span class="saved">{hook.formula[2]}</span>
        </p>
      </div>

      <div class="act act-bait" aria-hidden="true" data-from={hook.bait.from} data-to={hook.bait.to} data-days={hook.bait.days}>
        <p class="day">{hook.bait.day} <span class="js-day">1</span></p>
        <p class="bait">
          <span class="js-apy">{hook.bait.from}</span><span class="pct">%</span><span class="unit">{hook.bait.unit}</span>
        </p>
        <p class="asks">
          {hook.asks.map((ask, i) => <span style={`--i:${i}`}>{ask}</span>)}
        </p>
      </div>

      <p class="act act-ask" aria-hidden="true">
        {hook.question.map((line) => <span>{line}</span>)}
      </p>

      <div class="act act-problem">
        <div class="copy">
          <p class="eyebrow rise" style="--d:0">01 · {problem.eyebrow}</p>
          <h2 class="rise" style="--d:1">
            {problem.heading.map((line) => <span>{line}</span>)}
          </h2>
          <ul class="points">
            {problem.points.map((p, i) => <li class="rise" style={`--d:${i + 2}`}>{p}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <!-- 02 Solution -->
    <section class="slide solution" data-slide="2" aria-roledescription="slide" aria-label={solution.heading}>
      <div class="split">
        <div class="copy">
          <p class="eyebrow rise" style="--d:0">02 · {solution.eyebrow}</p>
          <h2 class="rise" style="--d:1">
            {solution.heading.map((line) => <span>{line}</span>)}
          </h2>
          <ul class="points">
            {solution.points.map((p, i) => <li class="rise" style={`--d:${i + 2}`}>{p}</li>)}
          </ul>
          <dl class="versus rise" style={`--d:${solution.points.length + 2}`}>
            {solution.versus.map((v) => (
              <div class:list={{ ours: v.who === "Mamoru" }}>
                <dt>{v.who}</dt>
                <dd>{v.note}</dd>
              </div>
            ))}
          </dl>
        </div>
        <figure class="garden" aria-hidden="true">
          <svg viewBox="0 0 400 300">
            {[0, 1, 2, 3].map((r) => (
              <ellipse class="ring" cx="200" cy="150" rx={78 + r * 22} ry={60 + r * 17} pathLength="1" style={`--r:${r}`} />
            ))}
            <ellipse class="shadow" cx="204" cy="196" rx="54" ry="8" />
            <g class="settle" transform="translate(200 150)">
              <path d="M-34 -34 C-24 -52 8 -54 26 -42 C42 -31 40 -6 30 16 C19 40 -2 50 -21 45 C-41 40 -48 17 -46 -4 C-45 -17 -41 -26 -34 -34 Z" />
              <path class="half" d="M37 -3 C52 3 58 22 51 37 C46 48 34 52 21 51 Z" />
            </g>
          </svg>
          <figcaption class="rise" style="--d:5">{solution.caption}</figcaption>
        </figure>
      </div>
    </section>

    <!-- 03 How it's built -->
    <section class="slide built" data-slide="3" aria-roledescription="slide" aria-label={built.heading}>
      <div class="wide">
        <p class="eyebrow rise" style="--d:0">03 · {built.eyebrow}</p>
        <h2 class="rise" style="--d:1">{built.heading}</h2>
        <ol class="layers">
          {built.layers.map((l, i) => (
            <li class="rise" style={`--d:${i + 2}`}>
              <span class="who">{l.who}</span>
              <span class="what">{l.what}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 04 One more thing -->
    <section class="slide more" data-slide="4" data-steps="1" aria-roledescription="slide" aria-label={more.teaser}>
      <p class="teaser-line">{more.teaser}</p>
      <div class="reveal">
        <p class="eyebrow rise" style="--d:0">{more.eyebrow}</p>
        <h2 class="rise" style="--d:1">{more.heading}</h2>
        <p class="lede rise" style="--d:2">{more.lede}</p>
        <div class="verdicts rise" style="--d:3">
          {more.verdicts.map((v) => (
            <span class={`verdict ${v.tone}`}><b>{v.label}</b>{v.note}</span>
          ))}
        </div>
        <a class="link rise" style="--d:4" href={more.href} target="_blank" rel="noopener noreferrer">{more.hrefLabel}</a>
      </div>
    </section>

    <!-- 05 Demo -->
    <section class="slide demo" data-slide="5" aria-roledescription="slide" aria-label="Demo">
      <div class="center">
        <p class="eyebrow rise" style="--d:0">{demo.eyebrow}</p>
        <h2 class="demo-title rise" style="--d:1">{demo.heading}</h2>
        <div class="go rise" style="--d:2">
          <img class="qr" src="/deck-qr-app.svg" width="96" height="96" alt="QR code for app.mamoru.lol" />
          <a class="cta" href={demo.href} target="_blank" rel="noopener noreferrer">{demo.hrefLabel}</a>
        </div>
        <ol class="path rise" style="--d:3">
          {demo.path.map((s) => <li>{s}</li>)}
        </ol>
      </div>
    </section>

    <!-- 06 Outro -->
    <section class="slide outro" data-slide="6" aria-roledescription="slide" aria-label={outro.heading}>
      <div class="wide">
        <p class="eyebrow rise" style="--d:0">{outro.eyebrow}</p>
        <h2 class="rise" style="--d:1">{outro.heading}</h2>
        <ul class="futures">
          {outro.futures.map((f, i) => (
            <li class:list={["rise", { lead: f.lead }]} style={`--d:${i + 2}`}>
              <span class="who">{f.title}</span>
              <span class="what">{f.body}</span>
            </li>
          ))}
        </ul>
        <div class="outro-foot rise" style={`--d:${outro.futures.length + 2}`}>
          <button type="button" class="cta ghost js-restart">{outro.restart}</button>
          <span class="links">
            {outro.links.map((l) => <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a>)}
          </span>
        </div>
      </div>
    </section>

    <nav class="dots" aria-label="Slides">
      {Array.from({ length: total }, (_, i) => (
        <button type="button" class="dot" data-go={i + 1} aria-label={`Slide ${i + 1}`}></button>
      ))}
    </nav>
    <p class="count" aria-live="polite"><span class="js-now">01</span> / {String(total).padStart(2, "0")}</p>
  </main>

  <script>
    const deck = document.getElementById("deck")!;
    const slides = [...deck.querySelectorAll<HTMLElement>(".slide")];
    const dots = [...deck.querySelectorAll<HTMLButtonElement>(".dot")];
    const now = deck.querySelector<HTMLElement>(".js-now")!;
    let at = 0;
    let step = 0;

    const fromHash = () => {
      const n = Number(location.hash.slice(1));
      return Number.isInteger(n) && n >= 1 && n <= slides.length ? n - 1 : 0;
    };

    function show(i: number, s = 0) {
      at = Math.max(0, Math.min(slides.length - 1, i));
      step = s;
      slides.forEach((el, k) => {
        el.classList.toggle("on", k === at);
        el.classList.toggle("past", k < at);
        el.dataset.step = k === at ? String(step) : "0";
        el.inert = k !== at;
      });
      playHook(at === 0 && step === 0);
      dots.forEach((d, k) => d.setAttribute("aria-current", k === at ? "step" : "false"));
      now.textContent = String(at + 1).padStart(2, "0");
      const hash = `#${at + 1}`;
      if (location.hash !== hash) history.replaceState(null, "", hash);
    }

    // 01 Hook: the bait counts down while the days go by, then the slide moves on to the problem by itself.
    const HOOK_COUNT_AT = 4800;
    const HOOK_COUNT_FOR = 2800;
    const HOOK_ENDS_AT = 12100;
    const quiet = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const bait = deck.querySelector<HTMLElement>(".act-bait");
    const apy = deck.querySelector<HTMLElement>(".js-apy");
    const day = deck.querySelector<HTMLElement>(".js-day");
    let hookTimers: number[] = [];
    let hookFrame = 0;

    function playHook(on: boolean) {
      hookTimers.forEach((t) => clearTimeout(t));
      hookTimers = [];
      cancelAnimationFrame(hookFrame);
      if (!bait || !apy || !day) return;
      const from = Number(bait.dataset.from);
      const to = Number(bait.dataset.to);
      const days = Number(bait.dataset.days);
      apy.textContent = String(from);
      day.textContent = "1";
      if (!on) return;
      if (quiet) {
        hookTimers.push(window.setTimeout(() => show(0, 1), 0));
        return;
      }
      hookTimers.push(
        window.setTimeout(() => {
          const t0 = performance.now();
          const tick = (t: number) => {
            const raw = Math.min(1, (t - t0) / HOOK_COUNT_FOR);
            const p = raw * raw;
            apy.textContent = String(Math.round(from - (from - to) * p));
            day.textContent = String(1 + Math.round((days - 1) * raw));
            if (raw < 1) hookFrame = requestAnimationFrame(tick);
          };
          hookFrame = requestAnimationFrame(tick);
        }, HOOK_COUNT_AT),
        window.setTimeout(() => {
          if (at === 0 && step === 0) show(0, 1);
        }, HOOK_ENDS_AT),
      );
    }

    function next() {
      const steps = Number(slides[at]?.dataset.steps ?? 0);
      if (step < steps) show(at, step + 1);
      else if (at < slides.length - 1) show(at + 1);
    }
    function prev() {
      if (step > 0) show(at, step - 1);
      else if (at > 0) {
        const steps = Number(slides[at - 1]?.dataset.steps ?? 0);
        show(at - 1, steps);
      }
    }

    document.addEventListener("keydown", (e) => {
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      const k = e.key;
      if (k === "ArrowRight" || k === "PageDown" || k === " " || k === "Enter") {
        if (k === "Enter" && (e.target as HTMLElement).closest("a,button")) return;
        e.preventDefault();
        next();
      } else if (k === "ArrowLeft" || k === "PageUp" || k === "Backspace") {
        e.preventDefault();
        prev();
      } else if (k === "Home") show(0);
      else if (k === "End") show(slides.length - 1);
      else if (k === "f") {
        if (document.fullscreenElement) document.exitFullscreen();
        else document.documentElement.requestFullscreen?.();
      }
    });

    // Click the right two thirds to advance, the left third to go back.
    deck.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a,button")) return;
      if (e.clientX < window.innerWidth / 3) prev();
      else next();
    });

    let x0: number | null = null;
    deck.addEventListener("touchstart", (e) => { x0 = e.touches[0]?.clientX ?? null; }, { passive: true });
    deck.addEventListener("touchend", (e) => {
      const x1 = e.changedTouches[0]?.clientX;
      if (x0 === null || x1 === undefined) return;
      const dx = x1 - x0;
      x0 = null;
      if (Math.abs(dx) < 48) return;
      if (dx < 0) next();
      else prev();
    });

    dots.forEach((d) => d.addEventListener("click", () => show(Number(d.dataset.go) - 1)));
    deck.querySelector(".js-restart")?.addEventListener("click", () => show(0));
    window.addEventListener("hashchange", () => {
      if (fromHash() !== at) show(fromHash());
    });

    show(fromHash());
    requestAnimationFrame(() => deck.classList.add("ready"));
  </script>
</Base>

<style>
  :global(html),
  :global(body) {
    height: 100%;
    overflow: hidden;
  }
  /* Type grows with the screen, so a projector reads like a laptop. */
  :global(html) {
    font-size: clamp(16px, 1.12vw, 26px);
  }

  .deck {
    --ease: cubic-bezier(0.2, 0.8, 0.2, 1);
    --muted: color-mix(in srgb, var(--ink) 60%, var(--paper));
    position: relative;
    width: 100vw;
    height: 100dvh;
    overflow: hidden;
    user-select: none;
    cursor: default;
  }

  .lockup {
    position: absolute;
    top: clamp(1rem, 3vh, 2rem);
    left: clamp(1rem, 4vw, 3rem);
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 1.05rem;
    letter-spacing: 0.02em;
  }

  /* Slides stack in place and cross-fade. */
  .slide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(4.5rem, 10vh, 7rem) clamp(1.25rem, 7vw, 7rem);
    opacity: 0;
    visibility: hidden;
    transform: translateX(1.5rem);
    transition:
      opacity 0.9s var(--ease),
      transform 1.1s var(--ease),
      visibility 0s linear 0.9s;
  }
  .slide.past {
    transform: translateX(-1.5rem);
  }
  .slide.on {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 0.9s var(--ease) 0.15s,
      transform 1.1s var(--ease) 0.15s,
      visibility 0s;
  }

  /* Pieces rise in, one after another, when their slide arrives. */
  .rise {
    opacity: 0;
    transform: translateY(12px);
  }
  .on .rise {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.8s ease,
      transform 1s var(--ease);
    transition-delay: calc(0.35s + var(--d, 0) * 0.14s);
  }

  .center {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(0.9rem, 2.2vh, 1.4rem);
  }
  .wide {
    width: min(68rem, 100%);
  }
  .split {
    width: min(72rem, 100%);
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0 0 clamp(1rem, 2.5vh, 1.75rem);
    font-size: 0.75rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--emerald);
  }
  .eyebrow::after {
    content: "";
    width: 2rem;
    height: 1px;
    background: currentColor;
  }
  .center .eyebrow {
    margin: 0;
  }
  .center .eyebrow::after {
    display: none;
  }

  h1,
  h2 {
    margin: 0;
    font-weight: 400;
  }
  h2 {
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    line-height: 1.08;
    letter-spacing: 0.005em;
  }
  h2 span {
    display: block;
  }

  .lede {
    margin: 0;
    max-width: 34ch;
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    line-height: 1.45;
    color: var(--muted);
  }
  .kicker {
    margin: clamp(0.5rem, 2vh, 1.25rem) 0 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--stone);
  }

  .points {
    list-style: none;
    margin: clamp(1.5rem, 4vh, 2.5rem) 0 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }
  .points li {
    position: relative;
    padding-left: 1.6rem;
    font-size: clamp(1.05rem, 1.7vw, 1.3rem);
    line-height: 1.4;
    color: color-mix(in srgb, var(--ink) 80%, var(--paper));
  }
  .points li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 0.7rem;
    height: 1px;
    background: var(--emerald);
  }

  /* 01 Hook: a title, a rate that falls apart, one question. Then the problem stays. */
  .hook .act {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    margin: 0;
    padding: clamp(4.5rem, 10vh, 7rem) clamp(1.25rem, 7vw, 7rem);
    opacity: 0;
    pointer-events: none;
  }
  @keyframes act {
    0% { opacity: 0; transform: translateY(10px); }
    14% { opacity: 1; transform: none; }
    86% { opacity: 1; transform: none; }
    100% { opacity: 0; transform: translateY(-6px); }
  }
  .hook.on[data-step="0"] .act-title {
    animation: act 3s var(--ease) 0.4s both;
  }
  .hook.on[data-step="0"] .act-bait {
    animation: act 5s var(--ease) 3.4s both;
  }
  .hook.on[data-step="0"] .act-ask {
    animation: act 3.4s var(--ease) 8.6s both;
  }

  .act-title .mark {
    width: clamp(2.6rem, 4vw, 3.5rem);
    height: auto;
  }
  .name {
    margin: 0.6rem 0 clamp(1.2rem, 4vh, 2.2rem);
    font-size: clamp(1.1rem, 1.6vw, 1.4rem);
    letter-spacing: 0.02em;
  }
  .claim {
    display: flex;
    flex-direction: column;
    margin: 0;
    font-weight: 400;
    font-size: clamp(2.4rem, 6.2vw, 5rem);
    line-height: 1.06;
    letter-spacing: 0.005em;
  }
  .claim span + span {
    color: var(--emerald);
  }
  .formula {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 0.4em 1.1em;
    margin: clamp(1.6rem, 5vh, 3rem) 0 0;
    font-family: var(--font-mono);
    font-size: clamp(0.85rem, 1.4vw, 1.1rem);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .formula i {
    font-style: normal;
    color: var(--stone);
  }
  .formula .unknown {
    color: var(--ink);
  }
  .formula .saved {
    color: var(--emerald);
  }

  .day {
    margin: 0 0 clamp(0.6rem, 2vh, 1.2rem);
    font-family: var(--font-mono);
    font-size: clamp(0.75rem, 1.1vw, 0.9rem);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--stone);
    font-variant-numeric: tabular-nums;
  }
  .bait {
    margin: 0;
    font-size: clamp(4.5rem, 17vw, 13rem);
    line-height: 1;
    letter-spacing: 0.01em;
    font-variant-numeric: tabular-nums;
  }
  .bait .unit {
    margin-left: 0.5em;
    font-family: var(--font-mono);
    font-size: 0.2em;
    letter-spacing: 0.2em;
    vertical-align: 0.9em;
  }
  @keyframes sink {
    to { opacity: 0.3; transform: translateY(1.6rem) scale(0.84); }
  }
  .hook.on[data-step="0"] .bait {
    animation: sink 2.8s cubic-bezier(0.5, 0, 0.9, 0.6) 4.8s both;
  }
  .asks {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.3em 1.6em;
    margin: clamp(1.2rem, 4vh, 2.4rem) 0 0;
    font-size: clamp(1.5rem, 3.2vw, 2.6rem);
    font-style: italic;
  }
  .asks span {
    opacity: 0;
  }
  @keyframes ask {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }
  .hook.on[data-step="0"] .asks span {
    animation: ask 0.3s ease-out both;
    animation-delay: calc(6s + var(--i) * 0.32s);
  }

  .act-ask {
    font-size: clamp(2.2rem, 5.4vw, 4.4rem);
    line-height: 1.1;
  }
  .act-ask span {
    display: block;
  }
  .act-ask span + span {
    font-style: italic;
    color: var(--emerald);
  }

  /* The problem copy: one column, read left to right, set in the middle of the slide. */
  .hook .act-problem {
    opacity: 1;
    text-align: left;
  }
  .hook .act-problem .copy {
    width: min(46rem, 100%);
  }
  .hook[data-step="0"] .act-problem .rise {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.4s ease;
  }
  .hook h2 {
    font-size: clamp(2rem, 4.2vw, 3.3rem);
  }
  .hook h2 span + span {
    color: var(--emerald);
  }

  .versus {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: clamp(1.75rem, 4.5vh, 2.75rem) 0 0;
    padding-top: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--ink) 10%, transparent);
  }
  .versus dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--stone);
  }
  .versus dd {
    margin: 0.35rem 0 0;
    font-size: clamp(0.95rem, 1.3vw, 1.05rem);
    color: var(--muted);
  }
  .versus .ours dt {
    color: var(--emerald);
  }
  .versus .ours dd {
    color: var(--ink);
  }

  .solution h2 span:last-child {
    color: var(--emerald);
  }

  /* 03 Solution: the mark settles into raked rings. */
  .garden {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  .garden svg {
    width: 100%;
    max-width: 26rem;
