---
import Base from "../layouts/Base.astro";
import { DECK } from "../deck-copy";

const { intro, problem, solution, built, more, demo, outro } = DECK;
const total = 7;
---
<Base title={DECK.title} description={DECK.description} canonical="https://mamoru.lol/deck">
  <main class="deck" id="deck" aria-roledescription="carousel" aria-label={DECK.title}>
    <header class="lockup">
      <img src="/mark-two-stones.png" width="26" height="26" alt="" />
      <span>Mamoru</span>
    </header>

    <!-- 01 Intro -->
    <section class="slide intro" data-slide="1" aria-roledescription="slide" aria-label="Mamoru">
      <svg class="rakes" viewBox="0 0 1200 240" preserveAspectRatio="none" aria-hidden="true">
        {Array.from({ length: 6 }, (_, i) => {
          const y = 40 + i * 32;
          return <path d={`M0 ${y} C300 ${y - 4} 600 ${y + 4} 900 ${y} S1200 ${y - 3} 1200 ${y}`} pathLength="1" style={`--i:${i}`} />;
        })}
      </svg>
      <div class="center">
        <img class="mark rise" src="/mark-two-stones.png" width="72" height="72" alt="" style="--d:0" />
        <h1 class="hero rise" style="--d:1">
          <span>APY.</span>
          <span>DELIVERED.</span>
        </h1>
        <p class="lede rise" style="--d:2">{intro.lede}</p>
        <p class="kicker rise" style="--d:3">{intro.kicker}</p>
      </div>
    </section>

    <!-- 02 Problem -->
    <section class="slide problem" data-slide="2" aria-roledescription="slide" aria-label={problem.heading}>
      <div class="split">
        <div class="copy">
          <p class="eyebrow rise" style="--d:0">01 · {problem.eyebrow}</p>
          <h2 class="rise" style="--d:1">
            {problem.heading.map((line) => <span>{line}</span>)}
          </h2>
          <ul class="points">
            {problem.points.map((p, i) => <li class="rise" style={`--d:${i + 2}`}>{p}</li>)}
          </ul>
        </div>
        <figure class="scatter" aria-hidden="true">
          {problem.chips.map((c, i) => (
            <span class:list={["chip", c.tone]} style={`--x:${c.x}%;--y:${c.y}%;--i:${i}`}>{c.label}</span>
          ))}
        </figure>
      </div>
    </section>

    <!-- 03 Solution -->
    <section class="slide solution" data-slide="3" aria-roledescription="slide" aria-label={solution.heading}>
      <div class="split">
        <div class="copy">
          <p class="eyebrow rise" style="--d:0">02 · {solution.eyebrow}</p>
          <h2 class="rise" style="--d:1">
            {solution.heading.map((line) => <span>{line}</span>)}
          </h2>
          <ul class="points">
            {solution.points.map((p, i) => <li class="rise" style={`--d:${i + 2}`}>{p}</li>)}
          </ul>
          <dl class="versus rise" style={`--d:${solution.points.length + 2}`}>
            {solution.versus.map((v) => (
              <div class:list={{ ours: v.who === "Mamoru" }}>
                <dt>{v.who}</dt>
                <dd>{v.note}</dd>
              </div>
            ))}
          </dl>
        </div>
        <figure class="garden" aria-hidden="true">
          <svg viewBox="0 0 400 300">
            {[0, 1, 2, 3].map((r) => (
              <ellipse class="ring" cx="200" cy="150" rx={78 + r * 22} ry={60 + r * 17} pathLength="1" style={`--r:${r}`} />
            ))}
            <ellipse class="shadow" cx="204" cy="196" rx="54" ry="8" />
            <g class="settle" transform="translate(200 150)">
              <path d="M-34 -34 C-24 -52 8 -54 26 -42 C42 -31 40 -6 30 16 C19 40 -2 50 -21 45 C-41 40 -48 17 -46 -4 C-45 -17 -41 -26 -34 -34 Z" />
              <path class="half" d="M37 -3 C52 3 58 22 51 37 C46 48 34 52 21 51 Z" />
            </g>
          </svg>
          <figcaption class="rise" style="--d:5">{solution.caption}</figcaption>
        </figure>
      </div>
    </section>

    <!-- 04 How it's built -->
    <section class="slide built" data-slide="4" aria-roledescription="slide" aria-label={built.heading}>
      <div class="wide">
        <p class="eyebrow rise" style="--d:0">03 · {built.eyebrow}</p>
        <h2 class="rise" style="--d:1">{built.heading}</h2>
        <ol class="layers">
          {built.layers.map((l, i) => (
            <li class="rise" style={`--d:${i + 2}`}>
              <span class="who">{l.who}</span>
              <span class="what">{l.what}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 05 One more thing -->
    <section class="slide more" data-slide="5" data-steps="1" aria-roledescription="slide" aria-label={more.teaser}>
      <p class="teaser-line">{more.teaser}</p>
      <div class="reveal">
        <p class="eyebrow rise" style="--d:0">{more.eyebrow}</p>
        <h2 class="rise" style="--d:1">{more.heading}</h2>
        <p class="lede rise" style="--d:2">{more.lede}</p>
        <div class="verdicts rise" style="--d:3">
          {more.verdicts.map((v) => (
            <span class={`verdict ${v.tone}`}><b>{v.label}</b>{v.note}</span>
          ))}
        </div>
        <p class="kicker rise" style="--d:4">{more.note}</p>
        <a class="link rise" style="--d:5" href={more.href} target="_blank" rel="noopener noreferrer">{more.hrefLabel}</a>
      </div>
    </section>

    <!-- 06 Demo -->
    <section class="slide demo" data-slide="6" aria-roledescription="slide" aria-label="Demo">
      <div class="center">
        <p class="eyebrow rise" style="--d:0">{demo.eyebrow}</p>
        <h2 class="demo-title rise" style="--d:1">{demo.heading}</h2>
        <div class="go rise" style="--d:2">
          <img class="qr" src="/deck-qr-app.svg" width="96" height="96" alt="QR code for app.mamoru.lol" />
          <a class="cta" href={demo.href} target="_blank" rel="noopener noreferrer">{demo.hrefLabel}</a>
        </div>
        <ol class="path rise" style="--d:3">
          {demo.path.map((s) => <li>{s}</li>)}
        </ol>
      </div>
    </section>

    <!-- 07 Outro -->
    <section class="slide outro" data-slide="7" aria-roledescription="slide" aria-label={outro.heading}>
      <div class="wide">
        <p class="eyebrow rise" style="--d:0">{outro.eyebrow}</p>
        <h2 class="rise" style="--d:1">{outro.heading}</h2>
        <ul class="futures">
          {outro.futures.map((f, i) => (
            <li class:list={["rise", { lead: f.lead }]} style={`--d:${i + 2}`}>
              <span class="who">{f.title}</span>
              <span class="what">{f.body}</span>
            </li>
          ))}
        </ul>
        <div class="outro-foot rise" style={`--d:${outro.futures.length + 2}`}>
          <button type="button" class="cta ghost js-restart">{outro.restart}</button>
          <span class="links">
            {outro.links.map((l) => <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a>)}
          </span>
        </div>
      </div>
    </section>

    <nav class="dots" aria-label="Slides">
      {Array.from({ length: total }, (_, i) => (
        <button type="button" class="dot" data-go={i + 1} aria-label={`Slide ${i + 1}`}></button>
      ))}
    </nav>
    <p class="count" aria-live="polite"><span class="js-now">01</span> / {String(total).padStart(2, "0")}</p>
  </main>

  <script>
    const deck = document.getElementById("deck")!;
    const slides = [...deck.querySelectorAll<HTMLElement>(".slide")];
    const dots = [...deck.querySelectorAll<HTMLButtonElement>(".dot")];
    const now = deck.querySelector<HTMLElement>(".js-now")!;
    let at = 0;
    let step = 0;

    const fromHash = () => {
      const n = Number(location.hash.slice(1));
      return Number.isInteger(n) && n >= 1 && n <= slides.length ? n - 1 : 0;
    };

    function show(i: number, s = 0) {
      at = Math.max(0, Math.min(slides.length - 1, i));
      step = s;
      slides.forEach((el, k) => {
        el.classList.toggle("on", k === at);
        el.classList.toggle("past", k < at);
        el.dataset.step = k === at ? String(step) : "0";
        el.inert = k !== at;
      });
      dots.forEach((d, k) => d.setAttribute("aria-current", k === at ? "step" : "false"));
      now.textContent = String(at + 1).padStart(2, "0");
      const hash = `#${at + 1}`;
      if (location.hash !== hash) history.replaceState(null, "", hash);
    }

    function next() {
      const steps = Number(slides[at]?.dataset.steps ?? 0);
      if (step < steps) show(at, step + 1);
      else if (at < slides.length - 1) show(at + 1);
    }
    function prev() {
      if (step > 0) show(at, step - 1);
      else if (at > 0) {
        const steps = Number(slides[at - 1]?.dataset.steps ?? 0);
        show(at - 1, steps);
      }
    }

    document.addEventListener("keydown", (e) => {
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      const k = e.key;
      if (k === "ArrowRight" || k === "PageDown" || k === " " || k === "Enter") {
        if (k === "Enter" && (e.target as HTMLElement).closest("a,button")) return;
        e.preventDefault();
        next();
      } else if (k === "ArrowLeft" || k === "PageUp" || k === "Backspace") {
        e.preventDefault();
        prev();
      } else if (k === "Home") show(0);
      else if (k === "End") show(slides.length - 1);
      else if (k === "f") {
        if (document.fullscreenElement) document.exitFullscreen();
        else document.documentElement.requestFullscreen?.();
      }
    });

    // Click the right two thirds to advance, the left third to go back.
    deck.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a,button")) return;
      if (e.clientX < window.innerWidth / 3) prev();
      else next();
    });

    let x0: number | null = null;
    deck.addEventListener("touchstart", (e) => { x0 = e.touches[0]?.clientX ?? null; }, { passive: true });
    deck.addEventListener("touchend", (e) => {
      const x1 = e.changedTouches[0]?.clientX;
      if (x0 === null || x1 === undefined) return;
      const dx = x1 - x0;
      x0 = null;
      if (Math.abs(dx) < 48) return;
      if (dx < 0) next();
      else prev();
    });

    dots.forEach((d) => d.addEventListener("click", () => show(Number(d.dataset.go) - 1)));
    deck.querySelector(".js-restart")?.addEventListener("click", () => show(0));
    window.addEventListener("hashchange", () => {
      if (fromHash() !== at) show(fromHash());
    });

    show(fromHash());
    requestAnimationFrame(() => deck.classList.add("ready"));
  </script>
</Base>

<style>
  :global(html),
  :global(body) {
    height: 100%;
    overflow: hidden;
  }
  /* Type grows with the screen, so a projector reads like a laptop. */
  :global(html) {
    font-size: clamp(16px, 1.12vw, 26px);
  }

  .deck {
    --ease: cubic-bezier(0.2, 0.8, 0.2, 1);
    --muted: color-mix(in srgb, var(--ink) 60%, var(--paper));
    position: relative;
    width: 100vw;
    height: 100dvh;
    overflow: hidden;
    user-select: none;
    cursor: default;
  }

  .lockup {
    position: absolute;
    top: clamp(1rem, 3vh, 2rem);
    left: clamp(1rem, 4vw, 3rem);
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 1.05rem;
    letter-spacing: 0.02em;
  }

  /* Slides stack in place and cross-fade. */
  .slide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(4.5rem, 10vh, 7rem) clamp(1.25rem, 7vw, 7rem);
    opacity: 0;
    visibility: hidden;
    transform: translateX(1.5rem);
    transition:
      opacity 0.9s var(--ease),
      transform 1.1s var(--ease),
      visibility 0s linear 0.9s;
  }
  .slide.past {
    transform: translateX(-1.5rem);
  }
  .slide.on {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 0.9s var(--ease) 0.15s,
      transform 1.1s var(--ease) 0.15s,
      visibility 0s;
  }

  /* Pieces rise in, one after another, when their slide arrives. */
  .rise {
    opacity: 0;
    transform: translateY(12px);
  }
  .on .rise {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.8s ease,
      transform 1s var(--ease);
    transition-delay: calc(0.35s + var(--d, 0) * 0.14s);
  }

  .center {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(0.9rem, 2.2vh, 1.4rem);
  }
  .wide {
    width: min(68rem, 100%);
  }
  .split {
    width: min(72rem, 100%);
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0 0 clamp(1rem, 2.5vh, 1.75rem);
    font-size: 0.75rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--emerald);
  }
  .eyebrow::after {
    content: "";
    width: 2rem;
    height: 1px;
    background: currentColor;
  }
  .center .eyebrow {
    margin: 0;
  }
  .center .eyebrow::after {
    display: none;
  }

  h1,
  h2 {
    margin: 0;
    font-weight: 400;
  }
  h2 {
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    line-height: 1.08;
    letter-spacing: 0.005em;
  }
  h2 span {
    display: block;
  }

  .lede {
    margin: 0;
    max-width: 34ch;
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    line-height: 1.45;
    color: var(--muted);
  }
  .kicker {
    margin: clamp(0.5rem, 2vh, 1.25rem) 0 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--stone);
  }

  .points {
    list-style: none;
    margin: clamp(1.5rem, 4vh, 2.5rem) 0 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }
  .points li {
    position: relative;
    padding-left: 1.6rem;
    font-size: clamp(1.05rem, 1.7vw, 1.3rem);
    line-height: 1.4;
    color: color-mix(in srgb, var(--ink) 80%, var(--paper));
  }
  .points li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 0.7rem;
    height: 1px;
    background: var(--emerald);
  }

  /* 01 Intro */
  .intro .rakes {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 9vh;
    width: 100%;
    height: 13vh;
    opacity: 0.9;
  }
  .rakes path {
    fill: none;
    stroke: var(--wash);
    stroke-width: 1.1;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .intro.on .rakes path {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1.8s cubic-bezier(0.6, 0, 0.2, 1);
    transition-delay: calc(0.4s + var(--i) * 0.1s);
  }
  .hero {
    display: flex;
    flex-direction: column;
    font-size: clamp(3rem, 10vw, 7rem);
    line-height: 0.98;
    letter-spacing: 0.04em;
  }

  /* 02 Problem: yields scattered around the page, none agreeing. */
  .scatter {
    position: relative;
    margin: 0;
    height: min(26rem, 52vh);
  }
  .chip {
    position: absolute;
    left: var(--x);
    top: var(--y);
    padding: 0.35rem 0.7rem;
    border: 1px solid color-mix(in srgb, var(--ink) 16%, transparent);
    background: color-mix(in srgb, var(--rice) 70%, transparent);
    font-family: var(--font-mono);
    font-size: clamp(0.72rem, 1.1vw, 0.85rem);
    letter-spacing: 0.04em;
    color: var(--muted);
    white-space: nowrap;
    opacity: 0;
  }
  .on .chip {
    opacity: 1;
    transition: opacity 1s ease;
    transition-delay: calc(0.6s + var(--i) * 0.18s);
    animation: drift 9s ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * -1.3s);
  }
  @keyframes drift {
    from { transform: translate(0, 0); }
    to { transform: translate(6px, -9px); }
  }

  .chip.ask {
    border-color: transparent;
    background: none;
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 2.4vw, 1.9rem);
    font-style: italic;
    letter-spacing: 0;
    color: var(--ink);
  }
  .chip.fade {
    text-decoration: line-through;
    text-decoration-color: color-mix(in srgb, var(--ink) 35%, transparent);
  }
  .on .chip.fade {
    animation: rot 6s ease-in 1.4s forwards;
  }
  @keyframes rot {
    to { opacity: 0.25; transform: translateY(14px); }
  }

  .versus {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: clamp(1.75rem, 4.5vh, 2.75rem) 0 0;
    padding-top: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--ink) 10%, transparent);
  }
  .versus dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--stone);
  }
  .versus dd {
    margin: 0.35rem 0 0;
    font-size: clamp(0.95rem, 1.3vw, 1.05rem);
    color: var(--muted);
  }
  .versus .ours dt {
    color: var(--emerald);
  }
  .versus .ours dd {
    color: var(--ink);
  }

  .problem h2 {
    font-size: clamp(2rem, 4.2vw, 3.3rem);
  }
  .problem h2 span + span,
  .solution h2 span:last-child {
    color: var(--emerald);
  }

  /* 03 Solution: the mark settles into raked rings. */
  .garden {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  .garden svg {
    width: 100%;
    max-width: 26rem;
    height: auto;
    overflow: visible;
  }
  .garden figcaption {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--stone);
  }
  .ring {
    fill: none;
    stroke: var(--wash);
    stroke-width: 1.2;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .on .ring {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1.8s cubic-bezier(0.6, 0, 0.2, 1);
    transition-delay: calc(0.9s + var(--r) * 0.16s);
  }
  .settle path {
    fill: var(--ink);
    opacity: 0;
    transform: translateY(-16px);
  }
  .settle .half {
    fill: var(--emerald);
  }
  .on .settle path {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.9s ease 0.5s,
      transform 1.3s var(--ease) 0.5s;
  }
  .on .settle .half {
    transition-delay: 1.1s;
  }
  .shadow {
    fill: var(--ink);
    opacity: 0;
    filter: blur(5px);
  }
  .on .shadow {
    opacity: 0.12;
    transition: opacity 1s ease 0.8s;
  }

  /* 04 Built: one line per layer. */
  .layers,
  .futures {
    list-style: none;
    margin: clamp(1.75rem, 5vh, 3rem) 0 0;
    padding: 0;
    display: grid;
    border-top: 1px solid color-mix(in srgb, var(--ink) 10%, transparent);
  }
  .layers li,
  .futures li {
    display: grid;
    grid-template-columns: minmax(10rem, 3fr) minmax(0, 7fr);
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: baseline;
    padding: clamp(0.8rem, 2vh, 1.15rem) 0;
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 10%, transparent);
  }
  .who {
    font-size: clamp(1.1rem, 1.8vw, 1.4rem);
  }
  .what {
    font-size: clamp(0.98rem, 1.5vw, 1.15rem);
    line-height: 1.45;
    color: var(--muted);
  }

  /* 05 One more thing: a quiet line first, then the reveal. */
  .more {
    flex-direction: column;
  }
  .teaser-line {
    position: absolute;
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.6rem);
    font-style: italic;
    letter-spacing: 0.01em;
    opacity: 0;
    transition: opacity 0.9s ease;
  }
  .more.on[data-step="0"] .teaser-line {
    opacity: 1;
    transition-delay: 0.5s;
  }
  .reveal {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(0.9rem, 2.2vh, 1.4rem);
    max-width: 52rem;
  }
  .reveal .eyebrow {
    margin: 0;
  }
  .reveal .eyebrow::after {
    display: none;
  }
  .more[data-step="0"] .reveal .rise {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.4s ease;
  }
  .verdicts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .verdict {
    display: inline-flex;
    gap: 0.6rem;
    align-items: baseline;
    padding: 0.5rem 0.9rem;
    border: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
    font-size: 0.95rem;
    color: var(--muted);
  }
  .verdict b {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    color: var(--ink);
  }
  .verdict.pay b {
    color: var(--emerald);
  }
  .verdict.refuse b {
    color: #8c3b2e;
  }
  .link {
    font-family: var(--font-mono);
