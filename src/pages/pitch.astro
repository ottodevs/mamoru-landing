---
import Base from "../layouts/Base.astro";
import { PITCH } from "../pitch-copy";

const { key, attacks, owner, leave, modules, close } = PITCH;
const total = 6;
const moduleKeys = ["uniswap", "curvegrid", "intercepta"] as const;
---
<Base title={PITCH.title} description={PITCH.description} canonical="https://mamoru.lol/pitch">
  <main class="deck" id="deck" aria-roledescription="carousel" aria-label={PITCH.title}>
    <header class="lockup">
      <img src="/mark-two-stones.png" width="26" height="26" alt="" />
      <span>Mamoru</span>
    </header>

    <!-- 01 Key -->
    <section class="slide key" data-slide="1" aria-roledescription="slide" aria-label={key.heading.join(" ")}>
      <div class="center">
        <h1 class="hero rise" style="--d:0">
          {key.heading.map((line) => <span>{line}</span>)}
        </h1>
        <p class="lede rise" style="--d:1">{key.lede}</p>
        <img class="qr rise" style="--d:2" src="/pitch-qr-lab.svg" width="96" height="96" alt="QR code for app.mamoru.lol/lab" />
        <a class="link rise" style="--d:3" href={key.href} target="_blank" rel="noopener noreferrer">{key.hrefLabel}</a>
      </div>
    </section>

    <!-- 02 Attacks -->
    <section class="slide attacks" data-slide="2" data-steps="4" aria-roledescription="slide" aria-label={attacks.heading}>
      <div class="wide">
        <p class="eyebrow rise" style="--d:0">{attacks.eyebrow}</p>
        <h2 class="rise" style="--d:1">{attacks.heading}</h2>
        <ol class="layers">
          {attacks.attempts.map((a, i) => (
            <li class="rise" style={`--d:${i + 2}`}>
              <span class="who">{a.ask}</span>
              <span class="verdict refuse"><b>{a.verdict}</b>{a.why}</span>
            </li>
          ))}
        </ol>
        <p class="lede rise" style={`--d:${attacks.attempts.length + 2}`}>{attacks.foot}</p>
      </div>
    </section>

    <!-- 03 Owner -->
    <section class="slide owner" data-slide="3" aria-roledescription="slide" aria-label={owner.heading.join(" ")}>
      <div class="split">
        <div class="copy">
          <p class="eyebrow rise" style="--d:0">{owner.eyebrow}</p>
          <h2 class="rise" style="--d:1">
            {owner.heading.map((line) => <span>{line}</span>)}
          </h2>
          <ul class="points">
            {owner.points.map((p, i) => <li class="rise" style={`--d:${i + 2}`}>{p}</li>)}
          </ul>
          <a class="link rise" style={`--d:${owner.points.length + 2}`} href={owner.href} target="_blank" rel="noopener noreferrer">{owner.hrefLabel}</a>
        </div>
      </div>
    </section>

    <!-- 04 Leave -->
    <section class="slide leave" data-slide="4" aria-roledescription="slide" aria-label={leave.heading.join(" ")}>
      <div class="wide">
        <p class="eyebrow rise" style="--d:0">{leave.eyebrow}</p>
        <h2 class="rise" style="--d:1">
          {leave.heading.map((line) => <span>{line}</span>)}
        </h2>
        <ul class="points">
          {leave.points.map((p, i) => <li class="rise" style={`--d:${i + 2}`}>{p}</li>)}
        </ul>
      </div>
    </section>

    <!-- 05 Partner module: all three render, one shown. Picked client-side from ?for=. -->
    <section class="slide modules" data-slide="5" aria-roledescription="slide" aria-label="Partner module">
      <div class="wide">
        {moduleKeys.map((k) => {
          const m = modules[k];
          return (
            <div class="module" data-module={k} hidden={k !== "uniswap"}>
              <p class="eyebrow rise" style="--d:0">{m.eyebrow}</p>
              <h2 class="rise" style="--d:1">{m.heading}</h2>
              <ul class="points">
                {m.points.map((p, i) => <li class="rise" style={`--d:${i + 2}`}>{p}</li>)}
              </ul>
            </div>
          );
        })}
      </div>
    </section>

    <!-- 06 Close -->
    <section class="slide close" data-slide="6" aria-roledescription="slide" aria-label={close.heading.join(" ")}>
      <div class="center">
        <p class="kicker rise" style="--d:0">{close.caption}</p>
        <h2 class="hero rise" style="--d:1">
          {close.heading.map((line) => <span>{line}</span>)}
        </h2>
        <p class="lede rise" style="--d:2">{close.lede}</p>
        <div class="go rise" style="--d:3">
          <img class="qr" src="/pitch-qr-lab.svg" width="96" height="96" alt="QR code for app.mamoru.lol/lab" />
          <a class="cta" href={close.href} target="_blank" rel="noopener noreferrer">{close.cta}</a>
        </div>
        <p class="kicker rise" style="--d:4">{close.next}</p>
        <div class="outro-foot rise" style="--d:5">
          <span class="links">
            {close.links.map((l) => <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a>)}
          </span>
        </div>
      </div>
    </section>

    <nav class="dots" aria-label="Slides">
      {Array.from({ length: total }, (_, i) => (
        <button type="button" class="dot" data-go={i + 1} aria-label={`Slide ${i + 1}`}></button>
      ))}
    </nav>
    <p class="count" aria-live="polite"><span class="js-now">01</span> / {String(total).padStart(2, "0")}</p>
  </main>

  <script>
    const deck = document.getElementById("deck")!;
    const slides = [...deck.querySelectorAll<HTMLElement>(".slide")];
    const dots = [...deck.querySelectorAll<HTMLButtonElement>(".dot")];
    const now = deck.querySelector<HTMLElement>(".js-now")!;
    let at = 0;
    let step = 0;

    const fromHash = () => {
      const n = Number(location.hash.slice(1));
      return Number.isInteger(n) && n >= 1 && n <= slides.length ? n - 1 : 0;
    };

    function show(i: number, s = 0) {
      at = Math.max(0, Math.min(slides.length - 1, i));
      step = s;
      slides.forEach((el, k) => {
        el.classList.toggle("on", k === at);
        el.classList.toggle("past", k < at);
        el.dataset.step = k === at ? String(step) : "0";
        el.inert = k !== at;
      });
      dots.forEach((d, k) => d.setAttribute("aria-current", k === at ? "step" : "false"));
      now.textContent = String(at + 1).padStart(2, "0");
      const hash = `#${at + 1}`;
      if (location.hash !== hash) history.replaceState(null, "", hash);
    }

    function next() {
      const steps = Number(slides[at]?.dataset.steps ?? 0);
      if (step < steps) show(at, step + 1);
      else if (at < slides.length - 1) show(at + 1);
    }
    function prev() {
      if (step > 0) show(at, step - 1);
      else if (at > 0) {
        const steps = Number(slides[at - 1]?.dataset.steps ?? 0);
        show(at - 1, steps);
      }
    }

    document.addEventListener("keydown", (e) => {
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      const k = e.key;
      if (k === "ArrowRight" || k === "PageDown" || k === " " || k === "Enter") {
        // A focused link or button keeps its own Enter and Space.
        if ((k === "Enter" || k === " ") && (e.target as HTMLElement).closest("a,button")) return;
        e.preventDefault();
        next();
      } else if (k === "ArrowLeft" || k === "PageUp" || k === "Backspace") {
        e.preventDefault();
        prev();
      } else if (k === "Home") show(0);
      else if (k === "End") show(slides.length - 1);
      else if (k === "f") {
        if (document.fullscreenElement) document.exitFullscreen();
        else document.documentElement.requestFullscreen?.();
      }
    });

    // Click the right two thirds to advance, the left third to go back.
    deck.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a,button")) return;
      if (e.clientX < window.innerWidth / 3) prev();
      else next();
    });

    let x0: number | null = null;
    deck.addEventListener("touchstart", (e) => { x0 = e.touches[0]?.clientX ?? null; }, { passive: true });
    deck.addEventListener("touchend", (e) => {
      const x1 = e.changedTouches[0]?.clientX;
      if (x0 === null || x1 === undefined) return;
      const dx = x1 - x0;
      x0 = null;
      if (Math.abs(dx) < 48) return;
      if (dx < 0) next();
      else prev();
    });

    dots.forEach((d) => d.addEventListener("click", () => show(Number(d.dataset.go) - 1)));
    window.addEventListener("hashchange", () => {
      if (fromHash() !== at) show(fromHash());
    });

    // Partner module: picked once from ?for=, unknown or missing values fall back to uniswap.
    const KNOWN_MODULES = new Set(["uniswap", "curvegrid", "intercepta"]);
    const modules = [...deck.querySelectorAll<HTMLElement>(".module")];
    if (modules.length) {
      const requested = new URLSearchParams(location.search).get("for");
      const pick = requested && KNOWN_MODULES.has(requested) ? requested : "uniswap";
      modules.forEach((m) => { m.hidden = m.dataset.module !== pick; });
    }

    show(fromHash());
    requestAnimationFrame(() => deck.classList.add("ready"));
  </script>
</Base>

<style>
  :global(html),
  :global(body) {
    height: 100%;
    overflow: hidden;
  }
  /* Type grows with the screen, so a projector reads like a laptop. */
  :global(html) {
    font-size: clamp(16px, 1.12vw, 26px);
  }

  .deck {
    --ease: cubic-bezier(0.2, 0.8, 0.2, 1);
    --muted: color-mix(in srgb, var(--ink) 60%, var(--paper));
    position: relative;
    width: 100vw;
    height: 100dvh;
    overflow: hidden;
    user-select: none;
    cursor: default;
  }

  .lockup {
    position: absolute;
    top: clamp(1rem, 3vh, 2rem);
    left: clamp(1rem, 4vw, 3rem);
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 1.05rem;
    letter-spacing: 0.02em;
  }

  /* Slides stack in place and cross-fade. */
  .slide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(4.5rem, 10vh, 7rem) clamp(1.25rem, 7vw, 7rem);
    opacity: 0;
    visibility: hidden;
    transform: translateX(1.5rem);
    transition:
      opacity 0.9s var(--ease),
      transform 1.1s var(--ease),
      visibility 0s linear 0.9s;
  }
  .slide.past {
    transform: translateX(-1.5rem);
  }
  .slide.on {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 0.9s var(--ease) 0.15s,
      transform 1.1s var(--ease) 0.15s,
      visibility 0s;
  }

  /* Pieces rise in, one after another, when their slide arrives. */
  .rise {
    opacity: 0;
    transform: translateY(12px);
  }
  .on .rise {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.8s ease,
      transform 1s var(--ease);
    transition-delay: calc(0.35s + var(--d, 0) * 0.14s);
  }

  .center {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(0.9rem, 2.2vh, 1.4rem);
  }
  .wide {
    width: min(68rem, 100%);
  }
  .split {
    width: min(72rem, 100%);
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0 0 clamp(1rem, 2.5vh, 1.75rem);
    font-size: 0.75rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--emerald);
  }
  .eyebrow::after {
    content: "";
    width: 2rem;
    height: 1px;
    background: currentColor;
  }

  h1,
  h2 {
    margin: 0;
    font-weight: 400;
  }
  h2 {
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    line-height: 1.08;
    letter-spacing: 0.005em;
  }
  h2 span {
    display: block;
  }

  .lede {
    margin: 0;
    max-width: 34ch;
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    line-height: 1.45;
    color: var(--muted);
  }
  .kicker {
    margin: clamp(0.5rem, 2vh, 1.25rem) 0 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--stone);
  }

  .points {
    list-style: none;
    margin: clamp(1.5rem, 4vh, 2.5rem) 0 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }
  .points li {
    position: relative;
    padding-left: 1.6rem;
    font-size: clamp(1.05rem, 1.7vw, 1.3rem);
    line-height: 1.4;
    color: color-mix(in srgb, var(--ink) 80%, var(--paper));
  }
  .points li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 0.7rem;
    height: 1px;
    background: var(--emerald);
  }

  /* 01 Key */
  .hero {
    display: flex;
    flex-direction: column;
    font-size: clamp(3rem, 10vw, 7rem);
    line-height: 0.98;
    letter-spacing: 0.04em;
  }
  .close .hero {
    font-size: clamp(2.4rem, 7vw, 5rem);
  }

  /* 02 Attacks: one row per attempt, a stamped verdict that steps in. */
  .layers {
    list-style: none;
    margin: clamp(1.75rem, 5vh, 3rem) 0 0;
    padding: 0;
    display: grid;
    border-top: 1px solid color-mix(in srgb, var(--ink) 10%, transparent);
  }
  .layers li {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(10rem, 5fr);
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: baseline;
    padding: clamp(0.8rem, 2vh, 1.15rem) 0;
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 10%, transparent);
  }
  .who {
    font-size: clamp(1.2rem, 2.2vw, 1.75rem);
    line-height: 1.25;
  }
  .attacks .lede {
    margin: clamp(1.5rem, 4vh, 2.25rem) 0 0;
  }
  .key .lede {
    max-width: 44ch;
  }

  /* The refusal is the picture of this slide: it has to read from the back of a room. */
  .verdict {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.95rem;
    color: var(--muted);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s ease, visibility 0s linear 0.4s;
  }
  .verdict b {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: clamp(1.15rem, 2.4vw, 1.9rem);
    line-height: 1.1;
    letter-spacing: 0.16em;
    color: var(--ink);
  }
  .verdict.refuse b {
    color: #8c3b2e;
  }
  .attacks[data-step="1"] .layers li:nth-child(-n+1) .verdict,
  .attacks[data-step="2"] .layers li:nth-child(-n+2) .verdict,
  .attacks[data-step="3"] .layers li:nth-child(-n+3) .verdict,
  .attacks[data-step="4"] .layers li:nth-child(-n+4) .verdict {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  .link {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    color: var(--stone);
    text-underline-offset: 0.3em;
  }
  .link:hover {
    color: var(--emerald);
  }

  /* 01 Key, 06 Close */
  .go {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .qr {
    width: 6rem;
    height: 6rem;
    image-rendering: pixelated;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.75rem 1.6rem;
    border: 1px solid var(--ink);
    border-radius: 0;
    background: var(--ink);
    color: var(--paper);
    font: inherit;
    font-size: 1rem;
    letter-spacing: 0.04em;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.3s ease, color 0.3s ease, border-color 0.3s ease;
  }
  .cta:hover {
    background: var(--emerald);
    border-color: var(--emerald);
  }
  .cta:focus-visible,
  .dot:focus-visible {
    outline: 2px solid var(--emerald);
    outline-offset: 3px;
  }

  /* 06 Close */
  .outro-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: clamp(1.75rem, 5vh, 3rem);
  }
  .outro-foot .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
  }
  .outro-foot .links a {
    color: var(--stone);
    text-underline-offset: 0.3em;
  }
  .outro-foot .links a:hover {
    color: var(--emerald);
  }

  /* Chrome: small stones for position, a counter in the corner. */
  .dots {
    position: absolute;
    left: 50%;
    bottom: clamp(1rem, 3vh, 1.75rem);
    z-index: 2;
    display: flex;
    gap: 0.35rem;
    transform: translateX(-50%);
  }
  .dot {
    width: 1.4rem;
    height: 1.4rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    display: grid;
    place-items: center;
  }
  .dot::before {
    content: "";
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--wash);
    transition: background 0.5s ease, transform 0.5s var(--ease);
  }
  .dot[aria-current="step"]::before {
    background: var(--ink);
    transform: scale(1.35);
  }
  .count {
    position: absolute;
    right: clamp(1rem, 4vw, 3rem);
    bottom: clamp(1.1rem, 3vh, 1.9rem);
    z-index: 2;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    color: var(--stone);
  }

  .deck:not(.ready) .slide {
    transition: none;
  }

  @media (max-width: 760px) {
    .split {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .layers li {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
    .slide {
      align-items: flex-start;
      overflow-y: auto;
      padding-bottom: 5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .slide,
    .slide.on,
    .rise,
    .on .rise,
    .verdict {
      transition: none !important;
      animation: none !important;
    }
  }
</style>
