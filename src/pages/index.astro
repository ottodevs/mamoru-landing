---
import Base from "../layouts/Base.astro";
import Countdown from "../components/Countdown.astro";
import EmailBar from "../components/EmailBar.astro";
---
<Base title="Mamoru.lol" description="APY. Delivered.">
  <main class="page">
    <div class="stack">
      <header class="lockup">
        <img
          class="mark"
          src="/mark-two-stones.png"
          width="46"
          height="46"
          alt="The Split"
        />
        <p class="wordmark">Mamoru</p>
      </header>
      <h1 class="hero">
        <span>APY.</span>
        <span>DELIVERED.</span>
      </h1>
      <p class="teaser">The principal keeps working. The yield gets set aside.</p>
      <Countdown />
      <EmailBar />
      <a
        class="x-link"
        href="https://x.com/entermamoru"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg class="x-mark" viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="currentColor"
            d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.725-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"
          />
        </svg>
        <span>@entermamoru</span>
      </a>
    </div>
  </main>
</Base>

<style>
  .page {
    min-height: 100dvh;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: clamp(1.25rem, 4.2vh, 3rem) clamp(1rem, 5vw, 4.5rem)
      clamp(1.25rem, 3.5vh, 2.5rem);
  }

  .stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
    max-width: min(42rem, 100%);
    min-width: 0;
    margin-inline: auto;
  }

  .lockup {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    width: 100%;
    max-width: 100%;
  }

  /* Mark sits at roughly two wordmark cap-heights; wordmark size is untouched. */
  .mark {
    width: clamp(2.25rem, 3.4vw, 2.9rem);
    height: auto;
    display: block;
  }

  .wordmark {
    margin: 0;
    font-size: clamp(1.15rem, 2vw, 1.55rem);
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1;
  }

  .hero {
    margin: clamp(1.1rem, 4.2vh, 2.5rem) 0 0;
    font-size: clamp(2.2rem, min(9vh, 11vw), 6.2rem);
    font-weight: 400;
    letter-spacing: 0.04em;
    line-height: 0.95;
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .hero span {
    display: block;
    max-width: 100%;
  }

  .teaser {
    margin: clamp(1.5rem, 7vh, 4.25rem) 0 0;
    font-size: clamp(1.05rem, 2.1vw, 1.35rem);
    line-height: 1.3;
    letter-spacing: 0.01em;
    max-width: min(22rem, 100%);
    overflow-wrap: break-word;
  }

  .stack :global(.countdown) {
    margin-top: clamp(1.15rem, 5.2vh, 3rem);
    max-width: min(26rem, 100%);
    width: 100%;
    gap: 0.7rem;
  }

  .stack :global(.countdown .cell) {
    padding: 0.65rem 0.55rem 0.55rem;
    min-width: 0;
  }

  .stack :global(.countdown .num) {
    font-size: clamp(1.15rem, 3.2vh, 1.65rem);
  }

  .stack :global(.email-bar) {
    margin-top: clamp(1.35rem, 6.4vh, 3.75rem);
    max-width: 100%;
  }

  .x-link {
    margin-top: clamp(1.1rem, 4vh, 1.75rem);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--stone);
    text-decoration: none;
    font-size: 0.95rem;
    letter-spacing: 0.01em;
    line-height: 1;
  }
  .x-link:hover,
  .x-link:focus-visible {
    color: var(--ink);
  }
  .x-link:focus-visible {
    outline: 1px solid var(--ink);
    outline-offset: 4px;
  }
  .x-mark {
    width: 0.85rem;
    height: 0.85rem;
    display: block;
  }

  @media (max-width: 52rem) {
    .mark {
      width: 2.4rem;
    }
    .hero {
      font-size: clamp(2rem, min(8vh, 12vw), 3.6rem);
    }
  }
</style>
