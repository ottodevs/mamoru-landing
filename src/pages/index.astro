---
import Base from "../layouts/Base.astro";
---
<Base title="Mamoru.lol" description="APY. Delivered. Opens after ETHGlobal Tokyo.">
  <main class="page">
    <div class="stack">
      <header class="lockup">
        <img
          class="mark"
          src="/mark-two-stones.png"
          width="160"
          height="160"
          alt="The Split"
        />
        <p class="wordmark">Mamoru</p>
      </header>
      <h1 class="hero">
        <span>APY.</span>
        <span>DELIVERED.</span>
      </h1>
      <p class="teaser">The principal keeps working. The yield gets set aside.</p>
    </div>
  </main>
</Base>

<style>
  .page {
    height: 100dvh;
    overflow: hidden;
    padding: clamp(1.25rem, 5.33vh, 3.5rem) clamp(1.5rem, 4.44vw, 4rem)
      clamp(1.25rem, 3.5vh, 2.5rem);
  }

  .stack {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    height: 100%;
  }

  .lockup {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    width: clamp(3.75rem, 10.67vh, 6.5rem);
  }

  .mark {
    width: 100%;
    height: auto;
    display: block;
  }

  .wordmark {
    margin: 0;
    font-size: clamp(0.95rem, 2.45vh, 1.4rem);
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1;
  }

  .hero {
    margin: clamp(1rem, 4.8vh, 3rem) 0 0;
    font-size: clamp(2.4rem, min(10.2vh, 14vw), 6.5rem);
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1.087;
  }

  .hero span {
    display: block;
  }

  .teaser {
    margin: clamp(1.25rem, 6.3vh, 3.75rem) 0 0;
    font-size: clamp(1.05rem, 3.1vh, 1.9rem);
    line-height: 1.3;
  }
</style>
