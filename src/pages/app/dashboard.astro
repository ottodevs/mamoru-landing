---
import Base from "../../layouts/Base.astro";
import TokenMark from "../../components/TokenMark.astro";

type Token = "ETH" | "WETH" | "USDC" | "WBTC";

const workingEth = "4.20";
const idleEth = "0.80";
const walletEth = "2.40";
const workingUsdc = "16,800";
const claimableUsdc = "420";
const totalUsdc = "17,220";
const harvestedUsdc = "3,180";

const inUse: Token[] = ["ETH", "WETH", "WBTC", "USDC"];

const pools: {
  protocol: string;
  pair: string;
  a: Token;
  b?: Token;
  address: string;
  chain: string;
  sleeve: string;
  amount: string;
}[] = [
  {
    protocol: "Uniswap v3",
    pair: "WETH / USDC",
    a: "WETH",
    b: "USDC",
    address: "0x8ad599c3A0ff1De082011EFDDc58f1908eb6e6D8",
    chain: "Ethereum",
    sleeve: "35% · paired",
    amount: "1.47 ETH",
  },
  {
    protocol: "Uniswap v3",
    pair: "WBTC / USDC",
    a: "WBTC",
    b: "USDC",
    address: "0x99ac8cA7087fA4A2A1FB6357269965A2014ABc35",
    chain: "Ethereum",
    sleeve: "paired",
    amount: "0.29 ETH",
  },
  {
    protocol: "Aave v3",
    pair: "USDC",
    a: "USDC",
    address: "0x98C23E9d8f34FEFb1B7BD6a91B7FF122F4e16F5c",
    chain: "Ethereum",
    sleeve: "50% · stables",
    amount: "2.10 ETH",
  },
  {
    protocol: "Morpho",
    pair: "ETH",
    a: "ETH",
    address: "0x388C818CA8B9251b393131C08a736A67ccB19297",
    chain: "Ethereum",
    sleeve: "15% · mercenary",
    amount: "0.34 ETH",
  },
];

const months = [
  { label: "Apr", value: 420 },
  { label: "May", value: 680 },
  { label: "Jun", value: 910 },
  { label: "Jul", value: 1_480 },
  { label: "Aug", value: 2_370 },
  { label: "Sep", value: 3_180 },
];
const maxY = 3200;
const chartW = 320;
const chartH = 132;
const left = 12;
const right = 12;
const top = 10;
const bottom = 28;
const innerW = chartW - left - right;
const innerH = chartH - top - bottom;
const chartPoints = months.map((m, i) => {
  const x = left + (i * innerW) / (months.length - 1);
  const y = top + innerH - (m.value / maxY) * innerH;
  return { x, y, label: m.label };
});
const line = chartPoints.map((p) => `${p.x},${p.y}`).join(" ");
const area = `${left},${top + innerH} ${line} ${left + innerW},${top + innerH}`;

const harvests = [
  { when: "26 Sep 2026", amount: "420 USDC", tx: "0x7c2a91e0b19d44c803f1a6b09e14c2" },
  { when: "19 Sep 2026", amount: "380 USDC", tx: "0xb19d03aa7c2a91e044c8de80a6b0" },
  { when: "12 Sep 2026", amount: "410 USDC", tx: "0x03f191abde8021aac02f7c2a91e0" },
  { when: "5 Sep 2026", amount: "390 USDC", tx: "0xde80b19d44c8a6b07c2a91e0c02f" },
  { when: "29 Aug 2026", amount: "1,580 USDC", tx: "0x91abc02f7c2a91e0b19d44c803f1" },
];

const shortAddr = (a: string) => `${a.slice(0, 6)}…${a.slice(-4)}`;
const shortTx = (a: string) => `${a.slice(0, 6)}…${a.slice(-4)}`;
---
<Base title="Mamoru — Dashboard" description="Working capital, idle ETH, and harvested USDC.">
  <main class="page">
    <header class="mast">
      <a class="brand" href="/">
        <img src="/mark-two-stones.png" width="36" height="36" alt="" />
        <span>Mamoru</span>
      </a>
    </header>

    <section class="balance" aria-labelledby="total-title">
      <p class="kicker heavy" id="total-title">Total balance</p>
      <p class="sum">{totalUsdc} <span class="unit">USDC</span></p>
      <ul class="legs">
        <li>
          <span class="leg-label">Working capital</span>
          <strong>{workingUsdc} USDC</strong>
        </li>
        <li>
          <span class="leg-label">Claimable rewards</span>
          <strong>{claimableUsdc} USDC</strong>
        </li>
      </ul>
      <button type="button" class="claim" id="xfer-open" aria-haspopup="dialog" aria-controls="xfer">
        Transfer Assets
      </button>
    </section>

    <dialog class="xfer" id="xfer" aria-labelledby="xfer-title">
      <div class="xfer-sheet">
        <header class="xfer-head">
          <p class="title heavy" id="xfer-title">Transfer assets</p>
          <button type="button" class="xfer-close" id="xfer-close">Close</button>
        </header>
        <ul class="xfer-opts">
          <li>
            <p class="xfer-name">Transfer USDC</p>
            <p class="xfer-meta">Max {claimableUsdc} USDC from claimable rewards</p>
            <div class="xfer-row">
              <label>
                <span class="sr">USDC amount</span>
                <input id="xfer-usdc" type="text" inputmode="decimal" placeholder="0.00" autocomplete="off" data-max="420" data-unit="USDC" />
              </label>
              <button type="button" class="xfer-max" data-for="xfer-usdc">Max</button>
              <button type="button" class="cta xfer-go">Transfer</button>
            </div>
          </li>
          <li>
            <p class="xfer-name">Transfer pending ETH</p>
            <p class="xfer-meta">ETH pending to allocate by Mamoru · {idleEth} ETH</p>
            <div class="xfer-row">
              <label>
                <span class="sr">Pending ETH amount</span>
                <input id="xfer-idle" type="text" inputmode="decimal" placeholder="0.00" autocomplete="off" data-max="0.80" data-unit="ETH" />
              </label>
              <button type="button" class="xfer-max" data-for="xfer-idle">Max</button>
              <button type="button" class="cta xfer-go">Transfer</button>
            </div>
          </li>
          <li>
            <p class="xfer-name">Transfer working capital</p>
            <p class="xfer-meta">{workingEth} ETH · {workingUsdc} USDC</p>
            <p class="xfer-warn" role="status">
              The amount shown may not match the final figure you receive. Some operations are still pending.
            </p>
            <div class="xfer-row">
              <label>
                <span class="sr">Working capital amount</span>
                <input id="xfer-work" type="text" inputmode="decimal" placeholder="0.00" autocomplete="off" data-max="4.20" data-unit="ETH" />
              </label>
              <button type="button" class="xfer-max" data-for="xfer-work">Max</button>
              <button type="button" class="cta xfer-go">Transfer</button>
            </div>
          </li>
        </ul>
      </div>
    </dialog>

    <section class="row" aria-label="Fund and idle">
      <form class="card fund" action="#" method="post" onsubmit="return false;" aria-labelledby="fund-title">
        <p class="title heavy" id="fund-title">Fund Mamoru</p>
        <div class="fund-row">
          <span class="asset">ETH</span>
          <label class="amount">
            <span class="sr">Amount</span>
            <input id="fund-amount" type="text" name="amount" inputmode="decimal" placeholder="0.00" autocomplete="off" />
          </label>
          <button type="submit" class="cta">Fund</button>
        </div>
        <div class="fund-meta">
          <p class="avail">{walletEth} ETH available</p>
          <div class="pcts" role="group" aria-label="Fill amount">
            <button type="button" data-pct="100">100%</button>
            <button type="button" data-pct="50">50%</button>
            <button type="button" data-pct="25">25%</button>
          </div>
        </div>
      </form>
      <aside class="card idle">
        <p class="title">ETH pending to allocate by Mamoru</p>
        <p class="sum-sm idle-amt">
          <span class="think" aria-hidden="true"></span>
          {idleEth} ETH
        </p>
      </aside>
    </section>

    <details class="card fold wide">
      <summary>
        <span>
          <span class="title heavy">Working capital</span>
          <span class="sum-sm work-eth">{workingEth} ETH</span>
        </span>
      </summary>
      <div class="fold-body">
        <p class="kicker">Assets in use</p>
        <ul class="strip">
          {inUse.map((sym) => (
            <li>
              <TokenMark symbol={sym} size={28} />
              <span>{sym}</span>
            </li>
          ))}
        </ul>
        <p class="kicker">Where it sits</p>
        <ul class="pools">
          {pools.map((p) => (
            <li>
              <span class="pair">
                <TokenMark symbol={p.a} size={28} />
                {p.b ? <span class="overlap"><TokenMark symbol={p.b} size={28} /></span> : null}
              </span>
              <span class="pool-meta">
                <span class="pool-pair">{p.protocol} · {p.pair}</span>
                <span class="pool-addr">{p.chain} · {shortAddr(p.address)}</span>
                <span class="pool-note">{p.sleeve}</span>
              </span>
              <span class="pool-amt work-eth">{p.amount}</span>
            </li>
          ))}
        </ul>
        <button type="button" class="stop">Stop allocation</button>
      </div>
    </details>

    <details class="card fold wide">
      <summary>
        <span>
          <span class="title">Total harvested</span>
          <span class="sum-sm">{harvestedUsdc} USDC</span>
        </span>
      </summary>
      <div class="harvest">
        <ul class="ledger">
          {harvests.map((h) => (
            <li>
              <time>{h.when}</time>
              <span>{h.amount}</span>
              <code>{shortTx(h.tx)}</code>
            </li>
          ))}
        </ul>
        <svg class="chart" viewBox={`0 0 ${chartW} ${chartH}`} role="img" aria-label="USDC harvested by month">
          <polyline class="chart-area" points={area} />
          <polyline class="chart-line" points={line} />
          {chartPoints.map((p) => (
            <g>
              <circle class="chart-dot" cx={p.x} cy={p.y} r="2.4" />
              <text class="axis month" x={p.x} y={chartH - 8}>{p.label}</text>
            </g>
          ))}
        </svg>
      </div>
    </details>

  </main>
</Base>

<style>
  :global(html), :global(body) {
    min-height: 100%;
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .page {
    --s1: 0.35rem;
    --s2: 0.7rem;
    --s3: 1.15rem;
    --s4: 1.75rem;
    width: min(68rem, calc(100% - 3rem));
    min-height: 100dvh;
    margin: 0 auto;
    padding: var(--s3) 0 var(--s4);
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .mast { flex: 0 0 auto; margin-bottom: var(--s4); }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    font-size: 1.35rem;
    letter-spacing: 0.02em;
  }
  .kicker {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--stone);
  }
  .title {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 400;
    letter-spacing: 0.01em;
  }
  .heavy { font-weight: 700; }
  .balance { flex: 0 0 auto; margin-bottom: var(--s4); }
  .balance > .kicker.heavy {
    font-size: 0.86rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--ink);
  }
  .sum {
    margin: var(--s1) 0 0;
    font-size: clamp(3.4rem, 9vw, 5.4rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--emerald);
  }
  .unit {
    margin-left: 0.2em;
    font-size: 0.32em;
    letter-spacing: 0.12em;
    color: var(--stone);
    font-weight: 400;
  }
  .sum-sm {
    margin: 0.08rem 0 0;
    display: block;
    font-size: 1.2rem;
    line-height: 1.15;
  }
  .legs {
    list-style: none;
    margin: var(--s3) 0 0;
    padding: 0;
    display: flex;
    gap: 2.5rem;
  }
  .legs li { display: flex; flex-direction: column; gap: 0.1rem; align-items: flex-start; }
  .leg-label { color: var(--stone); font-size: 0.88rem; }
  .legs strong { font-weight: 400; font-size: 1.15rem; }
  .claim {
    margin-top: var(--s2);
    padding: 0;
    border: 0;
    background: none;
    color: var(--emerald);
    font: inherit;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    cursor: pointer;
  }
  .claim:hover { text-decoration: underline; }

  .xfer {
    width: min(36rem, calc(100% - 2rem));
    max-height: calc(100dvh - 2rem);
    margin: auto;
    overflow: auto;
    padding: 0;
    border: 1px solid var(--wash);
    background: var(--paper);
    color: var(--ink);
  }
  .xfer::backdrop {
    background: color-mix(in srgb, var(--ink) 38%, transparent);
  }
  .xfer-sheet { padding: 1.25rem 1.35rem 1.4rem; }
  .xfer-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .xfer-close {
    padding: 0;
    border: 0;
    background: none;
    color: var(--stone);
    font: inherit;
    font-size: 0.88rem;
    cursor: pointer;
  }
  .xfer-close:hover { color: var(--ink); }
  .xfer-opts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }
  .xfer-opts li {
    border-top: 1px solid var(--wash);
    padding-top: 0.85rem;
    display: grid;
    gap: 0.35rem;
  }
  .xfer-name {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
  }
  .xfer-meta {
    margin: 0;
    color: var(--stone);
    font-size: 0.88rem;
  }
  .xfer-warn {
    margin: 0.15rem 0 0;
    padding: 0.55rem 0.7rem;
    border: 1px solid color-mix(in srgb, #9b2c2c 55%, var(--wash));
    background: color-mix(in srgb, #9b2c2c 8%, var(--paper));
    color: #6b1f1f;
    font-size: 0.88rem;
    line-height: 1.4;
  }
  .xfer-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: 0.4rem;
    align-items: stretch;
    margin-top: 0.25rem;
  }
  .xfer-row label { display: block; min-width: 0; }
  .xfer-row input {
    width: 100%;
    border: 1px solid var(--wash);
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 1.05rem;
    padding: 0.5rem 0.7rem;
  }
  .xfer-max {
    border: 1px solid var(--wash);
    background: transparent;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.2rem 0.55rem;
    cursor: pointer;
  }

  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.75rem;
    align-items: stretch;
    flex: 0 0 auto;
    margin-bottom: var(--s2);
  }
  .card {
    border-top: 1px solid var(--wash);
    background: transparent;
    padding: var(--s2) 0;
  }
  .wide { width: 100%; flex: 0 0 auto; }
  .fund, .idle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--s1);
    min-height: 5.5rem;
  }
  .fund-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.5rem;
    align-items: stretch;
  }
  .asset {
    display: flex;
    align-items: center;
    border: 1px solid var(--ink);
    background: var(--paper);
    padding: 0.55rem 0.85rem;
    font-family: var(--font-mono);
    letter-spacing: 0.1em;
  }
  .amount input {
    width: 100%;
    height: 100%;
    border: 1px solid var(--wash);
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 1.1rem;
    padding: 0.55rem 0.75rem;
  }
  .cta, .stop {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .cta {
    background: var(--ink);
    color: var(--rice);
    border: 0;
    padding: 0.6rem 1.15rem;
  }
  .fund-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem 0.8rem;
    margin-top: 0.15rem;
  }
  .avail {
    margin: 0;
    color: var(--stone);
    font-size: 0.85rem;
  }
  .pcts { display: flex; gap: 0.35rem; }
  .pcts button {
    border: 1px solid var(--wash);
    background: transparent;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.45rem;
    cursor: pointer;
  }
  .work-eth { color: var(--emerald); }
  .idle-amt {
    color: var(--ink);
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .think {
    width: 0.7rem;
    height: 0.7rem;
    border: 1.5px solid var(--stone);
    border-top-color: var(--ink);
    border-radius: 999px;
    animation: think 0.9s linear infinite;
  }
  @keyframes think {
    to { transform: rotate(360deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .think { animation: none; border-top-color: var(--stone); }
  }

  .fold { padding: var(--s2) 0; }
  .fold summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0;
  }
  .fold summary::-webkit-details-marker { display: none; }
  .fold summary::after { content: "▾"; color: var(--stone); }
  .fold[open] summary::after { content: "▴"; }
  .fold-body, .harvest { padding: var(--s2) 0 0; }
  .fold-body { display: grid; gap: var(--s2); }

  .strip {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
  }
  .strip li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
  }

  .pools { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.4rem; }
  .pools li {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.7rem;
    align-items: center;
    border-top: 1px solid var(--wash);
    padding-top: 0.45rem;
  }
  .pair { display: flex; align-items: center; }
  .overlap { margin-left: -0.45rem; }
  .pool-meta { display: flex; flex-direction: column; gap: 0.05rem; min-width: 0; }
  .pool-pair { font-size: 1rem; }
  .pool-addr, .pool-note {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--stone);
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pool-amt { font-family: var(--font-mono); font-size: 0.85rem; }
  .pool-amt.work-eth,
  .sum-sm.work-eth {
    color: var(--emerald);
    font-weight: 500;
  }
  .stop {
    justify-self: start;
    background: transparent;
    color: #9b2c2c;
    border: 1px solid #9b2c2c;
    padding: 0.6rem 0.95rem;
  }

  .harvest {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }
  .chart { width: 100%; height: auto; }
  .axis.month {
    fill: var(--stone);
    font-size: 9px;
    font-family: var(--font-mono);
    text-anchor: middle;
  }
  .chart-area {
    fill: color-mix(in srgb, var(--emerald) 18%, transparent);
    stroke: none;
  }
  .chart-line {
    fill: none;
    stroke: var(--emerald);
    stroke-width: 1.6;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .chart-dot { fill: var(--emerald); }

  .ledger {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.3rem;
  }
  .ledger li {
    display: grid;
    grid-template-columns: 7.5rem auto 1fr;
    gap: 0.6rem;
    border-top: 1px solid var(--wash);
    padding-top: 0.35rem;
    align-items: baseline;
  }
  .ledger code {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--emerald);
    justify-self: end;
  }

  @media (max-width: 760px) {
    .row, .harvest { grid-template-columns: 1fr; }
    .pools li, .ledger li { grid-template-columns: 1fr; gap: 0.25rem; }
    .ledger code { justify-self: start; }
    .xfer-row { grid-template-columns: 1fr 1fr; }
    .xfer-row label { grid-column: 1 / -1; }
  }
</style>

<script>
  const input = document.querySelector<HTMLInputElement>("#fund-amount");
  const available = 2.4;
  document.querySelectorAll<HTMLButtonElement>("[data-pct]").forEach((btn) => {
    btn.addEventListener("click", () => {
      if (!input) return;
      const pct = Number(btn.dataset.pct) / 100;
      input.value = (available * pct).toFixed(2);
    });
  });

  const dialog = document.querySelector<HTMLDialogElement>("#xfer");
  const openBtn = document.querySelector<HTMLButtonElement>("#xfer-open");
  const closeBtn = document.querySelector<HTMLButtonElement>("#xfer-close");
  openBtn?.addEventListener("click", () => dialog?.showModal());
  closeBtn?.addEventListener("click", () => dialog?.close());
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });

  document.querySelectorAll<HTMLButtonElement>(".xfer-max").forEach((btn) => {
    btn.addEventListener("click", () => {
      const id = btn.dataset.for;
      const field = id ? document.querySelector<HTMLInputElement>(`#${id}`) : null;
      if (!field) return;
      field.value = field.dataset.max ?? "";
    });
  });
</script>
