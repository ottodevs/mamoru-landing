---
import Base from "../../layouts/Base.astro";

const workingEth = "4.20";
const idleEth = "0.80";
const workingUsdc = "16,800";
const rewardsUsdc = "3,180";
const totalUsdc = "19,980";
const harvestedUsdc = "3,180";

const pools = [
  {
    pair: "WETH / USDC",
    a: "WETH",
    b: "USDC",
    address: "0x8ad5…c41a",
  },
  {
    pair: "WBTC / USDC",
    a: "WBTC",
    b: "USDC",
    address: "0x4e91…12f0",
  },
  {
    pair: "USDC",
    a: "USDC",
    b: "",
    address: "0xa0b8…e65d",
  },
  {
    pair: "ETH",
    a: "ETH",
    b: "",
    address: "0x388c…8182",
  },
];

const months = [
  { label: "Apr", value: 420 },
  { label: "May", value: 680 },
  { label: "Jun", value: 910 },
  { label: "Jul", value: 1_480 },
  { label: "Aug", value: 2_370 },
  { label: "Sep", value: 3_180 },
];
const yTicks = [0, 1000, 2000, 3000];
const maxY = 3200;
const chartW = 320;
const chartH = 160;
const left = 36;
const right = 12;
const top = 10;
const bottom = 28;
const innerW = chartW - left - right;
const innerH = chartH - top - bottom;
const chartPoints = months.map((m, i) => {
  const x = left + (i * innerW) / (months.length - 1);
  const y = top + innerH - (m.value / maxY) * innerH;
  return { x, y, label: m.label };
});
const line = chartPoints.map((p) => `${p.x},${p.y}`).join(" ");
const area = `${left},${top + innerH} ${line} ${left + innerW},${top + innerH}`;

const harvests = [
  { when: "26 Sep 2026", amount: "420 USDC", tx: "0x7c2a…9e14" },
  { when: "19 Sep 2026", amount: "380 USDC", tx: "0xb19d…44c8" },
  { when: "12 Sep 2026", amount: "410 USDC", tx: "0x03f1…a6b0" },
  { when: "5 Sep 2026", amount: "390 USDC", tx: "0xde80…21aa" },
  { when: "29 Aug 2026", amount: "1,580 USDC", tx: "0x91ab…c02f" },
];
---
<Base title="Mamoru — Dashboard" description="Working capital, idle ETH, and harvested USDC.">
  <main class="page">
    <header class="top">
      <a class="brand" href="/">
        <img src="/mark-two-stones.png" width="28" height="28" alt="" />
        <span>Mamoru</span>
      </a>
      <p class="badge" role="status">Mock · illustration</p>
    </header>

    <section class="total" aria-labelledby="total-title">
      <p class="kicker" id="total-title">Total balance</p>
      <p class="sum">{totalUsdc} <span class="unit">USDC</span></p>
      <ul class="legs">
        <li><span>Working capital</span> <strong>{workingUsdc} USDC</strong></li>
        <li><span>Accumulated rewards</span> <strong>{rewardsUsdc} USDC</strong></li>
      </ul>
    </section>

    <section class="row" aria-label="Fund and idle">
      <form class="card fund" action="#" method="post" onsubmit="return false;" aria-labelledby="fund-title">
        <p class="kicker" id="fund-title">Fund Mamoru</p>
        <div class="fund-row">
          <span class="asset">ETH</span>
          <label class="amount">
            <span class="sr">Amount</span>
            <input type="text" name="amount" inputmode="decimal" placeholder="0.00" autocomplete="off" />
          </label>
          <button type="submit" class="cta">Fund</button>
        </div>
      </form>
      <aside class="card idle">
        <p class="kicker">Idle capital</p>
        <p class="sum-sm">{idleEth} ETH</p>
        <p class="idle-copy">ETH pending to allocate by Mamoru.</p>
      </aside>
    </section>

    <section class="row" aria-label="Working and harvested">
      <details class="card fold">
        <summary>
          <span>
            <span class="kicker">Working capital</span>
            <span class="sum-sm">{workingEth} ETH</span>
          </span>
        </summary>
        <div class="fold-body">
          <ul class="pools">
            {pools.map((p) => (
              <li>
                <span class="pair" aria-hidden="true">
                  <span class={`logo ${p.a.toLowerCase()}`}>{p.a.slice(0, 1)}</span>
                  {p.b ? <span class={`logo ${p.b.toLowerCase()} second`}>{p.b.slice(0, 1)}</span> : null}
                </span>
                <span class="pool-meta">
                  <span class="pool-pair">{p.pair}</span>
                  <span class="pool-addr">{p.address}</span>
                </span>
              </li>
            ))}
          </ul>
          <button type="button" class="stop">Stop strategy</button>
        </div>
      </details>

      <details class="card fold">
        <summary>
          <span>
            <span class="kicker">Total harvested</span>
            <span class="sum-sm">{harvestedUsdc} USDC</span>
          </span>
        </summary>
        <div class="fold-body">
          <svg class="chart" viewBox={`0 0 ${chartW} ${chartH}`} role="img" aria-label="USDC harvested by month">
            {yTicks.map((tick) => {
              const y = top + innerH - (tick / maxY) * innerH;
              return (
                <g>
                  <line class="grid" x1={left} x2={left + innerW} y1={y} y2={y} />
                  <text class="axis" x={left - 6} y={y + 3}>{tick === 0 ? "0" : `${tick / 1000}k`}</text>
                </g>
              );
            })}
            <polyline class="chart-area" points={area} />
            <polyline class="chart-line" points={line} />
            {chartPoints.map((p) => (
              <g>
                <circle class="chart-dot" cx={p.x} cy={p.y} r="2.4" />
                <text class="axis month" x={p.x} y={chartH - 8}>{p.label}</text>
              </g>
            ))}
          </svg>
        </div>
      </details>
    </section>

    <section class="history-wrap" aria-labelledby="history-title">
      <details class="card fold wide">
        <summary>
          <span class="kicker" id="history-title">History</span>
        </summary>
        <ul class="ledger">
          {harvests.map((h) => (
            <li>
              <time>{h.when}</time>
              <span>{h.amount}</span>
              <code>{h.tx}</code>
            </li>
          ))}
        </ul>
      </details>
    </section>

    <p class="honesty">Illustration — example mix, not a promised rate.</p>
  </main>
</Base>

<style>
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .page {
    width: min(72rem, calc(100% - 2rem));
    margin: 0 auto;
    padding: 1.5rem 0 4rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    font-size: 1.15rem;
  }
  .badge {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--emerald);
    border: 1px solid var(--wash);
    padding: 0.25rem 0.65rem;
  }
  .kicker {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--stone);
  }
  .sum {
    margin: 0.35rem 0 0;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 400;
    color: var(--emerald);
  }
  .unit {
    font-size: 0.45em;
    letter-spacing: 0.08em;
    color: var(--stone);
  }
  .sum-sm {
    margin: 0.2rem 0 0;
    display: block;
    font-size: clamp(1.25rem, 2.4vw, 1.7rem);
  }
  .legs {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2rem;
  }
  .legs li { display: flex; flex-direction: column; gap: 0.2rem; }
  .legs span { color: var(--stone); font-size: 0.9rem; }
  .legs strong { font-weight: 400; }

  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    align-items: stretch;
  }
  .card {
    border: 1px solid var(--wash);
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    padding: 1.15rem 1.25rem;
    min-height: 7.25rem;
  }
  .fund, .idle {
    display: grid;
    align-content: center;
    gap: 0.55rem;
  }
  .fund-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.5rem;
    align-items: stretch;
  }
  .asset {
    display: flex;
    align-items: center;
    border: 1px solid var(--ink);
    background: var(--paper);
    padding: 0.55rem 0.85rem;
    font-family: var(--font-mono);
    letter-spacing: 0.1em;
  }
  .amount input {
    width: 100%;
    height: 100%;
    border: 1px solid var(--wash);
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 1.1rem;
    padding: 0.55rem 0.75rem;
  }
  .cta, .stop {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .cta {
    background: var(--ink);
    color: var(--rice);
    border: 0;
    padding: 0.6rem 1.15rem;
  }
  .idle-copy { margin: 0; color: var(--stone); line-height: 1.4; }

  .fold { padding: 0; }
  .fold summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.15rem 1.25rem;
    min-height: 7.25rem;
  }
  .fold summary::-webkit-details-marker { display: none; }
  .fold summary::after { content: "▾"; color: var(--stone); }
  .fold[open] summary { min-height: 0; }
  .fold[open] summary::after { content: "▴"; }
  .fold-body { padding: 0 1.25rem 1.25rem; display: grid; gap: 0.75rem; }

  .pools { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.7rem; }
  .pools li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem;
    align-items: center;
  }
  .pair {
    display: flex;
    align-items: center;
  }
  .logo {
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 999px;
    display: grid;
    place-items: center;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.04em;
    color: var(--rice);
    background: var(--ink);
  }
  .logo.usdc { background: var(--emerald); }
  .logo.weth, .logo.eth { background: var(--ink); }
  .logo.wbtc { background: #8a6a3a; }
  .logo.second { margin-left: -0.45rem; }
  .pool-meta { display: flex; flex-direction: column; gap: 0.12rem; }
  .pool-addr {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--stone);
  }
  .stop {
    justify-self: start;
    background: transparent;
    color: var(--emerald);
    border: 1px solid var(--emerald);
    padding: 0.6rem 0.95rem;
  }

  .chart { width: 100%; height: auto; }
  .grid { stroke: var(--wash); stroke-width: 1; }
  .axis {
    fill: var(--stone);
    font-size: 9px;
    font-family: var(--font-mono);
    text-anchor: end;
  }
  .axis.month { text-anchor: middle; }
  .chart-area {
    fill: color-mix(in srgb, var(--emerald) 18%, transparent);
    stroke: none;
  }
  .chart-line {
    fill: none;
    stroke: var(--emerald);
    stroke-width: 1.6;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .chart-dot { fill: var(--emerald); }

  .wide { width: 100%; }
  .ledger {
    list-style: none;
    margin: 0;
    padding: 0 1.25rem 1.2rem;
    display: grid;
    gap: 0.55rem;
  }
  .ledger li {
    display: grid;
    grid-template-columns: 8.5rem 1fr auto;
    gap: 1rem;
    border-top: 1px solid var(--wash);
    padding-top: 0.55rem;
    align-items: baseline;
  }
  .ledger code {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--emerald);
  }

  .honesty { margin: 0; color: var(--stone); font-size: 0.88rem; }

  @media (max-width: 760px) {
    .row { grid-template-columns: 1fr; }
    .ledger li { grid-template-columns: 1fr; gap: 0.2rem; }
  }
</style>
