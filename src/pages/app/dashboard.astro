---
import Base from "../../layouts/Base.astro";

const workingEth = "4.20";
const idleEth = "0.80";
const workingUsdc = "16,800";
const rewardsUsdc = "3,180";
const totalUsdc = "19,980";
const harvestedUsdc = "3,180";

const tokens = [
  { symbol: "USDC", share: "50%" },
  { symbol: "WETH", share: "28%" },
  { symbol: "WBTC", share: "7%" },
  { symbol: "ETH", share: "15%" },
];

const pools = [
  { name: "Uniswap v3 WETH / USDC", note: "35% sleeve · paired" },
  { name: "Uniswap v3 WBTC / USDC", note: "paired" },
  { name: "Aave v3 USDC", note: "50% sleeve · stables" },
  { name: "Morpho ETH", note: "15% sleeve · mercenary" },
];

const harvests = [
  { when: "29 Aug 2026", amount: 1580, label: "1,580 USDC" },
  { when: "5 Sep 2026", amount: 390, label: "390 USDC" },
  { when: "12 Sep 2026", amount: 410, label: "410 USDC" },
  { when: "19 Sep 2026", amount: 380, label: "380 USDC" },
  { when: "26 Sep 2026", amount: 420, label: "420 USDC" },
];

const cum = harvests.reduce<number[]>((acc, h) => {
  acc.push((acc.at(-1) ?? 0) + h.amount);
  return acc;
}, []);
const maxCum = Math.max(...cum);
const chartW = 240;
const chartH = 88;
const padX = 8;
const padY = 10;
const chartPoints = cum.map((v, i) => {
  const x = padX + (i * (chartW - padX * 2)) / (cum.length - 1);
  const y = chartH - padY - (v / maxCum) * (chartH - padY * 2);
  return { x, y };
});
const line = chartPoints.map((p) => `${p.x},${p.y}`).join(" ");
const area = `${padX},${chartH - padY} ${line} ${chartW - padX},${chartH - padY}`;
---
<Base title="Mamoru — Dashboard" description="Working capital, idle ETH, and USDC ready to send.">
  <main class="page">
    <header class="top">
      <a class="brand" href="/">
        <img src="/mark-two-stones.png" width="28" height="28" alt="" />
        <span>Mamoru</span>
      </a>
      <p class="badge" role="status">Mock · illustration</p>
    </header>

    <section class="total" aria-labelledby="total-title">
      <p class="kicker" id="total-title">Total balance</p>
      <p class="sum">{totalUsdc} <span class="unit">USDC</span></p>
      <ul class="legs">
        <li><span>Working capital</span> <strong>{workingUsdc} USDC</strong></li>
        <li><span>Accumulated rewards</span> <strong>{rewardsUsdc} USDC</strong></li>
      </ul>
    </section>

    <section class="fund" aria-labelledby="fund-title">
      <h1 id="fund-title">Fund Mamoru</h1>
      <form class="fund-row" action="#" method="post" onsubmit="return false;">
        <span class="asset" aria-label="Asset">ETH</span>
        <label class="amount">
          <span class="sr">Amount</span>
          <input type="text" name="amount" inputmode="decimal" placeholder="0.00" autocomplete="off" />
        </label>
        <button type="submit" class="cta">Fund</button>
      </form>
    </section>

    <section class="split" aria-label="Working and idle">
      <details class="wallet">
        <summary>
          <span>
            <span class="kicker">Wallet</span>
            <span class="sum-sm">Working {workingEth} ETH</span>
          </span>
        </summary>
        <div class="wallet-body">
          <p class="kicker">Tokens at work</p>
          <ul class="tokens">
            {tokens.map((t) => (
              <li>
                <span class="tok">{t.symbol}</span>
                <span class="share">{t.share}</span>
              </li>
            ))}
          </ul>
          <p class="kicker pools-k">Pools</p>
          <ul class="pools">
            {pools.map((p) => (
              <li>
                <span class="pool-name">{p.name}</span>
                <span class="pool-note">{p.note}</span>
              </li>
            ))}
          </ul>
          <button type="button" class="stop">Stop strategy</button>
        </div>
      </details>

      <aside class="idle">
        <p class="kicker">Idle capital</p>
        <p class="sum-sm">{idleEth} ETH</p>
        <p class="idle-copy">ETH pending to allocate by Mamoru.</p>
      </aside>
    </section>

    <section class="history" aria-labelledby="history-title">
      <details>
        <summary>
          <span class="kicker" id="history-title">History</span>
        </summary>
        <ul class="ledger">
          {harvests.toReversed().map((h) => (
            <li>
              <time>{h.when}</time>
              <span>{h.label}</span>
            </li>
          ))}
        </ul>
      </details>
      <div class="counter" aria-label="Total harvested">
        <p class="kicker">Total harvested</p>
        <p class="sum-sm">{harvestedUsdc} USDC</p>
        <svg class="chart" viewBox={`0 0 ${chartW} ${chartH}`} role="img" aria-label="USDC harvested over time">
          <polyline class="chart-area" points={area} />
          <polyline class="chart-line" points={line} />
          {chartPoints.map((p) => (
            <circle class="chart-dot" cx={p.x} cy={p.y} r="2.4" />
          ))}
        </svg>
      </div>
    </section>

    <p class="honesty">Illustration — example mix, not a promised rate.</p>
  </main>
</Base>

<style>
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .page {
    width: min(72rem, calc(100% - 2rem));
    margin: 0 auto;
    padding: 1.5rem 0 4rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    font-size: 1.15rem;
  }
  .badge {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--emerald);
    border: 1px solid var(--wash);
    padding: 0.25rem 0.65rem;
  }
  .kicker {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--stone);
  }
  .sum {
    margin: 0.35rem 0 0;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 400;
    letter-spacing: 0.01em;
    color: var(--emerald);
  }
  .unit {
    font-size: 0.45em;
    letter-spacing: 0.08em;
    color: var(--stone);
  }
  .sum-sm {
    margin: 0.2rem 0 0;
    font-size: clamp(1.25rem, 2.4vw, 1.7rem);
  }
  .legs {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2rem;
  }
  .legs li {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .legs span { color: var(--stone); font-size: 0.9rem; }
  .legs strong { font-weight: 400; }

  .fund, .wallet, .idle, .history details, .counter {
    border: 1px solid var(--wash);
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    padding: 1.25rem 1.35rem;
  }
  .fund h1 {
    margin: 0;
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 400;
  }
  .fund-row {
    margin-top: 1.1rem;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.65rem;
    align-items: stretch;
  }
  .asset {
    display: flex;
    align-items: center;
    border: 1px solid var(--ink);
    background: var(--paper);
    padding: 0.65rem 1rem;
    font-family: var(--font-mono);
    letter-spacing: 0.1em;
  }
  .amount input {
    width: 100%;
    height: 100%;
    border: 1px solid var(--wash);
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 1.15rem;
    padding: 0.65rem 0.85rem;
  }
  .cta, .stop {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .cta {
    background: var(--ink);
    color: var(--rice);
    border: 0;
    padding: 0.75rem 1.4rem;
  }

  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    align-items: stretch;
  }
  .wallet, .idle { min-height: 7.5rem; }
  .wallet { padding: 0; }
  .wallet summary, .history summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.35rem;
    min-height: 7.5rem;
  }
  .wallet summary::-webkit-details-marker,
  .history summary::-webkit-details-marker { display: none; }
  .wallet summary::after,
  .history summary::after {
    content: "▾";
    color: var(--stone);
  }
  .wallet[open] summary {
    min-height: 0;
  }
  .wallet[open] summary::after,
  .history[open] summary::after { content: "▴"; }
  .wallet-body { padding: 0 1.35rem 1.35rem; display: grid; gap: 0.75rem; }
  .tokens {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .tokens li {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    border: 1px solid var(--wash);
    padding: 0.4rem 0.7rem;
  }
  .tok { font-family: var(--font-mono); letter-spacing: 0.06em; }
  .share { color: var(--stone); font-size: 0.85rem; }
  .pools-k { margin-top: 0.4rem; }
  .pools { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.55rem; }
  .pools li { display: flex; flex-direction: column; gap: 0.15rem; }
  .pool-note { color: var(--stone); font-size: 0.88rem; }

  .idle { display: grid; gap: 0.45rem; align-content: center; }
  .idle-copy { margin: 0; color: var(--stone); line-height: 1.4; }
  .stop {
    margin-top: 0.4rem;
    justify-self: start;
    background: transparent;
    color: var(--emerald);
    border: 1px solid var(--emerald);
    padding: 0.65rem 1rem;
  }

  .history {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    align-items: start;
  }
  .history details { padding: 0; }
  .history summary { min-height: 0; }
  .ledger {
    list-style: none;
    margin: 0;
    padding: 0 1.35rem 1.25rem;
    display: grid;
    gap: 0.55rem;
  }
  .ledger li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid var(--wash);
    padding-top: 0.55rem;
  }
  .counter { display: grid; gap: 0.35rem; align-content: start; }
  .chart {
    width: 100%;
    height: auto;
    margin-top: 0.5rem;
  }
  .chart-area {
    fill: color-mix(in srgb, var(--emerald) 18%, transparent);
    stroke: none;
  }
  .chart-line {
    fill: none;
    stroke: var(--emerald);
    stroke-width: 1.6;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .chart-dot { fill: var(--emerald); }

  .honesty {
    margin: 0;
    color: var(--stone);
    font-size: 0.88rem;
  }

  @media (max-width: 760px) {
    .fund-row, .split, .history {
      grid-template-columns: 1fr;
    }
  }
</style>
