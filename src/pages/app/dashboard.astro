---
import Base from "../../layouts/Base.astro";
import TokenMark from "../../components/TokenMark.astro";

type Token = "ETH" | "WETH" | "USDC" | "WBTC";

const workingEth = "4.20";
const idleEth = "0.80";
const workingUsdc = "16,800";
const claimableUsdc = "420";
const totalUsdc = "17,220";
const harvestedUsdc = "3,180";

const inUse: Token[] = ["ETH", "WETH", "WBTC", "USDC"];

const pools: {
  protocol: string;
  pair: string;
  a: Token;
  b?: Token;
  address: string;
  chain: string;
  sleeve: string;
  amount: string;
}[] = [
  {
    protocol: "Uniswap v3",
    pair: "WETH / USDC",
    a: "WETH",
    b: "USDC",
    address: "0x8ad599c3A0ff1De082011EFDDc58f1908eb6e6D8",
    chain: "Ethereum",
    sleeve: "35% · paired",
    amount: "1.47 ETH",
  },
  {
    protocol: "Uniswap v3",
    pair: "WBTC / USDC",
    a: "WBTC",
    b: "USDC",
    address: "0x99ac8cA7087fA4A2A1FB6357269965A2014ABc35",
    chain: "Ethereum",
    sleeve: "paired",
    amount: "0.29 ETH",
  },
  {
    protocol: "Aave v3",
    pair: "USDC",
    a: "USDC",
    address: "0x98C23E9d8f34FEFb1B7BD6a91B7FF122F4e16F5c",
    chain: "Ethereum",
    sleeve: "50% · stables",
    amount: "2.10 ETH",
  },
  {
    protocol: "Morpho",
    pair: "ETH",
    a: "ETH",
    address: "0x388C818CA8B9251b393131C08a736A67ccB19297",
    chain: "Ethereum",
    sleeve: "15% · mercenary",
    amount: "0.34 ETH",
  },
];

const months = [
  { label: "Apr", value: 420 },
  { label: "May", value: 680 },
  { label: "Jun", value: 910 },
  { label: "Jul", value: 1_480 },
  { label: "Aug", value: 2_370 },
  { label: "Sep", value: 3_180 },
];
const maxY = 3200;
const chartW = 320;
const chartH = 168;
const left = 12;
const right = 12;
const top = 10;
const bottom = 28;
const innerW = chartW - left - right;
const innerH = chartH - top - bottom;
const chartPoints = months.map((m, i) => {
  const x = left + (i * innerW) / (months.length - 1);
  const y = top + innerH - (m.value / maxY) * innerH;
  return { x, y, label: m.label };
});
const line = chartPoints.map((p) => `${p.x},${p.y}`).join(" ");
const area = `${left},${top + innerH} ${line} ${left + innerW},${top + innerH}`;

const harvests = [
  { when: "26 Sep 2026", amount: "420 USDC", tx: "0x7c2a91e0b19d44c803f1a6b09e14c2" },
  { when: "19 Sep 2026", amount: "380 USDC", tx: "0xb19d03aa7c2a91e044c8de80a6b0" },
  { when: "12 Sep 2026", amount: "410 USDC", tx: "0x03f191abde8021aac02f7c2a91e0" },
  { when: "5 Sep 2026", amount: "390 USDC", tx: "0xde80b19d44c8a6b07c2a91e0c02f" },
  { when: "29 Aug 2026", amount: "1,580 USDC", tx: "0x91abc02f7c2a91e0b19d44c803f1" },
];

const shortAddr = (a: string) => `${a.slice(0, 6)}…${a.slice(-4)}`;
const shortTx = (a: string) => `${a.slice(0, 6)}…${a.slice(-4)}`;
---
<Base title="Mamoru — Dashboard" description="Working capital, idle ETH, and harvested USDC.">
  <main class="page">
    <header class="mast">
      <a class="brand" href="/">
        <img src="/mark-two-stones.png" width="36" height="36" alt="" />
        <span>Mamoru</span>
      </a>
    </header>

    <section class="balance" aria-labelledby="total-title">
      <p class="kicker" id="total-title">Total balance</p>
      <p class="sum">{totalUsdc} <span class="unit">USDC</span></p>
      <ul class="legs">
        <li>
          <span class="leg-label">Working capital</span>
          <strong>{workingUsdc} USDC</strong>
        </li>
        <li>
          <span class="leg-label">Claimable rewards</span>
          <strong>{claimableUsdc} USDC</strong>
          <button type="button" class="claim">Claim rewards →</button>
        </li>
      </ul>
    </section>

    <section class="row" aria-label="Fund and idle">
      <form class="card fund" action="#" method="post" onsubmit="return false;" aria-labelledby="fund-title">
        <p class="title" id="fund-title">Fund Mamoru</p>
        <div class="fund-row">
          <span class="asset">ETH</span>
          <label class="amount">
            <span class="sr">Amount</span>
            <input type="text" name="amount" inputmode="decimal" placeholder="0.00" autocomplete="off" />
          </label>
          <button type="submit" class="cta">Fund</button>
        </div>
      </form>
      <aside class="card idle">
        <p class="title">Idle capital</p>
        <p class="sum-sm">{idleEth} ETH</p>
        <p class="idle-copy">ETH pending to allocate by Mamoru.</p>
      </aside>
    </section>

    <details class="card fold wide">
      <summary>
        <span>
          <span class="title">Working capital</span>
          <span class="sum-sm">{workingEth} ETH</span>
        </span>
      </summary>
      <div class="fold-body">
        <p class="kicker">Assets in use</p>
        <ul class="strip">
          {inUse.map((sym) => (
            <li>
              <TokenMark symbol={sym} size={28} />
              <span>{sym}</span>
            </li>
          ))}
        </ul>
        <p class="kicker">Where it sits</p>
        <ul class="pools">
          {pools.map((p) => (
            <li>
              <span class="pair">
                <TokenMark symbol={p.a} size={28} />
                {p.b ? <span class="overlap"><TokenMark symbol={p.b} size={28} /></span> : null}
              </span>
              <span class="pool-meta">
                <span class="pool-pair">{p.protocol} · {p.pair}</span>
                <span class="pool-addr">{p.chain} · {shortAddr(p.address)}</span>
                <span class="pool-note">{p.sleeve}</span>
              </span>
              <span class="pool-amt">{p.amount}</span>
            </li>
          ))}
        </ul>
        <button type="button" class="stop">Stop strategy</button>
      </div>
    </details>

    <details class="card fold wide">
      <summary>
        <span>
          <span class="title">Total harvested</span>
          <span class="sum-sm">{harvestedUsdc} USDC</span>
        </span>
      </summary>
      <div class="harvest">
        <ul class="ledger">
          {harvests.map((h) => (
            <li>
              <time>{h.when}</time>
              <span>{h.amount}</span>
              <code>{shortTx(h.tx)}</code>
            </li>
          ))}
        </ul>
        <svg class="chart" viewBox={`0 0 ${chartW} ${chartH}`} role="img" aria-label="USDC harvested by month">
          <polyline class="chart-area" points={area} />
          <polyline class="chart-line" points={line} />
          {chartPoints.map((p) => (
            <g>
              <circle class="chart-dot" cx={p.x} cy={p.y} r="2.4" />
              <text class="axis month" x={p.x} y={chartH - 8}>{p.label}</text>
            </g>
          ))}
        </svg>
      </div>
    </details>

  </main>
</Base>

<style>
  :global(html), :global(body) {
    height: 100%;
    overflow: hidden;
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .page {
    width: min(68rem, calc(100% - 3rem));
    height: 100dvh;
    margin: 0 auto;
    padding: 1.25rem 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    overflow: hidden;
  }
  .mast { flex: 0 0 auto; }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    font-size: 1.35rem;
    letter-spacing: 0.02em;
  }
  .kicker {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--stone);
  }
  .title {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 400;
    letter-spacing: 0.01em;
  }
  .balance { flex: 0 0 auto; }
  .sum {
    margin: 0.15rem 0 0;
    font-size: clamp(2.8rem, 7vw, 4.4rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--emerald);
  }
  .unit {
    margin-left: 0.2em;
    font-size: 0.32em;
    letter-spacing: 0.12em;
    color: var(--stone);
    font-weight: 400;
  }
  .sum-sm {
    margin: 0.1rem 0 0;
    display: block;
    font-size: 1.2rem;
  }
  .legs {
    list-style: none;
    margin: 1.1rem 0 0;
    padding: 0;
    display: flex;
    gap: 3rem;
  }
  .legs li { display: flex; flex-direction: column; gap: 0.15rem; align-items: flex-start; }
  .leg-label { color: var(--stone); font-size: 0.88rem; }
  .legs strong { font-weight: 400; font-size: 1.15rem; }
  .claim {
    margin-top: 0.15rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--emerald);
    font: inherit;
    font-size: 0.88rem;
    letter-spacing: 0.02em;
    cursor: pointer;
  }
  .claim:hover { text-decoration: underline; }

  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    align-items: stretch;
  }
  .row { flex: 0 0 auto; }
  .card {
    border-top: 1px solid var(--wash);
    background: transparent;
    padding: 0.85rem 0;
  }
  .wide { width: 100%; flex: 0 0 auto; }
  .fund, .idle {
    display: grid;
    align-content: start;
    gap: 0.4rem;
  }
  .fund-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.5rem;
    align-items: stretch;
  }
  .asset {
    display: flex;
    align-items: center;
    border: 1px solid var(--ink);
    background: var(--paper);
    padding: 0.55rem 0.85rem;
    font-family: var(--font-mono);
    letter-spacing: 0.1em;
  }
  .amount input {
    width: 100%;
    height: 100%;
    border: 1px solid var(--wash);
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 1.1rem;
    padding: 0.55rem 0.75rem;
  }
  .cta, .stop {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .cta {
    background: var(--ink);
    color: var(--rice);
    border: 0;
    padding: 0.6rem 1.15rem;
  }
  .idle-copy { margin: 0; color: var(--stone); line-height: 1.4; }

  .fold { padding: 0.7rem 0; }
  .fold summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0;
  }
  .fold summary::-webkit-details-marker { display: none; }
  .fold summary::after { content: "▾"; color: var(--stone); }
  .fold[open] summary::after { content: "▴"; }
  .fold-body, .harvest { padding: 0.65rem 0 0; }
  .fold-body { display: grid; gap: 0.55rem; max-height: 28vh; overflow: auto; }
  .harvest { max-height: 28vh; overflow: auto; }

  .strip {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.1rem;
  }
  .strip li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
  }

  .pools { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.85rem; }
  .pools li {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.9rem;
    align-items: center;
    border-top: 1px solid var(--wash);
    padding-top: 0.75rem;
  }
  .pair { display: flex; align-items: center; }
  .overlap { margin-left: -0.45rem; }
  .pool-meta { display: flex; flex-direction: column; gap: 0.12rem; min-width: 0; }
  .pool-pair { font-size: 1rem; }
  .pool-addr, .pool-note {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--stone);
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pool-amt { font-family: var(--font-mono); font-size: 0.85rem; }
  .stop {
    justify-self: start;
    background: transparent;
    color: var(--emerald);
    border: 1px solid var(--emerald);
    padding: 0.6rem 0.95rem;
  }

  .harvest {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
  }
  .chart { width: 100%; height: auto; }
  .axis.month {
    fill: var(--stone);
    font-size: 9px;
    font-family: var(--font-mono);
    text-anchor: middle;
  }
  .chart-area {
    fill: color-mix(in srgb, var(--emerald) 18%, transparent);
    stroke: none;
  }
  .chart-line {
    fill: none;
    stroke: var(--emerald);
    stroke-width: 1.6;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .chart-dot { fill: var(--emerald); }

  .ledger {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }
  .ledger li {
    display: grid;
    grid-template-columns: 7.5rem auto 1fr;
    gap: 0.75rem;
    border-top: 1px solid var(--wash);
    padding-top: 0.55rem;
    align-items: baseline;
  }
  .ledger code {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--emerald);
    justify-self: end;
  }

  @media (max-width: 760px) {
    :global(html), :global(body) { overflow: auto; }
    .page { height: auto; overflow: visible; }
    .row, .harvest { grid-template-columns: 1fr; }
    .pools li, .ledger li { grid-template-columns: 1fr; gap: 0.25rem; }
    .ledger code { justify-self: start; }
  }
</style>
