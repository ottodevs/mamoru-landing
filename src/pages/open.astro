---
import Base from "../layouts/Base.astro";
import { APP_HREF, OPEN_COPY as copy } from "../open-copy";

const emailHref = `mailto:${copy.footer.email}`;
---
<Base title={copy.title} description={copy.description} canonical="https://mamoru.lol/">
  <a class="skip" href="#content">Skip to content</a>
  <header class="nav">
    <a class="brand" href="#top">
      <img src="/mark-two-stones.png" width="28" height="28" alt="" />
      <span>Mamoru</span>
    </a>
    <nav class="links" aria-label="On this page">
      {copy.nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <a class="cta nav-cta" href={APP_HREF}>{copy.cta}</a>
  </header>

  <main id="content">
    <section class="hero" id="top" aria-labelledby="hero-title">
      <img class="mark" src="/mark-two-stones.png" width="46" height="46" alt="The Split" />
      <h1 id="hero-title">
        <span>{copy.hero.line1}</span>
        <span>{copy.hero.line2}</span>
      </h1>
      <p class="lede">
        {copy.hero.lede.split(". ").filter(Boolean).map((part) => (
          <span>{part.endsWith(".") ? part : `${part}.`}</span>
        ))}
      </p>
      <a class="cta" href={APP_HREF}>{copy.cta}</a>
    </section>

    <section class="band" id="works" aria-labelledby="works-title">
      <div class="wrap">
        <h2 id="works-title">{copy.works.heading}</h2>
        <ol class="cards">
          {copy.works.moves.map((move, index) => (
            <li class="card">
              <p class="step">{String(index + 1).padStart(2, "0")}</p>
              <h3 class="name">{move.title}</h3>
              <p class="body">{move.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="band" id="spend" aria-labelledby="spend-title">
      <div class="prose">
        <h2 id="spend-title">{copy.spend.heading}</h2>
        <p class="body">{copy.spend.body}</p>
        <a class="cta spend-cta" href={APP_HREF}>{copy.cta}</a>
      </div>
    </section>

    <section class="band" id="questions" aria-labelledby="questions-title">
      <div class="prose wide">
        <h2 id="questions-title">{copy.questions.heading}</h2>
        <div class="qa-list">
          {copy.questions.items.map((item) => (
            <details class="qa">
              <summary>{item.q}</summary>
              {item.a.map((para) => (
                <p class="body">{para}</p>
              ))}
              {"reach" in item && item.reach ? (
                <p class="body reach">
                  {item.reach.map((link) => (
                    <a
                      class="mail"
                      href={link.href}
                      {...(link.href.startsWith("http")
                        ? { target: "_blank", rel: "noopener noreferrer" }
                        : {})}
                    >
                      {link.label}
                    </a>
                  ))}
                </p>
              ) : null}
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="foot-brand">
      <img src="/mark-two-stones.png" width="32" height="32" alt="" />
      <p class="name">{copy.footer.name}</p>
    </div>
    <p class="body">{copy.footer.line}</p>
    <a class="mail" href={emailHref}>{copy.footer.email}</a>
  </footer>
</Base>

<style>
  .skip {
    position: absolute;
    left: 0.75rem;
    top: -4rem;
    z-index: 5;
    background: var(--ink);
    color: var(--paper);
    padding: 0.4rem 0.7rem;
    text-decoration: none;
  }
  .skip:focus {
    top: 0.75rem;
  }

  .nav {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    width: 100%;
    min-height: 4rem;
    max-height: 4.5rem;
    padding: 0.55rem clamp(1rem, 4vw, 2rem);
    background-color: var(--rice);
    background-image: url("/rice-washi-tile.png");
    background-image: image-set(
      url("/rice-washi-tile.webp") type("image/webp"),
      url("/rice-washi-tile.png") type("image/png")
    );
    background-repeat: repeat;
    background-size: 256px 256px;
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 8%, transparent);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--ink);
    font-size: 1.05rem;
    line-height: 1;
  }
  .brand img {
    width: 1.75rem;
    height: auto;
    display: block;
  }

  .links {
    display: flex;
    align-items: center;
    gap: 1.15rem;
    min-width: 0;
  }
  .links a {
    color: var(--ink);
    text-decoration: none;
    font-size: 1rem;
    line-height: 1;
    white-space: nowrap;
  }
  .links a:hover,
  .links a:focus-visible {
    color: var(--emerald);
  }

  .nav-cta {
    margin-left: auto;
    padding: 0.5rem 0.85rem;
    font-size: 0.95rem;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.7rem 1.15rem;
    border: 0;
    border-radius: 0;
    background: var(--ink);
    color: var(--paper);
    text-decoration: none;
    font-size: 0.95rem;
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
  }
  .cta:hover {
    background: var(--emerald);
    color: var(--paper);
  }
  .cta:focus-visible,
  .brand:focus-visible,
  .mail:focus-visible,
  summary:focus-visible {
    outline: 2px solid var(--emerald);
    outline-offset: 3px;
  }
  .cta:active {
    transform: translateY(1px);
  }

  .hero {
    min-height: calc(100dvh - 4.5rem);
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem clamp(1rem, 5vw, 2.5rem) 3rem;
    box-sizing: border-box;
  }
  .mark {
    width: clamp(2.25rem, 3.4vw, 2.9rem);
    height: auto;
    display: block;
  }
  h1 {
    margin: clamp(0.9rem, 3vh, 1.4rem) 0 0;
    font-size: clamp(2.4rem, 8vw, 5.2rem);
    font-weight: 400;
    letter-spacing: 0.04em;
    line-height: 0.95;
  }
  h1 span {
    display: block;
  }
  .lede {
    margin: clamp(1.1rem, 3vh, 1.8rem) 0 0;
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    line-height: 1.35;
  }
  .lede span {
    display: block;
  }
  .hero .cta {
    margin-top: clamp(1.3rem, 3vh, 2rem);
  }

  .band,
  .hero {
    scroll-margin-top: 4.5rem;
  }
  .band {
    width: 100%;
    padding: clamp(4rem, 9vw, 6.5rem) clamp(1.15rem, 5vw, 4.5rem);
    box-sizing: border-box;
  }
  .wrap {
    max-width: 68rem;
    margin-inline: auto;
  }
  .prose {
    max-width: 38rem;
  }
  .prose.wide {
    max-width: 44rem;
  }
  h2 {
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 2.7rem);
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1.15;
  }
  .name {
    margin: 0;
    font-size: clamp(1.25rem, 2vw, 1.55rem);
    line-height: 1.25;
  }
  .body {
    margin: 0.55rem 0 0;
    font-size: 1.125rem;
    line-height: 1.45;
    max-width: 36rem;
  }
  .cards {
    list-style: none;
    margin: clamp(1.8rem, 4vw, 2.8rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-height: 12.5rem;
    padding: 1.5rem 1.5rem 1.75rem;
    border: 1px solid var(--wash);
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    box-sizing: border-box;
  }
  .step {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--emerald);
  }
  .card .name {
    margin: 0;
    font-weight: 400;
  }
  .card .body {
    margin: 0;
  }
  .spend-cta {
    margin-top: 1.4rem;
  }
  .reach {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
  }

  .qa-list {
    margin-top: clamp(1.4rem, 3vw, 2rem);
  }
  .qa {
    border-top: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
    padding: 0.95rem 0;
  }
  .qa:last-child {
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
  }
  summary {
    cursor: pointer;
    font-size: clamp(1.15rem, 2vw, 1.35rem);
    line-height: 1.3;
  }
  .qa .body {
    margin-top: 0.7rem;
    padding-bottom: 0.35rem;
  }

  .mail {
    color: var(--emerald);
    text-underline-offset: 0.16em;
  }
  .mail:hover {
    color: var(--ink);
  }

  .foot {
    width: 100%;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    flex-wrap: wrap;
    padding: 1.5rem clamp(1.15rem, 5vw, 4.5rem) 2rem;
    border-top: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
  }
  .foot-brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  .foot-brand img {
    width: 2rem;
    height: auto;
    display: block;
  }
  .foot .body {
    margin: 0;
  }

  @media (min-width: 761px) {
    .cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }

  @media (max-width: 760px) {
    .nav {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        "brand cta"
        "links links";
      max-height: none;
      row-gap: 0.65rem;
      align-items: center;
      padding-top: 0.75rem;
      padding-bottom: 0.75rem;
    }
    .brand {
      grid-area: brand;
    }
    .nav-cta {
      grid-area: cta;
      margin-left: 0;
      justify-self: end;
    }
    .links {
      grid-area: links;
      width: auto;
      gap: 0.85rem;
      flex-wrap: wrap;
    }
    .card {
      min-height: 0;
    }
    .foot {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta:active {
      transform: none;
    }
  }
</style>
