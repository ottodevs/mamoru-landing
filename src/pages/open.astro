---
import Base from "../layouts/Base.astro";
import { APP_HREF, OPEN_COPY as copy } from "../open-copy";

const emailHref = `mailto:${copy.footer.email}`;
---
<Base title={copy.title} description={copy.description} canonical="https://mamoru.lol/">
  <a class="skip" href="#content">Skip to content</a>
  <header class="nav">
    <a class="brand" href="#top">
      <img src="/mark-two-stones.png" width="28" height="28" alt="" />
      <span>Mamoru</span>
    </a>
    <nav class="links" aria-label="On this page">
      {copy.nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <a class="cta nav-cta js-launch" href={APP_HREF}>{copy.cta}</a>
  </header>

  <main id="content">
    <section class="hero" id="top" aria-labelledby="hero-title">
      <img class="mark" src="/mark-two-stones.png" width="46" height="46" alt="The Split" />
      <h1 id="hero-title">
        <span>{copy.hero.line1}</span>
        <span>{copy.hero.line2}</span>
      </h1>
      <p class="lede">
        {copy.hero.lede.split(". ").filter(Boolean).map((part) => (
          <span>{part.endsWith(".") ? part : `${part}.`}</span>
        ))}
      </p>
      <a class="cta js-launch" href={APP_HREF}>{copy.cta}</a>
    </section>

    <section class="band" id="works" aria-labelledby="works-title">
      <div class="wrap">
        <h2 id="works-title">{copy.works.heading}</h2>
        <ol class="flow">
          {copy.works.moves.map((move, index) => (
            <>
              <li class="card">
                <p class="step">{String(index + 1).padStart(2, "0")}</p>
                <h3 class="name">{move.title}</h3>
                <p class="body">{move.body}</p>
              </li>
              {index < copy.works.moves.length - 1 ? (
                <li class="seq" aria-hidden="true">
                  <svg class="seq-h" viewBox="0 0 48 24" fill="none">
                    <path class="seq-shaft" d="M2 12 H38" />
                    <path class="seq-head" d="M30 5 L40 12 L30 19" />
                  </svg>
                  <svg class="seq-v" viewBox="0 0 24 48" fill="none">
                    <path class="seq-shaft" d="M12 2 V38" />
                    <path class="seq-head" d="M5 30 L12 40 L19 30" />
                  </svg>
                </li>
              ) : null}
            </>
          ))}
        </ol>
      </div>
    </section>

    <section class="band" id="spend" aria-labelledby="spend-title">
      <div class="wrap">
        <h2 id="spend-title">{copy.spend.heading}</h2>
        <p class="body">{copy.spend.body}</p>
        <a class="cta spend-cta js-launch" href={APP_HREF}>{copy.cta}</a>
      </div>
    </section>

    <section class="band" id="questions" aria-labelledby="questions-title">
      <div class="wrap">
        <h2 id="questions-title">{copy.questions.heading}</h2>
        <div class="qa-list">
          {copy.questions.items.map((item) => (
            <details class="qa">
              <summary>{item.q}</summary>
              {item.a.map((para) => (
                <p class="body">{para}</p>
              ))}
              {"reach" in item && item.reach ? (
                <p class="body reach">
                  {item.reach.map((link) => (
                    <a
                      class="mail"
                      href={link.href}
                      {...(link.href.startsWith("http")
                        ? { target: "_blank", rel: "noopener noreferrer" }
                        : {})}
                    >
                      {link.label}
                    </a>
                  ))}
                </p>
              ) : null}
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="foot-brand">
      <img src="/mark-two-stones.png" width="32" height="32" alt="" />
      <p class="name">{copy.footer.name}</p>
    </div>
    <p class="body">{copy.footer.line}</p>
    <a class="mail" href={emailHref}>{copy.footer.email}</a>
  </footer>

  <dialog class="onboard" id="mamoru-onboard" aria-labelledby="onboard-title">
    <div class="onboard-card">
      {copy.onboard.screens.map((screen, index) => (
        <div class="onboard-screen" data-step={index} hidden={index !== 0}>
          <p class="onboard-step">{String(index + 1).padStart(2, "0")} / 03</p>
          <h2 class="onboard-title" id={index === 0 ? "onboard-title" : undefined}>
            {screen.title}
          </h2>
          {screen.body.map((para) => (
            <p class="onboard-body">{para}</p>
          ))}
          <div class="onboard-actions">
            {index < copy.onboard.screens.length - 1 ? (
              <>
                <button type="button" class="ob-btn ghost js-onboard-skip">{copy.onboard.skip}</button>
                <button type="button" class="ob-btn solid js-onboard-next">{copy.onboard.next}</button>
              </>
            ) : (
              <button type="button" class="ob-btn solid js-onboard-finish">{copy.onboard.finish}</button>
            )}
          </div>
        </div>
      ))}
    </div>
  </dialog>
  <script is:inline define:vars={{ appHref: APP_HREF, storageKey: copy.onboard.storageKey }}>
    const KEY = storageKey;
    const APP = appHref;
    const root = document.getElementById("mamoru-onboard");
    function seen() {
      try { return localStorage.getItem(KEY) === "1"; } catch { return false; }
    }
    function mark() {
      try { localStorage.setItem(KEY, "1"); } catch {}
    }
    function goApp() {
      mark();
      window.location.href = APP;
    }
    function show(step) {
      if (!root) return;
      root.querySelectorAll(".onboard-screen").forEach((el) => {
        const n = Number(el.getAttribute("data-step"));
        el.hidden = n !== step;
      });
      root.dataset.step = String(step);
      if (typeof root.showModal === "function" && !root.open) root.showModal();
    }
    document.querySelectorAll(".js-launch").forEach((link) => {
      link.addEventListener("click", (event) => {
        if (seen()) return;
        event.preventDefault();
        show(0);
      });
    });
    root?.querySelectorAll(".js-onboard-skip, .js-onboard-finish").forEach((btn) => {
      btn.addEventListener("click", goApp);
    });
    root?.querySelectorAll(".js-onboard-next").forEach((btn) => {
      btn.addEventListener("click", () => {
        const step = Number(root.dataset.step || "0") + 1;
        show(step);
      });
    });
    root?.addEventListener("cancel", (event) => {
      event.preventDefault();
      goApp();
    });
  </script>
</Base>

<style>
  .skip {
    position: absolute;
    left: 0.75rem;
    top: -4rem;
    z-index: 5;
    background: var(--ink);
    color: var(--paper);
    padding: 0.4rem 0.7rem;
    text-decoration: none;
  }
  .skip:focus {
    top: 0.75rem;
  }

  .nav {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    width: 100%;
    min-height: 4rem;
    max-height: 4.5rem;
    padding: 0.55rem clamp(1rem, 4vw, 2rem);
    background-color: var(--rice);
    background-image: url("/rice-washi-tile.png");
    background-image: image-set(
      url("/rice-washi-tile.webp") type("image/webp"),
      url("/rice-washi-tile.png") type("image/png")
    );
    background-repeat: repeat;
    background-size: 256px 256px;
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 8%, transparent);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--ink);
    font-size: 1.05rem;
    line-height: 1;
  }
  .brand img {
    width: 1.75rem;
    height: auto;
    display: block;
  }

  .links {
    display: flex;
    align-items: center;
    gap: 1.15rem;
    min-width: 0;
  }
  .links a {
    color: var(--ink);
    text-decoration: none;
    font-size: 1rem;
    line-height: 1;
    white-space: nowrap;
  }
  .links a:hover,
  .links a:focus-visible {
    color: var(--emerald);
  }

  .nav-cta {
    margin-left: auto;
    padding: 0.5rem 0.85rem;
    font-size: 0.95rem;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.7rem 1.15rem;
    border: 0;
    border-radius: 0;
    background: var(--ink);
    color: var(--paper);
    text-decoration: none;
    font-size: 0.95rem;
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
  }
  .cta:hover {
    background: var(--emerald);
    color: var(--paper);
  }
  .cta:focus-visible,
  .brand:focus-visible,
  .mail:focus-visible,
  summary:focus-visible {
    outline: 2px solid var(--emerald);
    outline-offset: 3px;
  }
  .cta:active {
    transform: translateY(1px);
  }

  .hero {
    min-height: calc(100dvh - 4.5rem);
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem clamp(1rem, 5vw, 2.5rem) 3rem;
    box-sizing: border-box;
  }
  .mark {
    width: clamp(2.25rem, 3.4vw, 2.9rem);
    height: auto;
    display: block;
  }
  h1 {
    margin: clamp(0.9rem, 3vh, 1.4rem) 0 0;
    font-size: clamp(2.4rem, 8vw, 5.2rem);
    font-weight: 400;
    letter-spacing: 0.04em;
    line-height: 0.95;
  }
  h1 span {
    display: block;
  }
  .lede {
    margin: clamp(1.1rem, 3vh, 1.8rem) 0 0;
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    line-height: 1.35;
  }
  .lede span {
    display: block;
  }
  .hero .cta {
    margin-top: clamp(1.3rem, 3vh, 2rem);
  }

  .band,
  .hero {
    scroll-margin-top: 4.5rem;
  }
  .band {
    width: 100%;
    padding: clamp(4rem, 9vw, 6.5rem) clamp(1.15rem, 5vw, 4.5rem);
    box-sizing: border-box;
  }
  .wrap {
    max-width: 68rem;
    margin-inline: auto;
  }
  h2 {
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 2.7rem);
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1.15;
  }
  .name {
    margin: 0;
    font-size: clamp(1.25rem, 2vw, 1.55rem);
    line-height: 1.25;
  }
  .body {
    margin: 0.55rem 0 0;
    font-size: 1.125rem;
    line-height: 1.45;
    max-width: 36rem;
  }
  .flow {
    list-style: none;
    margin: clamp(1.8rem, 4vw, 2.8rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-height: 12.5rem;
    padding: 1.5rem 1.5rem 1.75rem;
    border: 1px solid var(--wash);
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    box-sizing: border-box;
  }
  .seq {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--emerald);
    height: 2.75rem;
  }
  .seq-h,
  .seq-v {
    overflow: visible;
  }
  .seq-h {
    display: none;
    width: 3rem;
    height: 1.5rem;
  }
  .seq-v {
    display: block;
    width: 1.5rem;
    height: 3rem;
  }
  .seq-shaft,
  .seq-head {
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .seq-shaft {
    stroke-dasharray: 6 8;
    animation: seq-flow 1.1s linear infinite;
  }
  .seq-head {
    animation: seq-nudge 1.1s ease-in-out infinite;
  }
  .seq:nth-child(4) .seq-shaft,
  .seq:nth-child(4) .seq-head {
    animation-delay: 0.55s;
  }
  @keyframes seq-flow {
    to {
      stroke-dashoffset: -28;
    }
  }
  @keyframes seq-nudge {
    0%,
    100% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(3px, 0);
    }
  }
  .step {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--emerald);
  }
  .card .name {
    margin: 0;
    font-weight: 400;
  }
  .card .body {
    margin: 0;
  }
  .spend-cta {
    margin-top: 1.4rem;
  }
  .reach {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
  }

  .qa-list {
    margin-top: clamp(1.4rem, 3vw, 2rem);
  }
  .qa {
    border-top: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
    padding: 0.95rem 0;
  }
  .qa:last-child {
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
  }
  summary {
    cursor: pointer;
    font-size: clamp(1.15rem, 2vw, 1.35rem);
    line-height: 1.3;
  }
  .qa .body {
    margin-top: 0.7rem;
    padding-bottom: 0.35rem;
  }

  .mail {
    color: var(--emerald);
    text-underline-offset: 0.16em;
  }
  .mail:hover {
    color: var(--ink);
  }

  .foot {
    width: 100%;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    flex-wrap: wrap;
    padding: 1.5rem clamp(1.15rem, 5vw, 4.5rem) 2rem;
    border-top: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
  }
  .foot-brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  .foot-brand img {
    width: 2rem;
    height: auto;
    display: block;
  }
  .foot .body {
    margin: 0;
  }

  @media (min-width: 761px) {
    .flow {
      grid-template-columns: 1fr auto 1fr auto 1fr;
      align-items: stretch;
      gap: 0;
    }
    .seq {
      height: auto;
      width: 3.25rem;
    }
    .seq-h {
      display: block;
    }
    .seq-v {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .nav {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        "brand cta"
        "links links";
      max-height: none;
      row-gap: 0.65rem;
      align-items: center;
      padding-top: 0.75rem;
      padding-bottom: 0.75rem;
    }
    .brand {
      grid-area: brand;
    }
    .nav-cta {
      grid-area: cta;
      margin-left: 0;
      justify-self: end;
    }
    .links {
      grid-area: links;
      width: auto;
      gap: 0.85rem;
      flex-wrap: wrap;
    }
    .card {
      min-height: 0;
    }
    @keyframes seq-nudge {
      0%,
      100% {
        transform: translate(0, 0);
      }
      50% {
        transform: translate(0, 3px);
      }
    }
    .foot {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  .onboard {
    width: min(50vw, 40rem);
    max-width: 92vw;
    max-height: min(86dvh, 40rem);
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
  }
  .onboard::backdrop {
    background: color-mix(in srgb, var(--ink) 42%, transparent);
  }
  .onboard-card {
    padding: 2rem 1.85rem 1.75rem;
    border: 1px solid color-mix(in srgb, var(--ink) 22%, var(--wash));
    background: color-mix(in srgb, var(--ink) 10%, var(--paper));
    color: var(--ink);
    box-sizing: border-box;
  }
  .onboard-step {
    margin: 0 0 0.85rem;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--emerald);
  }
  .onboard-title {
    margin: 0;
    font-size: clamp(1.55rem, 3vw, 2.1rem);
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1.15;
  }
  .onboard-body {
    margin: 0.85rem 0 0;
    font-size: 1.05rem;
    line-height: 1.45;
  }
  .onboard-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.65rem;
    margin-top: 1.6rem;
  }
  .ob-btn {
    font: inherit;
    font-size: 0.95rem;
    line-height: 1;
    padding: 0.7rem 1.15rem;
    border-radius: 0;
    cursor: pointer;
  }
  .ob-btn.solid {
    border: 0;
    background: var(--ink);
    color: var(--paper);
  }
  .ob-btn.ghost {
    border: 1px solid color-mix(in srgb, var(--ink) 30%, transparent);
    background: transparent;
    color: var(--ink);
  }
  .ob-btn.solid:hover {
    background: var(--emerald);
    color: var(--paper);
  }
  .ob-btn:focus-visible {
    outline: 2px solid var(--emerald);
    outline-offset: 3px;
  }
  @media (max-width: 760px) {
    .onboard {
      width: min(92vw, 40rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta:active {
      transform: none;
    }
    .seq-shaft,
    .seq-head {
      animation: none;
    }
    .seq-shaft {
      stroke-dasharray: none;
    }
  }
</style>
