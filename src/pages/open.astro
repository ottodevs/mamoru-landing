---
import Base from "../layouts/Base.astro";
import FlowStory from "../components/FlowStory.astro";
import { APP_HREF, OPEN_COPY as copy } from "../open-copy";

const emailHref = `mailto:${copy.footer.email}`;
---
<Base title={copy.title} description={copy.description} canonical="https://mamoru.lol/" themeColor="#F1EEE5">
  <a class="skip" href="#content">Skip to content</a>
  <header class="nav">
    <a class="brand" href="#top">
      <img src="/mark-two-stones.png" width="28" height="28" alt="" />
      <span>Mamoru</span>
    </a>
    <nav class="links" aria-label="On this page">
      {copy.nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <a class="cta nav-cta js-launch" href={APP_HREF}>{copy.cta}</a>
  </header>

  <main id="content">
    <section class="hero" id="top" aria-labelledby="hero-title">
      <img class="mark" src="/mark-two-stones.png" width="84" height="84" alt="The Split" />
      <h1 id="hero-title">
        <span>{copy.hero.line1}</span>
        <span>{copy.hero.line2}</span>
      </h1>
      <p class="lede">
        {copy.hero.lede.split(". ").filter(Boolean).map((part) => (
          <span>{part.endsWith(".") ? part : `${part}.`}</span>
        ))}
      </p>
      <a class="cta js-launch" href={APP_HREF} data-exp="hero_cta" data-exp-goal="open_app_click">{copy.cta}</a>
    </section>

    <FlowStory />

    <section class="band" id="spend" aria-labelledby="spend-title">
      <div class="wrap spend-row">
        <div class="spend-copy">
          <h2 id="spend-title">{copy.spend.heading}</h2>
          <p class="body">{copy.spend.body}</p>
          <a class="cta spend-cta js-launch" href={APP_HREF}>{copy.cta}</a>
        </div>
        <img
          class="spend-mark"
          src="/mark-two-stones.png"
          width="96"
          height="96"
          alt="Mamoru"
        />
      </div>
    </section>

    <section class="band" id="questions" aria-labelledby="questions-title">
      <div class="wrap">
        <h2 id="questions-title">{copy.questions.heading}</h2>
        <div class="qa-list">
          {copy.questions.items.map((item) => (
            <details class="qa">
              <summary>{item.q}</summary>
              {item.a.map((para) => (
                <p class="body">{para}</p>
              ))}
            </details>
          ))}
        </div>
        <div class="guides" id="guides" role="group" aria-labelledby="guides-title">
          <p class="guides-eyebrow" id="guides-title">{copy.guides.eyebrow}</p>
          <div class="guide-grid">
            {copy.guides.items.map((g) => (
              <figure class="guide">
                <div class="guide-frame">
                <video
                  playsinline
                  preload="none"
                  width="1280"
                  height="720"
                  poster={`/guides/${g.id}.webp`}
                  aria-label={g.title}
                >
                  <source src={`/guides/${g.id}.mp4`} type="video/mp4" />
                  <track kind="captions" srclang="en" label="English" src={`/guides/${g.id}.en.vtt`} />
                </video>
                <button class="guide-play" type="button" aria-label={`Play: ${g.title}`}>
                  <span class="guide-tri" aria-hidden="true"></span>
                  <span>Play</span>
                </button>
                </div>
                <figcaption>
                  <span class="guide-title">{g.title}</span>
                  <span class="guide-len">{g.length}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="foot-brand">
      <img src="/mark-two-stones.png" width="32" height="32" alt="" />
      <p class="name">{copy.footer.name}</p>
    </div>
    <p class="body">{copy.footer.line}</p>
    <div class="foot-links">
      <a class="mail" href={emailHref}>{copy.footer.email}</a>
      <a
        class="mail x-link"
        href={copy.footer.x.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${copy.footer.x.handle} on X`}
      >
        <svg class="x-logo" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
        </svg>
        <span>{copy.footer.x.handle}</span>
      </a>
      <img class="seal" src="/seal-mamoru.png" width="40" height="40" alt="" />
    </div>
  </footer>

  <dialog class="onboard" id="mamoru-onboard" aria-labelledby="onboard-title">
    <div class="onboard-card">
      {copy.onboard.screens.map((screen, index) => (
        <div class="onboard-screen" data-step={index} hidden={index !== 0}>
          <p class="onboard-step">{String(index + 1).padStart(2, "0")} / 03</p>
          <h2 class="onboard-title" id={index === 0 ? "onboard-title" : undefined}>
            {screen.title}
          </h2>
          {screen.body.map((para) => (
            <p class="onboard-body">{para}</p>
          ))}
          {screen.mix ? (
            <figure class="mix">
              <div class="mix-bar" aria-hidden="true">
                {copy.onboard.mix.map((seg) => (
                  <div class={`mix-seg ${seg.tone}`} style={`flex:${seg.pct}`}>
                    {seg.pct}%
                  </div>
                ))}
              </div>
              <ul class="mix-legend">
                {copy.onboard.mix.map((seg) => (
                  <li>
                    <span class={`mix-dot ${seg.tone}`}></span>
                    <span>
                      <span class="mix-name">{seg.name} {seg.pct}%</span>
                      {seg.note ? <span class="mix-note">{seg.note}</span> : null}
                    </span>
                  </li>
                ))}
              </ul>
            </figure>
          ) : null}
          <div class="onboard-actions">
            {index < copy.onboard.screens.length - 1 ? (
              <>
                <button type="button" class="ob-btn ghost js-onboard-skip">{copy.onboard.skip}</button>
                <button type="button" class="ob-btn solid js-onboard-next">{copy.onboard.next}</button>
              </>
            ) : (
              <button type="button" class="ob-btn solid js-onboard-finish">{copy.onboard.finish}</button>
            )}
          </div>
        </div>
      ))}
    </div>
  </dialog>
  <script is:inline define:vars={{ appHref: APP_HREF, storageKey: copy.onboard.storageKey }}>
    const KEY = storageKey;
    const APP = appHref;
    const root = document.getElementById("mamoru-onboard");
    const forceOnboard = (() => {
      try {
        return new URLSearchParams(location.search).has("onboard");
      } catch {
        return false;
      }
    })();
    try {
      if (forceOnboard) localStorage.removeItem(KEY);
    } catch {}
    function seen() {
      try { return localStorage.getItem(KEY) === "1"; } catch { return false; }
    }
    function mark() {
      try { localStorage.setItem(KEY, "1"); } catch {}
    }
    function goApp() {
      mark();
      window.location.href = APP;
    }
    function show(step) {
      if (!root) return;
      root.querySelectorAll(".onboard-screen").forEach((el) => {
        const n = Number(el.getAttribute("data-step"));
        el.hidden = n !== step;
      });
      root.dataset.step = String(step);
      if (typeof root.showModal === "function" && !root.open) root.showModal();
    }
    document.querySelectorAll(".js-launch").forEach((link) => {
      link.addEventListener("click", (event) => {
        if (seen()) return;
        event.preventDefault();
        show(0);
      });
    });
    root?.querySelectorAll(".js-onboard-skip, .js-onboard-finish").forEach((btn) => {
      btn.addEventListener("click", goApp);
    });
    root?.querySelectorAll(".js-onboard-next").forEach((btn) => {
      btn.addEventListener("click", () => {
        const step = Number(root.dataset.step || "0") + 1;
        show(step);
      });
    });
    root?.addEventListener("cancel", (event) => {
      event.preventDefault();
      goApp();
    });
    if (forceOnboard) show(0);
  </script>
  <script is:inline>
    // Guides: the poster shows a paper Play button; the native controls appear only once a film starts.
    document.querySelectorAll(".guide-frame").forEach((frame) => {
      const video = frame.querySelector("video");
      const play = frame.querySelector(".guide-play");
      if (!video || !play) return;
      play.addEventListener("click", () => {
        frame.classList.add("playing");
        video.controls = true;
        video.play().catch(() => {});
      });
    });
  </script>
</Base>

<style>
  :global(html > body) {
    overflow-y: visible;
  }
  /* The eyebrows are set in Plex Mono, as on the slides. Only this page loads it. */
  @font-face {
    font-family: "IBM Plex Mono";
    src: url("/fonts/plex-mono-400.woff2") format("woff2");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  /* The tile's mean colour, as in the app: what shows where the image does not reach (overscroll, the strip
     under the last section), so no rice paper peeks through. */
  :global(:root) {
    --kami: #f1eee5;
  }
  /* Kami A, the dashboard's screen paper (otto/mamoru#198), on the whole landing. */
  :global(html),
  :global(html > body) {
    background-color: var(--kami);
    background-image: url("/kami-a-tile.png");
    background-image: image-set(
      url("/kami-a-tile.webp") type("image/webp"),
      url("/kami-a-tile.png") type("image/png")
    );
    background-repeat: repeat;
    background-size: 1024px 1024px;
  }

  .skip {
    position: absolute;
    left: 0.75rem;
    top: -4rem;
    z-index: 5;
    background: var(--ink);
    color: var(--paper);
    padding: 0.4rem 0.7rem;
    text-decoration: none;
  }
  .skip:focus {
    top: 0.75rem;
  }

  .nav {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    width: 100%;
    min-height: 4rem;
    max-height: 4.5rem;
    padding: 0.55rem clamp(1rem, 4vw, 2rem);
    background-color: var(--kami);
    background-image: url("/kami-a-tile.png");
    background-image: image-set(
      url("/kami-a-tile.webp") type("image/webp"),
      url("/kami-a-tile.png") type("image/png")
    );
    background-repeat: repeat;
    background-size: 1024px 1024px;
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 8%, transparent);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--ink);
    font-size: 1.05rem;
    line-height: 1;
  }
  .brand img {
    width: 1.75rem;
    height: auto;
    display: block;
  }

  .links {
    display: flex;
    align-items: center;
    gap: 1.15rem;
    min-width: 0;
  }
  .links a {
    color: var(--ink);
    text-decoration: none;
    font-size: 1rem;
    line-height: 1;
    white-space: nowrap;
  }
  .links a:hover,
  .links a:focus-visible {
    color: var(--emerald);
  }

  .nav-cta {
    margin-left: auto;
    padding: 0.5rem 0.85rem;
    font-size: 0.95rem;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.7rem 1.15rem;
    border: 0;
    border-radius: 0;
    background: var(--ink);
    color: var(--paper);
    text-decoration: none;
    font-size: 0.95rem;
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
  }
  .cta:hover {
    background: var(--emerald);
    color: var(--paper);
  }
  .cta:focus-visible,
  .brand:focus-visible,
  .mail:focus-visible,
  summary:focus-visible {
    outline: 2px solid var(--emerald);
    outline-offset: 3px;
  }
  .cta:active {
    transform: translateY(1px);
  }

  .hero {
    min-height: calc(100dvh - 4.5rem);
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem clamp(1rem, 5vw, 2.5rem) 3rem;
    box-sizing: border-box;
  }
  .mark {
    width: clamp(4.15rem, 6.25vw, 5.35rem);
    height: auto;
    display: block;
  }
  h1 {
    margin: clamp(0.78rem, 2.6vh, 1.22rem) 0 0;
    font-size: clamp(2.4rem, 8vw, 5.2rem);
    font-weight: 400;
    letter-spacing: 0.04em;
    line-height: 0.95;
  }
  h1 span {
    display: block;
  }
  .lede {
    margin: clamp(1.1rem, 3vh, 1.8rem) 0 0;
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    line-height: 1.35;
  }
  .lede span {
    display: block;
  }
  .hero .cta {
    margin-top: clamp(1.3rem, 3vh, 2rem);
  }

  .band,
  .hero {
    scroll-margin-top: 4.5rem;
  }
  .band {
    width: 100%;
    padding: clamp(4rem, 9vw, 6.5rem) clamp(1.15rem, 5vw, 4.5rem);
    box-sizing: border-box;
  }
  .wrap {
    max-width: 68rem;
    margin-inline: auto;
  }
  h2 {
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 2.7rem);
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1.15;
  }
  .name {
    margin: 0;
    font-size: clamp(1.25rem, 2vw, 1.55rem);
    line-height: 1.25;
  }
  .body {
    margin: 0.55rem 0 0;
    font-size: 1.125rem;
    line-height: 1.45;
    max-width: 36rem;
  }
  .spend {
    scroll-margin-top: var(--nav-h, 4.5rem);
  }
  .spend-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }
  .spend .body {
    margin-top: 1rem;
  }
  .spend-cta {
    margin-top: 1.6rem;
  }
  .spend-mark {
    width: clamp(4.5rem, 10vw, 7rem);
    height: auto;
    display: block;
  }

  .qa-list {
    margin-top: clamp(1.4rem, 3vw, 2rem);
  }
  .qa {
    border-top: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
    padding: 0.95rem 0;
  }
  .qa:last-child {
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
  }
  summary {
    cursor: pointer;
    font-size: clamp(1.15rem, 2vw, 1.35rem);
    line-height: 1.3;
  }
  .qa .body {
    margin-top: 0.7rem;
    padding-bottom: 0.35rem;
  }

  .guides {
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }
  .guides-eyebrow {
    margin: 0;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.8rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--emerald);
  }
  .guide-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin-top: 1rem;
  }
  .guide {
    margin: 0;
  }
  .guide-frame {
    position: relative;
  }
  .guide-play {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 1.15rem;
    border: 0;
    border-radius: 0;
    background: var(--ink);
    color: var(--paper);
    font: inherit;
    font-size: 0.95rem;
    line-height: 1;
    cursor: pointer;
  }
  .guide-play:hover {
    background: var(--emerald);
  }
  .guide-play:focus-visible {
    outline: 2px solid var(--emerald);
    outline-offset: 3px;
  }
  .guide-tri {
    width: 0;
    height: 0;
    border-left: 0.6rem solid currentColor;
    border-top: 0.38rem solid transparent;
    border-bottom: 0.38rem solid transparent;
  }
  .guide-frame.playing .guide-play {
    display: none;
  }
  .guide video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    background: var(--wash);
    border: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
  }
  .guide figcaption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-top: 0.7rem;
  }
  .guide-title {
    font-size: 1.05rem;
    line-height: 1.3;
  }
  .guide-len {
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.8rem;
    color: var(--stone);
  }
  @media (max-width: 760px) {
    .guide-grid {
      grid-template-columns: 1fr;
    }
  }

  .mail {
    color: var(--emerald);
    text-underline-offset: 0.16em;
  }
  .mail:hover {
    color: var(--ink);
  }

  .foot {
    width: 100%;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    flex-wrap: wrap;
    padding: 1.5rem clamp(1.15rem, 5vw, 4.5rem) 2rem;
    border-top: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
  }
  .foot-brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  .foot-brand img {
    width: 2rem;
    height: auto;
    display: block;
  }
  .foot .body {
    margin: 0;
  }
  .foot-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
  .x-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  /* The seal signs the end of the page, as on the dashboard. */
  .seal {
    width: 2.5rem;
    height: auto;
    display: block;
  }
  .x-logo {
    width: 0.95rem;
    height: 0.95rem;
    fill: currentColor;
    flex: none;
  }

  @media (max-width: 760px) {
    .nav {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        "brand cta"
        "links links";
      max-height: none;
      row-gap: 0.65rem;
      align-items: center;
      padding-top: 0.75rem;
      padding-bottom: 0.75rem;
    }
    .brand {
      grid-area: brand;
    }
    .nav-cta {
      grid-area: cta;
      margin-left: 0;
      justify-self: end;
    }
    .links {
      grid-area: links;
      width: auto;
      gap: 0.85rem;
      flex-wrap: wrap;
    }
    .spend-row {
      grid-template-columns: 1fr;
      justify-items: start;
    }
    .foot {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  .onboard {
    width: min(60vw, 48rem);
    max-width: 92vw;
    max-height: min(90dvh, 44rem);
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
  }
  .onboard::backdrop {
    background: color-mix(in srgb, var(--ink) 42%, transparent);
  }
  .onboard-card {
    padding: 2rem 1.85rem 1.75rem;
    border: 1px solid color-mix(in srgb, var(--ink) 22%, var(--wash));
    background: color-mix(in srgb, var(--ink) 14%, var(--paper));
    color: var(--ink);
    box-sizing: border-box;
  }
  .onboard-step {
    margin: 0 0 0.85rem;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--emerald);
  }
  .onboard-title {
    margin: 0;
    font-size: clamp(1.55rem, 3vw, 2.1rem);
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1.15;
  }
  .onboard-body {
    margin: 0.85rem 0 0;
    font-size: 1.05rem;
    line-height: 1.45;
  }
  .mix {
    --mix-ink: #0f0f0e;
    --mix-navy: #0e1b2e;
    --mix-emerald: #2f5d50;
    --mix-stone: #8a8578;
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 1.25rem 1.5rem;
    align-items: center;
    margin: 1.25rem 0 0;
  }
  .mix-bar {
    display: flex;
    flex-direction: column;
    height: 12.5rem;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
  }
  .mix-seg {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--paper);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
  }
  .mix-seg.mercenary { background: var(--mix-stone); color: var(--mix-ink); }
  .mix-seg.paired { background: var(--mix-navy); }
  .mix-seg.stables { background: var(--mix-emerald); }
  .mix-legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.95rem;
  }
  .mix-legend li {
    display: grid;
    grid-template-columns: 0.7rem 1fr;
    gap: 0.65rem;
    align-items: start;
  }
  .mix-dot {
    width: 0.7rem;
    height: 0.7rem;
    margin-top: 0.28rem;
    display: block;
  }
  .mix-dot.mercenary { background: var(--mix-stone); }
  .mix-dot.paired { background: var(--mix-navy); }
  .mix-dot.stables { background: var(--mix-emerald); }
  .mix-name {
    display: block;
    font-size: 1rem;
    line-height: 1.25;
  }
  .mix-note {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.85rem;
    line-height: 1.35;
    color: var(--mix-stone);
  }
  .onboard-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.65rem;
    margin-top: 1.6rem;
  }
  .ob-btn {
