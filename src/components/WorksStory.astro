---
import { OPEN_COPY } from "../open-copy";

const { heading, moves, scene } = OPEN_COPY.works;
const num = (index: number) => String(index + 1).padStart(2, "0");
const vessels = [
  { tone: "stables", x: 150, h: 56 },
  { tone: "paired", x: 202, h: 40 },
  { tone: "mercenary", x: 254, h: 20 },
];
---
<div class="story">
  <section class="track" id="works" aria-labelledby="works-title">
    <div class="stage" data-step="0">
      <h2 id="works-title">{heading}</h2>

      <div class="rail">
        {moves.map((move, index) => (
          <button type="button" class="rail-item" data-go={index}>
            <span class="rail-num">{num(index)}</span>
            <span>{move.title}</span>
          </button>
        ))}
        <span class="rail-track" aria-hidden="true"><span class="rail-fill"></span></span>
      </div>

      <svg class="scene" viewBox="0 0 440 404" aria-hidden="true">
        <path class="edge e-connect" pathLength="100" d="M168 80 H272" />
        <path class="edge e-fund" pathLength="100" d="M344 124 C344 196 300 214 292 262" />
        <path class="edge e-yield" pathLength="100" d="M148 262 C144 238 131 221.5 119 202" />
        <path class="edge e-usdc" pathLength="100" d="M119 202 C107 182.5 96 160 96 124" />

        <path id="route-connect" class="route" d="M168 80 H272" />
        <path id="route-fund" class="route" d="M344 124 C344 196 300 214 292 262" />
        <path id="route-yield" class="route" d="M148 262 C144 238 131 221.5 119 202" />
        <path id="route-usdc" class="route" d="M119 202 C107 182.5 96 160 96 124" />

        <g class="dots d-eth">
          {["0s", "-0.6s", "-1.2s"].map((begin) => (
            <circle r="3.5">
              <animateMotion dur="1.8s" begin={begin} repeatCount="indefinite">
                <mpath href="#route-connect" />
              </animateMotion>
            </circle>
          ))}
          {["-0.3s", "-0.9s", "-1.5s"].map((begin) => (
            <circle r="3.5">
              <animateMotion dur="1.8s" begin={begin} repeatCount="indefinite">
                <mpath href="#route-fund" />
              </animateMotion>
            </circle>
          ))}
        </g>
        <g class="dots d-yield">
          {["0s", "-0.7s"].map((begin) => (
            <circle r="3">
              <animateMotion dur="1.4s" begin={begin} repeatCount="indefinite">
                <mpath href="#route-yield" />
              </animateMotion>
            </circle>
          ))}
        </g>
        <g class="dots d-usdc">
          {["0s", "-0.7s"].map((begin) => (
            <circle r="3.5">
              <animateMotion dur="1.4s" begin={begin} repeatCount="indefinite">
                <mpath href="#route-usdc" />
              </animateMotion>
            </circle>
          ))}
        </g>

        <g class="node n-wallet">
          <rect class="box" x="24" y="36" width="144" height="88" />
          <rect class="glyph" x="74" y="66" width="44" height="30" />
          <path class="glyph" d="M74 75 H118" />
          <circle class="glyph-dot" cx="109" cy="86" r="2.4" />
          <text x="96" y="24">{scene.wallet}</text>
        </g>

        <g class="node n-agent">
          <rect class="box" x="272" y="36" width="144" height="88" />
          <image href="/mark-two-stones.png" x="326" y="62" width="36" height="36" />
          <text x="344" y="24">{scene.agent}</text>
        </g>

        <g class="node n-pools">
          <rect class="box" x="120" y="262" width="200" height="112" />
          {vessels.map((v) => (
            <>
              <rect class="vessel" x={v.x} y="292" width="36" height="64" />
              <rect
                class={`fill ${v.tone}`}
                x={v.x + 1}
                y={355 - v.h}
                width="34"
                height={v.h}
              />
            </>
          ))}
          <text x="220" y="398">{scene.pools}</text>
        </g>

        <text class="tag t-eth" x="220" y="68">{scene.eth}</text>
        <g class="chip">
          <rect x="89" y="190" width="60" height="24" />
          <text x="119" y="207">{scene.usdc}</text>
        </g>
      </svg>

      <ol class="steps">
        {moves.map((move, index) => (
          <li class="step-card">
            <p class="step-num">{num(index)} / 03</p>
            <h3 class="step-title">{move.title}</h3>
            <p class="step-body">{move.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <div class="aside">
    <div class="aside-pin">
      <slot />
    </div>
  </div>
</div>

<script>
  const track = document.getElementById("works");
  const stage = track?.querySelector<HTMLElement>(".stage");
  const scene = track?.querySelector<SVGSVGElement>(".scene");
  const nav = document.querySelector<HTMLElement>(".nav");
  const STEPS = 3;
  const DRAW = 0.55;

  const clamp01 = (n: number) => Math.min(1, Math.max(0, n));

  if (track && stage) {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      scene?.pauseAnimations();
    }

    const span = () => Math.max(1, track.offsetHeight - stage.offsetHeight);
    const navHeight = () => nav?.offsetHeight ?? 0;

    let queued = false;
    const update = () => {
      queued = false;
      const top = navHeight();
      document.documentElement.style.setProperty("--nav-h", `${top}px`);
      const p = clamp01((top - track.getBoundingClientRect().top) / span());
      const q = p * STEPS;
      for (let i = 0; i < STEPS; i++) {
        stage.style.setProperty(`--s${i}`, clamp01((q - i) / DRAW).toFixed(3));
      }
      stage.style.setProperty("--p", p.toFixed(4));
      const step = String(Math.min(STEPS - 1, Math.floor(q)));
      if (stage.dataset.step !== step) stage.dataset.step = step;
    };
    const queue = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };

    stage.querySelectorAll<HTMLButtonElement>(".rail-item").forEach((button) => {
      button.addEventListener("click", () => {
        const index = Number(button.dataset.go);
        const trackTop = track.getBoundingClientRect().top + window.scrollY - navHeight();
        const at = (index + DRAW + 0.05) / STEPS;
        window.scrollTo({ top: trackTop + span() * Math.min(at, 0.999) });
      });
    });

    window.addEventListener("scroll", queue, { passive: true });
    window.addEventListener("resize", queue);
    update();
  }
</script>

<style>
  .story {
    --tone-stables: #a7a9ac;
    --tone-paired: #0e1b2e;
    --tone-mercenary: #6fa78f;
    --pin-h: calc(100dvh - var(--nav-h, 4.5rem));
    display: grid;
    grid-template-columns: 1fr 1fr;
    width: 100%;
    border-bottom: 1px solid var(--wash);
  }

  .track {
    height: calc(var(--pin-h) * 3.2);
    scroll-margin-top: var(--nav-h, 4.5rem);
  }

  .stage {
    --s0: 1;
    --s1: 1;
    --s2: 1;
    position: sticky;
    top: var(--nav-h, 4.5rem);
    height: var(--pin-h);
    display: flex;
    flex-direction: column;
    gap: clamp(0.9rem, 2.2vh, 1.5rem);
    padding: clamp(1.5rem, 4.5vh, 3rem) clamp(1.15rem, 4vw, 3.5rem);
    border-right: 1px solid var(--wash);
    background: color-mix(in srgb, var(--paper) 55%, transparent);
    box-sizing: border-box;
    overflow: hidden;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 2.7rem);
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1.15;
  }

  .rail {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    row-gap: 0.6rem;
  }
  .rail-item {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    padding: 0.2rem 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 1rem;
    text-align: left;
    color: var(--stone);
    cursor: pointer;
    transition: color 0.3s ease;
  }
  .rail-item:hover {
    color: var(--ink);
  }
  .rail-item:focus-visible {
    outline: 2px solid var(--emerald);
    outline-offset: 3px;
  }
  .rail-num {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--emerald);
  }
  .stage[data-step="0"] .rail-item:nth-child(1),
  .stage[data-step="1"] .rail-item:nth-child(-n + 2),
  .stage[data-step="2"] .rail-item {
    color: var(--ink);
  }
  .rail-track {
    grid-column: 1 / -1;
    display: block;
    height: 1px;
    background: var(--wash);
  }
  .rail-fill {
    display: block;
    height: 100%;
    background: var(--emerald);
    transform-origin: left;
    transform: scaleX(var(--p, 1));
  }

  .scene {
    flex: 1 1 0;
    min-height: 9rem;
    width: 100%;
    overflow: visible;
  }
  .route {
    fill: none;
    stroke: none;
  }
  .edge {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-dasharray: 100px 100px;
  }
  .e-connect {
    stroke-dashoffset: calc((1 - var(--s0)) * 100px);
  }
  .e-fund {
    stroke-dashoffset: calc((1 - var(--s1)) * 100px);
  }
  .e-yield,
  .e-usdc {
    stroke: var(--emerald);
  }
  .e-yield {
    stroke-dashoffset: calc((1 - min(1, var(--s2) * 2)) * 100px);
  }
  .e-usdc {
    stroke-dashoffset: calc((1 - clamp(0, var(--s2) * 2 - 1, 1)) * 100px);
  }

  .dots circle {
    fill: var(--ink);
  }
  .d-yield circle {
    fill: var(--tone-mercenary);
  }
  .d-usdc circle {
    fill: var(--emerald);
  }
  .d-eth,
  .t-eth {
    opacity: clamp(0, calc(var(--s1) * 3 - 0.5), 1);
  }
  .d-yield {
    opacity: clamp(0, calc(var(--s2) * 3 - 1), 1);
  }
  .d-usdc,
  .chip {
    opacity: clamp(0, calc(var(--s2) * 3 - 1.5), 1);
  }

  .box {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 1.2;
  }
  .glyph {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.4;
  }
  .glyph-dot {
    fill: var(--ink);
  }
  .n-wallet .box {
    stroke: color-mix(in srgb, var(--emerald) calc(var(--s2) * 100%), var(--ink));
    stroke-width: calc(1.2px + var(--s2) * 0.6px);
  }
  .n-agent {
    opacity: calc(0.2 + 0.8 * clamp(0, calc(var(--s0) * 2 - 0.8), 1));
  }
  .n-pools {
    opacity: calc(0.2 + 0.8 * clamp(0, calc(var(--s1) * 2 - 0.6), 1));
  }
  .vessel {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1;
  }
  .fill {
    transform-box: fill-box;
    transform-origin: bottom;
    transform: scaleY(var(--s1));
  }
  .fill.stables {
    fill: var(--tone-stables);
  }
  .fill.paired {
    fill: var(--tone-paired);
  }
  .fill.mercenary {
    fill: var(--tone-mercenary);
  }

  .scene text {
    font-family: var(--font-serif);
    font-size: 15px;
    fill: var(--ink);
    text-anchor: middle;
  }
  .scene .tag {
    font-size: 12px;
    letter-spacing: 0.14em;
  }
  .chip rect {
    fill: var(--paper);
    stroke: var(--emerald);
    stroke-width: 1.2;
  }
  .scene .chip text {
    font-size: 12px;
    letter-spacing: 0.14em;
    fill: var(--emerald);
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .step-card {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1.35rem 1.5rem 1.5rem;
    border: 1px solid var(--wash);
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    opacity: 0;
    transform: translateY(0.6rem);
    transition:
      opacity 0.35s ease,
      transform 0.35s ease;
  }
  .stage[data-step="0"] .step-card:nth-child(1),
  .stage[data-step="1"] .step-card:nth-child(2),
  .stage[data-step="2"] .step-card:nth-child(3) {
    opacity: 1;
    transform: none;
  }
  .step-num {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--emerald);
  }
  .step-title {
    margin: 0;
    font-size: clamp(1.25rem, 2vw, 1.55rem);
    font-weight: 400;
    line-height: 1.25;
  }
  .step-body {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.45;
  }

  .aside-pin {
    position: sticky;
    top: var(--nav-h, 4.5rem);
    min-height: var(--pin-h);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2rem, 6vh, 4rem) clamp(1.15rem, 5vw, 4.5rem);
    box-sizing: border-box;
  }

  @media (max-width: 760px) {
    .story {
      grid-template-columns: 1fr;
    }
    .stage {
      border-right: 0;
      border-bottom: 1px solid var(--wash);
    }
    .rail-item {
      font-size: 0.9rem;
    }
    .step-card {
      padding: 1.1rem 1.15rem 1.25rem;
    }
    .step-body {
      font-size: 1rem;
    }
    .aside-pin {
      position: static;
      min-height: 0;
      padding: clamp(3.5rem, 12vw, 5rem) clamp(1.15rem, 5vw, 4.5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rail-item,
    .step-card {
      transition: none;
    }
    .step-card {
      transform: none;
    }
    .dots {
      display: none;
    }
  }
</style>
