---
import { OPEN_COPY } from "../open-copy";

const { heading, moves, scene } = OPEN_COPY.works;

// Stone silhouettes in local coords, about 100 units across.
const MARK = [
  "M-34 -34 C-24 -52 8 -54 26 -42 C42 -31 40 -6 30 16 C19 40 -2 50 -21 45 C-41 40 -48 17 -46 -4 C-45 -17 -41 -26 -34 -34 Z",
  "M37 -3 C52 3 58 22 51 37 C46 48 34 52 21 51 Z",
];
// Three pools: graded sizes.
const SLEEVES = [
  "M-52 -4 C-50 -24 -26 -32 -4 -30 C18 -28 30 -14 28 4 C26 22 6 30 -18 29 C-40 28 -54 14 -52 -4 Z",
  "M30 8 C32 -6 46 -12 58 -8 C68 -4 72 8 68 18 C64 28 50 30 40 27 C31 24 28 16 30 8 Z",
  "M42 -30 C45 -38 54 -40 60 -35 C65 -31 64 -23 58 -20 C51 -17 44 -20 42 -26 Z",
];

type Pt = { x: number; y: number };
type Cue = Pt | null;
type Layout = {
  id: "w" | "t";
  w: number;
  h: number;
  mark: Pt;
  sleeves: Pt;
  pond: Pt & { rx: number; ry: number };
  rakes: string[];
  drop: string;
  toSleeves: string[];
  toPond: string[];
  collect: string;
  cue: { fees: Cue; collect: Cue };
};

// Three moments, left to right: the money goes in, it works, the earnings are set aside.
const wide: Layout = {
  id: "w",
  w: 1200,
  h: 340,
  mark: { x: 210, y: 170 },
  sleeves: { x: 600, y: 170 },
  pond: { x: 990, y: 170, rx: 86, ry: 46 },
  rakes: Array.from({ length: 10 }, (_, i) => {
    const y = 86 + i * 20;
    return `M0 ${y} C300 ${y - 3} 600 ${y + 3} 900 ${y} S1200 ${y - 2} 1200 ${y}`;
  }),
  drop: "M210 14 L210 122",
  toSleeves: [
    "M265 172 C360 200 470 200 547 180",
    "M265 166 C380 138 520 132 629 162",
    "M265 160 C390 116 560 100 657 132",
  ],
  toPond: [
    "M605 192 C720 222 850 222 932 186",
    "M669 182 C760 176 860 166 928 170",
    "M663 132 C770 122 880 132 934 158",
  ],
  collect: "M1000 150 C1024 110 1060 72 1120 44",
  cue: { fees: { x: 990, y: 100 }, collect: { x: 1040, y: 28 } },
};

// Narrow screens: the same garden, top to bottom, text beside it.
const tall: Layout = {
  id: "t",
  w: 160,
  h: 660,
  mark: { x: 80, y: 110 },
  sleeves: { x: 74, y: 330 },
  pond: { x: 80, y: 550, rx: 60, ry: 36 },
  rakes: Array.from({ length: 7 }, (_, i) => {
    const x = 22 + i * 20;
    return `M${x} 0 C${x - 3} 165 ${x + 3} 330 ${x} 495 S${x - 2} 660 ${x} 660`;
  }),
  drop: "M80 6 L80 62",
  toSleeves: [
    "M80 158 C90 220 76 260 64 298",
    "M84 158 C110 210 126 260 124 310",
    "M88 156 C120 200 136 250 130 280",
  ],
  toPond: [
    "M62 368 C60 430 70 480 76 520",
    "M122 370 C124 440 104 490 90 522",
    "M138 310 C156 390 130 480 100 524",
  ],
  collect: "M92 566 C108 592 124 618 144 644",
  cue: { fees: { x: 80, y: 470 }, collect: { x: 76, y: 632 } },
};

const layouts = [wide, tall];
const cueText = { fees: scene.fees, collect: scene.collect };
const where = [scene.agent, scene.strategy, scene.payout];
const holes = (l: Layout) => [
  { ...l.mark, rx: 96, ry: 74 },
  { ...l.sleeves, rx: 118, ry: 76 },
  { x: l.pond.x, y: l.pond.y, rx: l.pond.rx + 26, ry: l.pond.ry + 26 },
];
---
<section class="works" id="works" aria-labelledby="works-title">
  <h2 id="works-title">{heading}</h2>

  <div class="garden">
    {layouts.map((l) => (
      <svg class={`scene scene-${l.id}`} viewBox={`0 0 ${l.w} ${l.h}`} role="img" aria-label={scene.aria}>
        <defs>
          <mask id={`clear-${l.id}`}>
            <rect width={l.w} height={l.h} fill="#fff" />
            {holes(l).map((h) => <ellipse cx={h.x} cy={h.y} rx={h.rx} ry={h.ry} fill="#000" />)}
          </mask>
          <radialGradient id={`sheen-${l.id}`} cx="35%" cy="30%" r="80%">
            <stop offset="0" stop-color="#3a3935" />
            <stop offset="0.55" stop-color="#171715" />
            <stop offset="1" stop-color="#0b0b0a" />
          </radialGradient>
          <radialGradient id={`water-${l.id}`} cx="50%" cy="45%" r="60%">
            <stop offset="0" stop-color="#2f5d50" stop-opacity="0.2" />
            <stop offset="1" stop-color="#2f5d50" stop-opacity="0.06" />
          </radialGradient>
        </defs>

        <g class="rakes" mask={`url(#clear-${l.id})`}>
          {l.rakes.map((d, i) => <path class="rake" d={d} pathLength="1" style={`--i:${i}`} />)}
        </g>

        {holes(l).map((h, i) => (
          <g class="rings" style={`--i:${i}`}>
            {[0, 1].map((r) => (
              <ellipse class="ring" cx={h.x} cy={h.y} rx={h.rx - 26 + r * 14} ry={h.ry - 22 + r * 11} pathLength="1" style={`--r:${r}`} />
            ))}
          </g>
        ))}

        <path class="return" d={l.collect} pathLength="1" />

        <g class="feature f-0" style="--i:0">
          <ellipse class="shadow" cx={l.mark.x + 4} cy={l.mark.y + 44} rx="46" ry="7" />
          <g class="stone" transform={`translate(${l.mark.x} ${l.mark.y})`}>
            {MARK.map((d) => <path d={d} fill={`url(#sheen-${l.id})`} />)}
          </g>
          <circle class="pulse" cx={l.mark.x} cy={l.mark.y} r="58" />
        </g>

        <g class="feature f-1" style="--i:1">
          <ellipse class="shadow" cx={l.sleeves.x + 4} cy={l.sleeves.y + 32} rx="56" ry="7" />
          <g class="stone sleeves" transform={`translate(${l.sleeves.x} ${l.sleeves.y})`}>
            {SLEEVES.map((d, k) => <path class={`sleeve s-${k}`} d={d} fill={`url(#sheen-${l.id})`} />)}
          </g>
          <circle class="pulse" cx={l.sleeves.x} cy={l.sleeves.y} r="62" />
        </g>

        <g class="feature f-2" style="--i:2">
          <ellipse class="pond" cx={l.pond.x} cy={l.pond.y} rx={l.pond.rx} ry={l.pond.ry} fill={`url(#water-${l.id})`} />
          {[0.55, 0.3].map((f) => (
            <ellipse class="ripple-still" cx={l.pond.x} cy={l.pond.y} rx={l.pond.rx * f} ry={l.pond.ry * f} />
          ))}
          <ellipse class="splash" cx={l.pond.x} cy={l.pond.y} rx={l.pond.rx * 0.4} ry={l.pond.ry * 0.4} />
          <text class="pond-tag" x={l.pond.x} y={l.pond.y + 4}>{scene.pond}</text>
        </g>

        {(Object.keys(cueText) as (keyof typeof cueText)[]).map((k) => {
          const at = l.cue[k];
          return at ? <text class={`cue cue-${k}`} x={at.x} y={at.y}>{cueText[k]}</text> : null;
        })}

        <path class="lane" d={l.drop} />
        {l.toSleeves.map((d) => <path class="lane" d={d} />)}
        {l.toPond.map((d) => <path class="lane" d={d} />)}

        <g class="token coin" opacity="0"><circle r="8.5" /></g>
        {[0, 1, 2].map(() => (
          <g class="token coin-part" opacity="0"><circle r="5" /></g>
        ))}
        {[0, 1, 2].map(() => (
          <g class="token fee" opacity="0"><circle r="4.2" /></g>
        ))}
        <g class="token payout" opacity="0">
          <circle r="8.5" />
          <text y="3.4">$</text>
        </g>
      </svg>
    ))}

    <ol class="steps">
      {moves.map((move, i) => (
        <li class="step" style={`--i:${i}`}>
          <p class="kicker">
            <span class="num">{String(i + 1).padStart(2, "0")}</span>
            <span class="where">{where[i]}</span>
          </p>
          <h3>{move.title}</h3>
          <p class="body">{move.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>("#works");
  const quiet = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const sleep = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));
  const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2);
  const out = { duration: 700, easing: "cubic-bezier(.2,.8,.2,1)", fill: "forwards" as const };

  // The scene actually displayed at this viewport width.
  const liveScene = () =>
    [...(root?.querySelectorAll<SVGSVGElement>(".scene") ?? [])].find(
      (s) => getComputedStyle(s).display !== "none",
    );

  function travel(el: SVGGElement, path: SVGPathElement, ms: number, back = false) {
    return new Promise<void>((resolve) => {
      const len = path.getTotalLength();
      const t0 = performance.now();
      const tick = (now: number) => {
        const raw = Math.min(1, (now - t0) / ms);
        const at = ease(raw);
        const p = path.getPointAtLength(len * (back ? 1 - at : at));
        const fade = raw < 0.12 ? raw / 0.12 : raw > 0.88 ? (1 - raw) / 0.12 : 1;
        el.setAttribute("transform", `translate(${p.x} ${p.y})`);
        el.setAttribute("opacity", String(fade));
        if (raw < 1) requestAnimationFrame(tick);
        else resolve();
      };
      requestAnimationFrame(tick);
    });
  }

  function pulse(svg: SVGSVGElement, i: number) {
    svg.querySelector(`.f-${i} .pulse`)?.animate(
      [
        { opacity: 0.5, transform: "scale(0.72)" },
        { opacity: 0, transform: "scale(1.4)" },
      ],
      { duration: 1400, easing: "cubic-bezier(.2,.7,.2,1)" },
    );
  }

  async function cue(svg: SVGSVGElement, name: string, ms = 1800) {
    const el = svg.querySelector(`.cue-${name}`);
    if (!el) return;
    el.animate(
      [
        { opacity: 0, transform: "translateY(4px)" },
        { opacity: 1, transform: "none", offset: 0.15 },
        { opacity: 1, transform: "none", offset: 0.8 },
        { opacity: 0, transform: "translateY(-3px)" },
      ],
      { duration: ms, easing: "ease-out" },
    );
  }

  function splash(svg: SVGSVGElement) {
    svg.querySelector(".splash")?.animate(
      [
        { opacity: 0.7, transform: "scale(0.5)" },
        { opacity: 0, transform: "scale(2.1)" },
      ],
      { duration: 1300, easing: "cubic-bezier(.2,.7,.2,1)" },
    );
  }

  async function cycle(svg: SVGSVGElement) {
    const lanes = [...svg.querySelectorAll<SVGPathElement>(".lane")];
    const [drop, ...rest] = lanes;
    const toSleeves = rest.slice(0, 3);
    const toPond = rest.slice(3, 6);
    const coin = svg.querySelector<SVGGElement>(".coin");
    const parts = [...svg.querySelectorAll<SVGGElement>(".coin-part")];
    const fees = [...svg.querySelectorAll<SVGGElement>(".fee")];
    const payout = svg.querySelector<SVGGElement>(".payout");
    const sleeves = [...svg.querySelectorAll<SVGPathElement>(".sleeve")];
    const collect = svg.querySelector<SVGPathElement>(".return");
    if (!drop || !coin || !payout || !collect) return;

    // 1. Your money goes in: it lands in your account and stays there.
    await travel(coin, drop, 1700);
    pulse(svg, 0);
    await sleep(900);

    // 2. It goes to work: spread across three pools.
    await Promise.all(parts.map((p, k) => sleep(k * 140).then(() => travel(p, toSleeves[k]!, 2000))));
    pulse(svg, 1);
    await sleep(900);

    // 3. The earnings are set aside: they gather as stablecoins, twice over.
    cue(svg, "fees", 4600);
    for (let round = 0; round < 2; round++) {
      sleeves.forEach((sl, k) =>
        sl.animate([{ transform: "scale(1)" }, { transform: "scale(1.05)" }, { transform: "scale(1)" }], {
          duration: 900,
          delay: 120 * k,
          easing: "ease-in-out",
        }),
      );
      await Promise.all(fees.map((f, k) => sleep(k * 200).then(() => travel(f, toPond[k]!, 1800))));
      splash(svg);
      await sleep(500);
    }

    // And you collect them whenever you want.
    cue(svg, "collect", 3400);
    await travel(payout, collect, 2400);
    await sleep(2600);
  }

  async function loop() {
    for (;;) {
      const svg = liveScene();
      if (svg) await cycle(svg);
      else await sleep(1000);
    }
  }

  if (root) {
    if (quiet) root.classList.add("live", "still");
    else {
      const io = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          io.disconnect();
          root.classList.add("live");
          sleep(2000).then(loop);
        },
        { threshold: 0.3 },
      );
      io.observe(root);
    }
  }
</script>

<style>
  .works {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    width: 100%;
    min-width: 0;
  }
  h2 {
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 2.7rem);
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1.15;
  }
  .garden {
    display: grid;
    gap: clamp(0.25rem, 1vw, 0.75rem);
  }
  .scene {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .scene-t {
    display: none;
  }

  /* Gravel and rings draw in once. */
  .rake,
  .ring {
    fill: none;
    stroke: var(--wash);
    stroke-width: 1.1;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .live .rake {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1.8s cubic-bezier(0.6, 0, 0.2, 1) calc(var(--i) * 70ms);
  }
  .live .ring {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1.5s cubic-bezier(0.6, 0, 0.2, 1) calc(600ms + var(--i) * 220ms + var(--r) * 120ms);
  }

  /* Stones settle, the pond fills. */
  .feature {
    opacity: 0;
    transform: translateY(-10px);
  }
  .live .feature {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.9s ease calc(300ms + var(--i) * 220ms),
      transform 1.1s cubic-bezier(0.2, 0.8, 0.2, 1) calc(300ms + var(--i) * 220ms);
  }
  .shadow {
    fill: var(--ink);
    opacity: 0.12;
    filter: blur(5px);
  }
  .sleeve {
    transform-box: fill-box;
    transform-origin: center;
  }
  .pond {
    stroke: color-mix(in srgb, var(--emerald) 45%, transparent);
    stroke-width: 1.2;
  }
  .ripple-still {
    fill: none;
    stroke: color-mix(in srgb, var(--emerald) 30%, transparent);
    stroke-width: 1;
  }
  .splash {
    fill: none;
    stroke: var(--emerald);
    stroke-width: 1.4;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }
  .pond-tag {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    fill: var(--emerald);
    text-anchor: middle;
  }
  .pulse {
    fill: none;
    stroke: var(--emerald);
    stroke-width: 1.2;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  /* The way out is always there, quietly. */
  .return {
    fill: none;
    stroke: var(--stone);
    stroke-width: 1;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0.55;
  }
  .live .return {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1.6s cubic-bezier(0.6, 0, 0.2, 1) 1.4s;
  }
  .lane {
    fill: none;
    stroke: none;
  }

  .scene text.cue {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-anchor: middle;
    paint-order: stroke;
    stroke: var(--paper);
    stroke-width: 6px;
    stroke-linejoin: round;
  }
  .cue {
    fill: var(--emerald);
    opacity: 0;
  }
  .scene-t text.cue {
    font-size: 8.5px;
  }

  .coin circle,
  .coin-part circle {
    fill: var(--ink);
  }
  .fee circle,
  .payout circle {
    fill: var(--emerald);
  }
  .payout text {
    fill: var(--paper);
    font-family: var(--font-serif);
    font-size: 11px;
    text-anchor: middle;
  }

  /* The three steps, under their stones. */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 2rem);
  }
  .step {
    text-align: center;
    opacity: 0;
    transform: translateY(10px);
  }
  .live .step {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.8s ease calc(900ms + var(--i) * 220ms),
      transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) calc(900ms + var(--i) * 220ms);
  }
  .kicker {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.2em 0.7em;
    margin: 0 0 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--stone);
  }
  .num {
    color: var(--emerald);
  }
  h3 {
    margin: 0 0 0.45rem;
    font-size: clamp(1.2rem, 1.8vw, 1.45rem);
    font-weight: 400;
  }
  .step .body {
    margin: 0 auto;
    max-width: 30ch;
    line-height: 1.55;
    color: color-mix(in srgb, var(--ink) 78%, var(--paper));
  }

  .still .rake,
  .still .ring,
  .still .return,
  .still .feature,
  .still .step {
    transition: none;
  }

  @media (max-width: 760px) {
    .garden {
      grid-template-columns: 9.5rem minmax(0, 1fr);
      grid-template-rows: repeat(3, 13rem);
      gap: 0 0.9rem;
    }
    .scene-w {
      display: none;
    }
    .scene-t {
      display: block;
      grid-row: 1 / span 3;
      width: 100%;
      height: 39rem;
    }
    .steps {
      grid-row: 1 / span 3;
      grid-template-columns: 1fr;
      grid-template-rows: repeat(3, 13rem);
      gap: 0;
    }
    .step {
      display: flex;
      flex-direction: column;
      justify-content: center;
      text-align: left;
    }
    .kicker {
      justify-content: flex-start;
    }
    .step .body {
      margin: 0;
      font-size: 0.92rem;
    }
  }
</style>
