---
import { OPEN_COPY } from "../open-copy";

const { heading, moves, scene } = OPEN_COPY.works;

type Kind = "wallet" | "account" | "alloc" | "pool";
type Box = { kind: Kind; label: string; x: number; y: number; w: number; h: number };
type Layout = {
  id: string;
  w: number;
  h: number;
  boxes: Box[];
};

const labels: Record<Kind, string> = {
  wallet: scene.wallet,
  account: scene.agent,
  alloc: scene.strategy,
  pool: scene.payout,
};

function row(id: string, across: boolean): Layout {
  const kinds: Kind[] = ["wallet", "account", "alloc", "pool"];
  if (across) {
    const w = 232;
    const h = 132;
    const y = 64;
    const xs = [28, 308, 588, 868];
    return {
      id,
      w: 1128,
      h: 250,
      boxes: kinds.map((kind, i) => ({ kind, label: labels[kind], x: xs[i]!, y, w, h })),
    };
  }
  const w = 250;
  const h = 112;
  const x = 28;
  const ys = [56, 214, 372, 530];
  return {
    id,
    w: 306,
    h: 690,
    boxes: kinds.map((kind, i) => ({ kind, label: labels[kind], x, y: ys[i]!, w, h })),
  };
}

const layouts = [row("w", true), row("t", false)];

function cx(b: Box) {
  return b.x + b.w / 2;
}
function cy(b: Box) {
  return b.y + b.h / 2;
}

// 15 / 35 / 50, top to bottom. Same tones as the allocation board.
const BANDS = [
  { cls: "merc", h: 16, label: "15" },
  { cls: "paired", h: 34, label: "35" },
  { cls: "stables", h: 48, label: "50" },
];
const bandTop = -49;

const kickers = [scene.wallet, scene.agent, scene.payout];
---
<section class="works" id="works" aria-labelledby="works-title">
  <h2 id="works-title">{heading}</h2>

  <div class="garden">
    {layouts.map((l) => {
      const horizontal = l.id === "w";
      return (
        <svg
          class={`scene scene-${l.id}`}
          viewBox={`0 0 ${l.w} ${l.h}`}
          role="img"
          aria-label={scene.aria}
          data-scene={l.id}
        >
          {l.boxes.slice(0, -1).map((b, i) => {
            const next = l.boxes[i + 1]!;
            const last = i === l.boxes.length - 2;
            const x1 = horizontal ? b.x + b.w : cx(b);
            const y1 = horizontal ? cy(b) : b.y + b.h;
            const x2 = horizontal ? next.x : cx(next);
            const y2 = horizontal ? cy(next) : next.y;
            return (
              <g class={last ? "join join-last" : "join"}>
                <path
                  class="groove"
                  d={horizontal ? `M${cx(b)} ${cy(b)} H${cx(next)}` : `M${cx(b)} ${cy(b)} V${cy(next)}`}
                />
                <path class="link" d={horizontal ? `M${x1 + 8} ${y1} H${x2 - 10}` : `M${x1} ${y1 + 8} V${y2 - 10}`} />
                <path
                  class="chev"
                  d={horizontal
                    ? `M${x2 - 10} ${y2 - 4} L${x2 - 2} ${y2} L${x2 - 10} ${y2 + 4}`
                    : `M${x2 - 4} ${y2 - 10} L${x2} ${y2 - 2} L${x2 + 4} ${y2 - 10}`}
                />
              </g>
            );
          })}

          {l.boxes.map((b) => (
            <g class={`frame frame-${b.kind}`}>
              <text class="cap" x={cx(b)} y={b.y - 14} text-anchor="middle">{b.label}</text>
              <rect class="box" x={b.x} y={b.y} width={b.w} height={b.h} rx="2" />
              {b.kind === "wallet" && (
                <g class="glyph" transform={`translate(${cx(b)} ${cy(b)})`}>
                  <rect x="-22" y="-16" width="44" height="32" rx="3" />
                  <circle cx="10" cy="0" r="2.2" />
                </g>
              )}
              {b.kind === "account" && (
                <image
                  href="/mark-two-stones.png"
                  x={cx(b) - 22}
                  y={cy(b) - 22}
                  width="44"
                  height="44"
                />
              )}
              {b.kind === "alloc" && (
                <g class="stack" transform={`translate(${cx(b) - 14} ${cy(b)})`}>
                  {BANDS.map((band, i) => {
                    const y = bandTop + BANDS.slice(0, i).reduce((sum, item) => sum + item.h, 0);
                    return (
                      <g class="band-row">
                        <rect class={`band ${band.cls}`} x="-26" y={y} width="52" height={band.h - 2} />
                        <text class="wt" x="36" y={y + band.h / 2 + 4} text-anchor="start">{band.label}</text>
                      </g>
                    );
                  })}
                </g>
              )}
              {b.kind === "pool" && (
                <g class="coins" transform={`translate(${cx(b)} ${cy(b) + 6})`}>
                  <text class="coin-k" x="0" y="-34" text-anchor="middle">{scene.usdc}</text>
                  {[ -26, 0, 26 ].map((dx) => (
                    <g class="coin" transform={`translate(${dx} 4)`}>
                      <circle r="11" />
                      <text class="mark" y="4" text-anchor="middle">$</text>
                    </g>
                  ))}
                  <g class="coin gain" transform="translate(0 -16)" opacity="0">
                    <circle r="11" />
                    <text class="mark" y="4" text-anchor="middle">$</text>
                  </g>
                </g>
              )}
            </g>
          ))}

          <g class="token eth" opacity="0">
            <polygon points="0,-8 7,0 0,8 -7,0" />
          </g>
          <g class="token usdc" opacity="0">
            <circle r="9" />
            <text class="mark" y="3.5" text-anchor="middle">$</text>
          </g>
        </svg>
      );
    })}

    <ol class="steps">
      {moves.map((move, i) => (
        <li class="step" style={`--i:${i}`}>
          <p class="kicker">
            <span class="num">{String(i + 1).padStart(2, "0")}</span>
            <span class="where">{kickers[i]}</span>
          </p>
          <h3>{move.title}</h3>
          <p class="body">{move.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>("#works");
  const quiet = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const sleep = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));
  const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2);

  const liveScene = () =>
    [...(root?.querySelectorAll<SVGSVGElement>(".scene") ?? [])].find(
      (s) => getComputedStyle(s).display !== "none",
    );

  function travel(el: SVGGElement, path: SVGPathElement, ms: number) {
    return new Promise<void>((resolve) => {
      const len = path.getTotalLength();
      const t0 = performance.now();
      const tick = (now: number) => {
        const raw = Math.min(1, (now - t0) / ms);
        const p = path.getPointAtLength(len * ease(raw));
        const fade = raw < 0.12 ? raw / 0.12 : raw > 0.9 ? (1 - raw) / 0.1 : 1;
        el.setAttribute("transform", `translate(${p.x} ${p.y})`);
        el.setAttribute("opacity", String(Math.max(0, fade)));
        if (raw < 1) requestAnimationFrame(tick);
        else resolve();
      };
      requestAnimationFrame(tick);
    });
  }

  function clearMotion(svg: SVGSVGElement) {
    svg.querySelectorAll(".gain, .token").forEach((el) => {
      el.getAnimations().forEach((a) => a.cancel());
    });
    svg.querySelectorAll<SVGElement>(".token").forEach((el) => el.setAttribute("opacity", "0"));
    const gain = svg.querySelector<SVGGElement>(".gain");
    if (!gain) return;
    gain.setAttribute("opacity", "0");
    gain.setAttribute("transform", "translate(0 -16)");
  }

  async function addUsdc(svg: SVGSVGElement) {
    const gain = svg.querySelector<SVGGElement>(".gain");
    if (!gain) return;
    gain.setAttribute("opacity", "1");
    await gain.animate(
      [
        { transform: "translate(0 -34)", opacity: 0 },
        { transform: "translate(0 -18)", opacity: 1 },
      ],
      { duration: 700, easing: "cubic-bezier(.2,.8,.2,1)", fill: "forwards" },
    ).finished;
  }

  async function loop() {
    for (;;) {
      const svg = liveScene();
      if (!svg) {
        await sleep(1000);
        continue;
      }
      const eth = svg.querySelector<SVGGElement>(".eth");
      const usdc = svg.querySelector<SVGGElement>(".usdc");
      const grooves = [...svg.querySelectorAll<SVGPathElement>(".groove")];
      if (!eth || !usdc || grooves.length < 3) return;
      clearMotion(svg);
      await travel(eth, grooves[0]!, 1600);
      await sleep(280);
      await travel(eth, grooves[1]!, 1600);
      await sleep(420);
      await travel(usdc, grooves[2]!, 1700);
      await addUsdc(svg);
      await sleep(4200);
    }
  }

  if (root) {
    if (quiet) root.classList.add("live", "still");
    else {
      const io = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          io.disconnect();
          root.classList.add("live");
          sleep(900).then(loop);
        },
        { threshold: 0.35 },
      );
      io.observe(root);
    }
  }
</script>

<style>
  .works {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vw, 3rem);
    width: 100%;
    min-width: 0;
    scroll-margin-top: 5.5rem;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 2.7rem);
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1.15;
  }

  .garden {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .scene {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .scene-t {
    display: none;
  }

  .cap {
    fill: var(--ink);
    font-family: var(--font-serif);
    font-size: 15px;
  }
  .box {
    fill: color-mix(in srgb, var(--paper) 72%, white);
    stroke: var(--ink);
    stroke-width: 1.25;
  }
  .frame-pool .box {
    stroke: var(--emerald);
  }

  .link,
  .chev {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .join-last .link,
  .join-last .chev {
    stroke: var(--emerald);
  }
  .groove {
    fill: none;
    stroke: none;
  }

  .glyph {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.4;
  }
  .glyph circle {
    fill: var(--ink);
    stroke: none;
  }

  .band.merc { fill: #6fa78f; }
  .band.paired { fill: #0e1b2e; }
  .band.stables { fill: #a7a9ac; }
  .wt {
    fill: var(--ink);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .coin circle {
    fill: var(--emerald);
  }
  .coin .mark,
  .token .mark {
    fill: var(--paper);
    font-family: var(--font-serif);
    font-size: 12px;
  }
  .coin-k {
    fill: var(--emerald);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
  }
  .token polygon {
    fill: var(--ink);
  }
  .token.usdc circle {
    fill: var(--emerald);
  }

  .still .gain {
    opacity: 1;
    transform: translate(0 -18);
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
  }
  .step:nth-child(3) {
    grid-column: 4;
  }
  .step {
    text-align: center;
    padding-inline: clamp(0rem, 1.5vw, 1.25rem);
  }
  .kicker {
    display: flex;
    justify-content: center;
    gap: 0.7em;
    margin: 0 0 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--stone);
  }
  .num {
    color: var(--emerald);
  }
  h3 {
    margin: 0 0 0.45rem;
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 400;
  }
  .step .body {
    margin: 0 auto;
    max-width: 32ch;
    line-height: 1.55;
    color: color-mix(in srgb, var(--ink) 78%, var(--paper));
  }

  @media (max-width: 720px) {
    .scene-w {
      display: none;
    }
    .scene-t {
      display: block;
      width: min(100%, 22rem);
      margin-inline: auto;
    }
    .cap {
      font-size: 14px;
    }
    .steps {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .step:nth-child(3) {
      grid-column: auto;
    }
    .step {
      text-align: left;
      padding: 0;
    }
    .kicker {
      justify-content: flex-start;
    }
    .step .body {
      margin: 0;
    }
  }
</style>
