---
import { OPEN_COPY } from "../open-copy";

const { heading, scene } = OPEN_COPY.works;
const vessels = [
  { tone: "stables", x: 396, h: 40 },
  { tone: "paired", x: 422, h: 28 },
  { tone: "mercenary", x: 448, h: 16 },
];
---
<section class="works" id="works" aria-labelledby="works-title">
  <h2 id="works-title">{heading}</h2>
  <svg class="scene" viewBox="0 0 520 340" role="img" aria-label={scene.aria}>
    <path id="route-connect" class="route" d="M148 92 H196" />
    <path id="route-fund" class="route" d="M324 92 H372" />
    <path id="route-usdc" class="route" d="M436 136 V220" />

    <path class="edge e-eth" d="M148 92 H196" />
    <path class="edge e-eth" d="M324 92 H372" />
    <path class="edge e-usdc" d="M436 136 V212" />
    <path class="head" d="M428 204 L436 220 L444 204" />

    <g class="dots d-eth">
      {["0s", "-0.7s", "-1.4s"].map((begin) => (
        <circle r="3.5">
          <animateMotion dur="2s" begin={begin} repeatCount="indefinite">
            <mpath href="#route-connect" />
          </animateMotion>
        </circle>
      ))}
      {["-0.35s", "-1.05s", "-1.75s"].map((begin) => (
        <circle r="3.5">
          <animateMotion dur="2s" begin={begin} repeatCount="indefinite">
            <mpath href="#route-fund" />
          </animateMotion>
        </circle>
      ))}
    </g>
    <g class="dots d-usdc">
      {["0s", "-0.7s", "-1.4s"].map((begin) => (
        <circle r="3.5">
          <animateMotion dur="2.1s" begin={begin} repeatCount="indefinite">
            <mpath href="#route-usdc" />
          </animateMotion>
        </circle>
      ))}
    </g>

    <g class="node n-wallet">
      <rect class="box" x="20" y="48" width="128" height="88" />
      <rect class="glyph" x="62" y="76" width="44" height="30" />
      <path class="glyph" d="M62 85 H106" />
      <circle class="glyph-dot" cx="97" cy="96" r="2.4" />
      <text x="84" y="36">{scene.wallet}</text>
    </g>

    <g class="node n-agent">
      <rect class="box" x="196" y="48" width="128" height="88" />
      <image href="/mark-two-stones.png" x="242" y="72" width="36" height="36" />
      <text x="260" y="36">{scene.agent}</text>
    </g>

    <g class="node n-pools">
      <rect class="box" x="372" y="48" width="128" height="88" />
      {vessels.map((v) => (
        <>
          <rect class="vessel" x={v.x} y="76" width="20" height="44" />
          <rect class={`fill ${v.tone}`} x={v.x + 1} y={119 - v.h} width="18" height={v.h} />
        </>
      ))}
      <text x="436" y="36">{scene.pools}</text>
    </g>

    <g class="node n-payout">
      <rect class="box" x="372" y="220" width="128" height="88" />
      <rect class="glyph" x="414" y="248" width="44" height="30" />
      <path class="glyph" d="M414 257 H458" />
      <circle class="glyph-dot" cx="449" cy="268" r="2.4" />
      <text x="436" y="198">Wallet of</text>
      <text x="436" y="214">your choice</text>
    </g>

    <text class="tag t-eth" x="172" y="80">{scene.eth}</text>
    <text class="tag t-eth" x="348" y="80">{scene.eth}</text>
    <g class="chip">
      <rect x="406" y="160" width="60" height="22" />
      <text x="436" y="176">{scene.usdc}</text>
    </g>
  </svg>
</section>

<script>
  const scene = document.querySelector<SVGSVGElement>("#works .scene");
  if (scene && window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    scene.pauseAnimations();
  }
</script>

<style>
  .works {
    --tone-stables: #a7a9ac;
    --tone-paired: #0e1b2e;
    --tone-mercenary: #6fa78f;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-width: 0;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 2.7rem);
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1.15;
  }

  .scene {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .route {
    fill: none;
    stroke: none;
  }
  .edge {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  .e-usdc,
  .head {
    stroke: var(--emerald);
    fill: none;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .dots circle {
    fill: var(--ink);
  }
  .d-usdc circle {
    fill: var(--emerald);
  }

  .box {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 1.2;
  }
  .n-payout .box {
    stroke: var(--emerald);
  }
  .glyph {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.4;
  }
  .glyph-dot {
    fill: var(--ink);
  }
  .vessel {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1;
  }
  .fill.stables {
    fill: var(--tone-stables);
  }
  .fill.paired {
    fill: var(--tone-paired);
  }
  .fill.mercenary {
    fill: var(--tone-mercenary);
  }

  .scene text {
    font-family: var(--font-serif);
    font-size: 14px;
    fill: var(--ink);
    text-anchor: middle;
  }
  .scene .tag {
    font-size: 11px;
    letter-spacing: 0.14em;
  }
  .chip rect {
    fill: var(--paper);
    stroke: var(--emerald);
    stroke-width: 1.2;
  }
  .scene .chip text {
    font-size: 11px;
    letter-spacing: 0.14em;
    fill: var(--emerald);
  }

  @media (prefers-reduced-motion: reduce) {
    .dots {
      display: none;
    }
  }
</style>
