---
import { OPEN_COPY } from "../open-copy";

const { heading, scene } = OPEN_COPY.works;
const bars = [
  { tone: "mercenary", y: 108, h: 14, pct: "15" },
  { tone: "paired", y: 122, h: 28, pct: "35" },
  { tone: "stables", y: 150, h: 30, pct: "50" },
];
---
<section class="works" id="works" aria-labelledby="works-title">
  <h2 id="works-title">{heading}</h2>
  <svg class="scene" viewBox="0 0 1120 240" role="img" aria-label={scene.aria}>
    <defs>
      <clipPath id="alloc-clip">
        <rect x="790" y="84" width="240" height="96" />
      </clipPath>
    </defs>
    <path id="route-connect" class="route" d="M310 132 H430" />
    <path id="route-fund" class="route" d="M670 132 H790" />
    <path id="route-usdc" class="route" d="M910 128 V158" />

    <path class="edge e-eth" d="M310 132 H430" />
    <path class="edge e-eth" d="M670 132 H790" />

    <g class="node n-wallet">
      <rect class="box" x="70" y="84" width="240" height="96" />
      <rect class="glyph" x="168" y="112" width="44" height="30" />
      <path class="glyph" d="M168 121 H212" />
      <circle class="glyph-dot" cx="203" cy="132" r="2.4" />
      <text x="190" y="68">{scene.wallet}</text>
    </g>

    <g class="node n-agent">
      <rect class="box" x="430" y="84" width="240" height="96" />
      <image href="/mark-two-stones.png" x="532" y="108" width="36" height="36" />
      <text x="550" y="52">Mamoru Delegated</text>
      <text x="550" y="70">Account</text>
    </g>

    <g class="node n-strategy">
      <rect class="box" x="790" y="84" width="240" height="96" />
      {bars.map((bar) => (
        <g>
          <rect
            id={bar.tone === "stables" ? "bar-stables" : undefined}
            class={`bar ${bar.tone}`}
            x="888"
            y={bar.y}
            width="44"
            height={bar.h}
          />
          <text class={`pct ${bar.tone}`} x="910" y={bar.y + bar.h / 2 + 4}>{bar.pct}</text>
        </g>
      ))}
      <text x="910" y="68">{scene.strategy}</text>
    </g>

    <g id="usdc-pile" clip-path="url(#alloc-clip)"></g>
    <g id="usdc-fly" class="usdc-fly" opacity="0">
      <circle class="usdc-disc" r="11" />
      <circle class="usdc-ring" r="7.5" />
      <text class="usdc-mark" y="4" fill="#fff">$</text>
    </g>
    <g id="eth-mark" class="eth-fly" opacity="0">
      <polygon points="0,-11 9,0 0,11 -9,0" />
    </g>
  </svg>
</section>

<script>
  const scene = document.querySelector<SVGSVGElement>("#works .scene");
  const mark = document.querySelector<SVGGElement>("#eth-mark");
  const hop1 = document.querySelector<SVGPathElement>("#route-connect");
  const hop2 = document.querySelector<SVGPathElement>("#route-fund");
  const usdcPath = document.querySelector<SVGPathElement>("#route-usdc");
  const usdcFly = document.querySelector<SVGGElement>("#usdc-fly");
  const usdcPile = document.querySelector<SVGGElement>("#usdc-pile");
  const quiet = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (scene && quiet) scene.pauseAnimations();

  const sleep = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms));
  const ease = (t: number) => (t < 0.5 ? 2 * t * t : 1 - (-2 * t + 2) ** 2 / 2);
  const easeIn = (t: number) => t * t;
  const fadeIn = (t: number, edge = 0.18) => (t < edge ? t / edge : 1);

  function move(
    el: SVGGElement,
    from: { x: number; y: number },
    to: { x: number; y: number },
    ms: number,
    easeFn: (t: number) => number,
    opacityAt: (t: number) => number,
  ) {
    return new Promise<void>((resolve) => {
      const t0 = performance.now();
      const tick = (now: number) => {
        const raw = Math.min(1, (now - t0) / ms);
        const t = easeFn(raw);
        const x = from.x + (to.x - from.x) * t;
        const y = from.y + (to.y - from.y) * t;
        el.setAttribute("transform", `translate(${x} ${y})`);
        el.setAttribute("opacity", String(opacityAt(raw)));
        if (raw < 1) requestAnimationFrame(tick);
        else resolve();
      };
      requestAnimationFrame(tick);
    });
  }

  function travel(el: SVGGElement, path: SVGPathElement, ms: number, fadeOut = true) {
    return new Promise<void>((resolve) => {
      const len = path.getTotalLength();
      const t0 = performance.now();
      const tick = (now: number) => {
        const raw = Math.min(1, (now - t0) / ms);
        const t = ease(raw);
        const p = path.getPointAtLength(len * t);
        el.setAttribute("transform", `translate(${p.x} ${p.y})`);
        const o = fadeOut
          ? raw < 0.22
            ? raw / 0.22
            : raw > 0.78
              ? (1 - raw) / 0.22
              : 1
          : fadeIn(raw);
        el.setAttribute("opacity", String(o));
        if (raw < 1) requestAnimationFrame(tick);
        else {
          if (fadeOut) el.setAttribute("opacity", "0");
          resolve();
        }
      };
      requestAnimationFrame(tick);
    });
  }

  async function fundLoop(el: SVGGElement, a: SVGPathElement, b: SVGPathElement) {
    for (;;) {
      await travel(el, a, 3600);
      await sleep(1000);
      await travel(el, b, 3600);
      await sleep(2000);
    }
  }

  const stablesBar = document.querySelector<SVGRectElement>("#bar-stables");
  const pileSlots = [
    { x: 896, y: 172 },
    { x: 910, y: 172 },
    { x: 924, y: 172 },
    { x: 903, y: 160 },
    { x: 917, y: 160 },
    { x: 910, y: 148 },
    { x: 903, y: 136 },
    { x: 917, y: 136 },
  ];
  const growPool = (n: number) => {
    if (!stablesBar) return;
    const extra = Math.min(18, n * 2.2);
    stablesBar.setAttribute("y", String(150 - extra));
    stablesBar.setAttribute("height", String(30 + extra));
  };

  function addPileCoin(at: { x: number; y: number }) {
    if (!usdcPile || !usdcFly) return;
    const g = usdcFly.cloneNode(true) as SVGGElement;
    g.removeAttribute("id");
    g.setAttribute("class", "usdc-fly usdc-landed");
    g.setAttribute("transform", `translate(${at.x} ${at.y}) scale(0.72)`);
    g.setAttribute("opacity", "0");
    usdcPile.appendChild(g);
    requestAnimationFrame(() => g.setAttribute("opacity", "1"));
  }

  async function harvestLoop(fly: SVGGElement, path: SVGPathElement) {
    let n = 0;
    for (;;) {
      if (n >= pileSlots.length) {
        usdcPile?.querySelectorAll(".usdc-landed").forEach((node) => {
          (node as SVGGElement).setAttribute("opacity", "0");
        });
        await sleep(700);
        usdcPile?.replaceChildren();
        growPool(0);
        n = 0;
      }
      const slot = pileSlots[n];
      const start = path.getPointAtLength(0);
      const lip = path.getPointAtLength(path.getTotalLength());
      fly.setAttribute("opacity", "0");
      await move(fly, start, lip, 5200, ease, fadeIn);
      await move(fly, lip, slot, 900, easeIn, () => 1);
      fly.setAttribute("opacity", "0");
      addPileCoin(slot);
      n += 1;
      growPool(n);
      await sleep(700);
    }
  }

  if (!quiet && mark && hop1 && hop2) fundLoop(mark, hop1, hop2);
  if (!quiet && usdcFly && usdcPath && usdcPile) harvestLoop(usdcFly, usdcPath);
</script>

<style>
  .works {
    --tone-stables: #a7a9ac;
    --tone-paired: #0e1b2e;
    --tone-mercenary: #6fa78f;
    --usdc: #2775ca;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
    min-width: 0;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 2.7rem);
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1.15;
  }

  .scene {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .route {
    fill: none;
    stroke: none;
  }
  .edge {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.6;
    stroke-linecap: round;
  }
  .e-usdc {
    stroke: var(--emerald);
  }

  .eth-fly {
    fill: var(--ink);
  }
  .usdc-disc {
    fill: var(--usdc);
  }
  .usdc-ring {
    fill: none;
    stroke: #fff;
    stroke-width: 1.5;
  }
  .usdc-mark {
    fill: #fff;
    font-family: var(--font-serif);
    font-size: 13px;
    text-anchor: middle;
  }
  .usdc-landed {
    transition: opacity 0.65s ease;
  }

  .box {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 1.2;
  }
  .scene text.pct {
    font-size: 9px;
    letter-spacing: 0;
    pointer-events: none;
  }
  .scene text.pct.paired {
    fill: var(--paper);
  }
  .glyph {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.4;
  }
  .glyph-dot {
    fill: var(--ink);
  }
  .bar.mercenary {
    fill: var(--tone-mercenary);
  }
  .bar.paired {
    fill: var(--tone-paired);
  }
  .bar.stables {
    fill: var(--tone-stables);
  }

  .scene text {
    font-family: var(--font-serif);
    font-size: 15px;
    fill: var(--ink);
    text-anchor: middle;
  }
  .scene text.usdc-mark {
    fill: #fff;
    font-size: 13px;
  }
  .scene .tag {
    font-size: 12px;
    letter-spacing: 0.14em;
  }

  @media (prefers-reduced-motion: reduce) {
    .eth-fly,
    .usdc-fly {
      display: none;
    }
  }
</style>
