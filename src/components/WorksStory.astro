---
import { OPEN_COPY } from "../open-copy";

const { heading, scene } = OPEN_COPY.works;
const bars = [
  { tone: "mercenary", y: 104, h: 12 },
  { tone: "paired", y: 116, h: 26 },
  { tone: "stables", y: 142, h: 28 },
];
const flyStarts = ["0s", "-1.2s", "-2.3s"];
---
<section class="works" id="works" aria-labelledby="works-title">
  <h2 id="works-title">{heading}</h2>
  <svg class="scene" viewBox="0 0 1120 240" role="img" aria-label={scene.aria}>
    <path id="route-connect" class="route" d="M224 132 H312" />
    <path id="route-fund" class="route" d="M512 132 H600" />
    <path id="route-usdc" class="route" d="M800 132 H888" />

    <path class="edge e-eth" d="M224 132 H312" />
    <path class="edge e-eth" d="M512 132 H600" />
    <path class="edge e-usdc" d="M800 132 H888" />

    {flyStarts.map((begin) => (
      <g class="usdc-fly">
        <animateMotion dur="3.4s" begin={begin} repeatCount="indefinite">
          <mpath href="#route-usdc" />
        </animateMotion>
        <circle class="usdc-disc" r="14" />
        <circle class="usdc-ring" r="9.5" />
        <text class="usdc-mark" y="5" fill="#fff">$</text>
      </g>
    ))}

    <g class="node n-wallet">
      <rect class="box" x="24" y="84" width="200" height="96" />
      <rect class="glyph" x="102" y="112" width="44" height="30" />
      <path class="glyph" d="M102 121 H146" />
      <circle class="glyph-dot" cx="137" cy="132" r="2.4" />
      <text x="124" y="68">{scene.wallet}</text>
    </g>

    <g class="node n-agent">
      <rect class="box" x="312" y="84" width="200" height="96" />
      <image href="/mark-two-stones.png" x="394" y="108" width="36" height="36" />
      <text x="412" y="68">{scene.agent}</text>
    </g>

    <g class="node n-strategy">
      <rect class="box" x="600" y="84" width="200" height="96" />
      {bars.map((bar) => (
        <rect class={`bar ${bar.tone}`} x="678" y={bar.y} width="44" height={bar.h} />
      ))}
      <text x="700" y="68">{scene.strategy}</text>
    </g>

    <g class="node n-payout">
      <rect class="box" x="888" y="84" width="200" height="96" />
      <rect class="glyph" x="966" y="112" width="44" height="30" />
      <path class="glyph" d="M966 121 H1010" />
      <circle class="glyph-dot" cx="1001" cy="132" r="2.4" />
      <text x="988" y="56">Wallet of</text>
      <text x="988" y="72">your choice</text>
    </g>

    <g id="eth-mark" class="eth-fly" opacity="0">
      <polygon points="0,-11 9,0 0,11 -9,0" />
    </g>
  </svg>
</section>

<script>
  const scene = document.querySelector<SVGSVGElement>("#works .scene");
  const mark = document.querySelector<SVGGElement>("#eth-mark");
  const hop1 = document.querySelector<SVGPathElement>("#route-connect");
  const hop2 = document.querySelector<SVGPathElement>("#route-fund");
  const quiet = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (scene && quiet) scene.pauseAnimations();

  const sleep = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms));
  const ease = (t: number) => (t < 0.5 ? 2 * t * t : 1 - (-2 * t + 2) ** 2 / 2);
  const fade = (t: number) => {
    const edge = 0.22;
    if (t < edge) return t / edge;
    if (t > 1 - edge) return (1 - t) / edge;
    return 1;
  };

  function travel(el: SVGGElement, path: SVGPathElement, ms: number) {
    return new Promise<void>((resolve) => {
      const len = path.getTotalLength();
      const t0 = performance.now();
      const tick = (now: number) => {
        const raw = Math.min(1, (now - t0) / ms);
        const t = ease(raw);
        const p = path.getPointAtLength(len * t);
        el.setAttribute("transform", `translate(${p.x} ${p.y})`);
        el.setAttribute("opacity", String(fade(raw)));
        if (raw < 1) requestAnimationFrame(tick);
        else {
          el.setAttribute("opacity", "0");
          resolve();
        }
      };
      requestAnimationFrame(tick);
    });
  }

  async function fundLoop(el: SVGGElement, a: SVGPathElement, b: SVGPathElement) {
    for (;;) {
      await travel(el, a, 3600);
      await sleep(1000);
      await travel(el, b, 3600);
      await sleep(2000);
    }
  }

  if (!quiet && mark && hop1 && hop2) fundLoop(mark, hop1, hop2);
</script>

<style>
  .works {
    --tone-stables: #a7a9ac;
    --tone-paired: #0e1b2e;
    --tone-mercenary: #6fa78f;
    --usdc: #2775ca;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
    min-width: 0;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 2.7rem);
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1.15;
  }

  .scene {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .route {
    fill: none;
    stroke: none;
  }
  .edge {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.6;
    stroke-linecap: round;
  }
  .e-usdc {
    stroke: var(--emerald);
  }

  .eth-fly {
    fill: var(--ink);
  }
  .usdc-disc {
    fill: var(--usdc);
  }
  .usdc-ring {
    fill: none;
    stroke: #fff;
    stroke-width: 1.5;
  }
  .usdc-mark {
    fill: #fff;
    font-family: var(--font-serif);
    font-size: 13px;
    text-anchor: middle;
  }

  .box {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 1.2;
  }
  .n-payout .box {
    stroke: var(--emerald);
  }
  .glyph {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.4;
  }
  .glyph-dot {
    fill: var(--ink);
  }
  .bar.mercenary {
    fill: var(--tone-mercenary);
  }
  .bar.paired {
    fill: var(--tone-paired);
  }
  .bar.stables {
    fill: var(--tone-stables);
  }

  .scene text {
    font-family: var(--font-serif);
    font-size: 15px;
    fill: var(--ink);
    text-anchor: middle;
  }
  .scene text.usdc-mark {
    fill: #fff;
    font-size: 13px;
  }
  .scene .tag {
    font-size: 12px;
    letter-spacing: 0.14em;
  }

  @media (prefers-reduced-motion: reduce) {
    .eth-fly,
    .usdc-fly {
      display: none;
    }
  }
</style>
