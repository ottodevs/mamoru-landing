---
import { OPEN_COPY } from "../open-copy";

const { heading, moves, scene } = OPEN_COPY.works;

// Stone silhouettes in local coords, roughly 100 units across.
const STONES = {
  // Flat river stone: the wallet.
  wallet: ["M-46 -6 C-44 -26 -18 -34 8 -32 C34 -30 50 -18 48 2 C46 22 22 32 -6 31 C-32 30 -48 14 -46 -6 Z"],
  // The Mamoru mark: principal stone and the half-moon split.
  mark: [
    "M-34 -34 C-24 -52 8 -54 26 -42 C42 -31 40 -6 30 16 C19 40 -2 50 -21 45 C-41 40 -48 17 -46 -4 C-45 -17 -41 -26 -34 -34 Z",
    "M37 -3 C52 3 58 22 51 37 C46 48 34 52 21 51 Z",
  ],
  // Three sleeves of graded size: stablecoins, bluechips, mercenary capital.
  alloc: [
    "M-52 -4 C-50 -24 -26 -32 -4 -30 C18 -28 30 -14 28 4 C26 22 6 30 -18 29 C-40 28 -54 14 -52 -4 Z",
    "M30 8 C32 -6 46 -12 58 -8 C68 -4 72 8 68 18 C64 28 50 30 40 27 C31 24 28 16 30 8 Z",
    "M42 -30 C45 -38 54 -40 60 -35 C65 -31 64 -23 58 -20 C51 -17 44 -20 42 -26 Z",
  ],
};

type Stone = keyof typeof STONES;
type Layout = {
  id: string;
  w: number;
  h: number;
  stones: { kind: Stone; x: number; y: number; label: string }[];
  rakes: string[];
  grooves: string[];
  pool: { x: number; y: number };
};

const kinds: Stone[] = ["wallet", "mark", "alloc"];
const labels = [scene.wallet, scene.agent, scene.strategy];

// Wide layout: stones left to right, rakes run horizontally.
const wide: Layout = {
  id: "w",
  w: 1120,
  h: 250,
  stones: kinds.map((kind, i) => ({ kind, x: 187 + i * 373, y: 125, label: labels[i] ?? "" })),
  rakes: Array.from({ length: 7 }, (_, i) => {
    const y = 65 + i * 20;
    return `M0 ${y} C280 ${y - 3} 560 ${y + 3} 840 ${y} S1120 ${y - 2} 1120 ${y}`;
  }),
  grooves: ["M250 131 C340 147 410 147 497 131", "M623 131 C712 147 782 147 870 131"],
  pool: { x: 922, y: 125 },
};

// Tall layout for narrow screens: stones top to bottom, rakes run vertically.
const tall: Layout = {
  id: "t",
  w: 150,
  h: 600,
  stones: kinds.map((kind, i) => ({ kind, x: 75, y: 100 + i * 200, label: labels[i] ?? "" })),
  rakes: Array.from({ length: 6 }, (_, i) => {
    const x = 25 + i * 20;
    return `M${x} 0 C${x - 3} 150 ${x + 3} 300 ${x} 450 S${x - 2} 600 ${x} 600`;
  }),
  grooves: ["M80 150 C94 190 94 212 80 250", "M80 350 C94 390 94 412 80 450"],
  pool: { x: 75, y: 500 },
};

const layouts = [wide, tall];
---
<section class="works" id="works" aria-labelledby="works-title">
  <h2 id="works-title">{heading}</h2>

  <div class="garden">
    {layouts.map((l) => (
      <svg
        class={`scene scene-${l.id}`}
        viewBox={`0 0 ${l.w} ${l.h}`}
        role="img"
        aria-label={scene.aria}
        data-scene={l.id}
      >
        <defs>
          <mask id={`clear-${l.id}`}>
            <rect width={l.w} height={l.h} fill="#fff" />
            {l.stones.map((s) => <ellipse cx={s.x} cy={s.y} rx="92" ry="74" fill="#000" />)}
          </mask>
          <radialGradient id={`sheen-${l.id}`} cx="35%" cy="30%" r="80%">
            <stop offset="0" stop-color="#3a3935" />
            <stop offset="0.55" stop-color="#171715" />
            <stop offset="1" stop-color="#0b0b0a" />
          </radialGradient>
        </defs>

        <g class="rakes" mask={`url(#clear-${l.id})`}>
          {l.rakes.map((d, i) => <path class="rake" d={d} pathLength="1" style={`--i:${i}`} />)}
        </g>

        {l.stones.map((s, i) => (
          <g class={`stone-site site-${i}`} style={`--i:${i}`}>
            {[0, 1, 2].map((r) => (
              <ellipse
                class="ring"
                cx={s.x}
                cy={s.y}
                rx={62 + r * 14}
                ry={48 + r * 11}
                pathLength="1"
                style={`--r:${r}`}
              />
            ))}
            <ellipse class="shadow" cx={s.x + 4} cy={s.y + 34} rx="46" ry="7" />
            <g class="stone" transform={`translate(${s.x} ${s.y})`}>
              {STONES[s.kind].map((d) => <path d={d} fill={`url(#sheen-${l.id})`} />)}
            </g>
            <circle class="pulse" cx={s.x} cy={s.y} r="58" />
          </g>
        ))}

        {l.grooves.map((d, i) => <path class="groove" id={`groove-${l.id}-${i}`} d={d} />)}

        <g class="token eth" opacity="0">
          <polygon points="0,-9 7,0 0,9 -7,0" />
        </g>
        {[0, 1, 2].map((k) => (
          <circle class="drop" r="4.5" cx={l.pool.x + (k - 1) * 16} cy={l.pool.y - 70} opacity="0" />
        ))}
      </svg>
    ))}

    <ol class="steps">
      {moves.map((move, i) => (
        <li class="step" style={`--i:${i}`}>
          <p class="kicker">
            <span class="num">{String(i + 1).padStart(2, "0")}</span>
            <span class="where">{labels[i]}</span>
          </p>
          <h3>{move.title}</h3>
          <p class="body">{move.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>("#works");
  const quiet = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const sleep = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));
  const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2);

  // The scene that is actually displayed for this viewport.
  const liveScene = () =>
    [...(root?.querySelectorAll<SVGSVGElement>(".scene") ?? [])].find(
      (s) => getComputedStyle(s).display !== "none",
    );

  function travel(el: SVGGElement, path: SVGPathElement, ms: number) {
    return new Promise<void>((resolve) => {
      const len = path.getTotalLength();
      const t0 = performance.now();
      const tick = (now: number) => {
        const raw = Math.min(1, (now - t0) / ms);
        const p = path.getPointAtLength(len * ease(raw));
        const fade = raw < 0.15 ? raw / 0.15 : raw > 0.85 ? (1 - raw) / 0.15 : 1;
        el.setAttribute("transform", `translate(${p.x} ${p.y})`);
        el.setAttribute("opacity", String(fade));
        if (raw < 1) requestAnimationFrame(tick);
        else resolve();
      };
      requestAnimationFrame(tick);
    });
  }

  function pulse(svg: SVGSVGElement, site: number) {
    const ring = svg.querySelector<SVGCircleElement>(`.site-${site} .pulse`);
    ring?.animate(
      [
        { opacity: 0.55, transform: "scale(0.7)" },
        { opacity: 0, transform: "scale(1.45)" },
      ],
      { duration: 1400, easing: "cubic-bezier(.2,.7,.2,1)" },
    );
  }

  async function harvest(svg: SVGSVGElement) {
    const drops = [...svg.querySelectorAll<SVGCircleElement>(".drop")];
    await Promise.all(
      drops.map(async (d, k) => {
        await sleep(k * 220);
        await d.animate(
          [
            { opacity: 0, transform: "translateY(0)" },
            { opacity: 1, transform: "translateY(24px)", offset: 0.35 },
            { opacity: 0, transform: "translateY(70px)" },
          ],
          { duration: 1300, easing: "cubic-bezier(.45,0,.2,1)" },
        ).finished;
      }),
    );
    pulse(svg, 2);
  }

  async function loop() {
    for (;;) {
      const svg = liveScene();
      if (!svg) {
        await sleep(1000);
        continue;
      }
      const eth = svg.querySelector<SVGGElement>(".eth");
      const g0 = svg.querySelector<SVGPathElement>(".groove:nth-of-type(1)");
      const grooves = svg.querySelectorAll<SVGPathElement>(".groove");
      if (!eth || !g0 || grooves.length < 2) return;
      pulse(svg, 0);
      await travel(eth, grooves[0]!, 2600);
      pulse(svg, 1);
      await sleep(500);
      await travel(eth, grooves[1]!, 2600);
      pulse(svg, 2);
      await sleep(700);
      await harvest(svg);
      await sleep(2200);
    }
  }

  if (root) {
    if (quiet) root.classList.add("live", "still");
    else {
      const io = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          io.disconnect();
          root.classList.add("live");
          sleep(2400).then(loop);
        },
        { threshold: 0.35 },
      );
      io.observe(root);
    }
  }
</script>

<style>
  .works {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vw, 3rem);
    width: 100%;
    min-width: 0;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 2.7rem);
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1.15;
  }

  .garden {
    display: grid;
    gap: clamp(0.5rem, 1.5vw, 1rem);
  }

  .scene {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .scene-t {
    display: none;
  }

  /* Raked gravel: drawn in once, left to right. */
  .rake {
    fill: none;
    stroke: var(--wash);
    stroke-width: 1.1;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .live .rake {
    transition: stroke-dashoffset 1.8s cubic-bezier(0.6, 0, 0.2, 1);
    transition-delay: calc(var(--i) * 90ms);
    stroke-dashoffset: 0;
  }

  .ring {
    fill: none;
    stroke: var(--wash);
    stroke-width: 1.1;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .live .ring {
    transition: stroke-dashoffset 1.6s cubic-bezier(0.6, 0, 0.2, 1);
    transition-delay: calc(700ms + var(--i) * 260ms + var(--r) * 120ms);
    stroke-dashoffset: 0;
  }

  /* Stones settle into the gravel. */
  .stone,
  .shadow {
    opacity: 0;
  }
  .stone path {
    transform: translateY(-14px);
  }
  .live .stone,
  .live .shadow {
    opacity: 1;
    transition: opacity 0.9s ease;
    transition-delay: calc(350ms + var(--i) * 260ms);
  }
  .live .stone path {
    transform: none;
    transition: transform 1.1s cubic-bezier(0.2, 0.8, 0.2, 1);
    transition-delay: calc(350ms + var(--i) * 260ms);
  }
  .stone-site {
    --i: 0;
  }
  .shadow {
    fill: var(--ink);
    opacity: 0;
    filter: blur(5px);
  }
  .live .shadow {
    opacity: 0.12;
  }

  .pulse {
    fill: none;
    stroke: var(--emerald);
    stroke-width: 1.2;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  .groove {
    fill: none;
    stroke: none;
  }
  .token polygon {
    fill: var(--ink);
  }
  .drop {
    fill: var(--emerald);
  }

  /* Steps under the stones. */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2.5rem);
  }
  .step {
    text-align: center;
    padding-inline: clamp(0rem, 1.5vw, 1.25rem);
    opacity: 0;
    transform: translateY(10px);
  }
  .live .step {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.8s ease,
      transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1);
    transition-delay: calc(900ms + var(--i) * 260ms);
  }
  .kicker {
    display: flex;
    justify-content: center;
    gap: 0.7em;
    margin: 0 0 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--stone);
  }
  .num {
    color: var(--emerald);
  }
  h3 {
    margin: 0 0 0.45rem;
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 400;
  }
  .step .body {
    margin: 0 auto;
    max-width: 30ch;
    line-height: 1.55;
    color: color-mix(in srgb, var(--ink) 78%, var(--paper));
  }

  .still .rake,
  .still .ring,
  .still .stone,
  .still .stone path,
  .still .shadow,
  .still .step {
    transition: none;
  }

  @media (max-width: 720px) {
    .garden {
      grid-template-columns: 7.5rem minmax(0, 1fr);
      gap: 0 1rem;
      align-items: stretch;
    }
    .scene-w {
      display: none;
    }
    .scene-t {
      display: block;
      grid-row: 1 / span 1;
      width: 100%;
      height: 100%;
    }
    .steps {
      grid-template-columns: 1fr;
      grid-template-rows: repeat(3, 1fr);
      gap: 0;
    }
    .step {
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: 11rem;
      text-align: left;
      padding: 0;
    }
    .kicker {
      justify-content: flex-start;
    }
    .step .body {
      margin: 0;
    }
  }
</style>
