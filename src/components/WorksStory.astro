---
import { OPEN_COPY } from "../open-copy";

const { heading, moves, scene } = OPEN_COPY.works;

// Stone silhouettes in local coords, about 100 units across.
const WALLET = "M-46 -6 C-44 -26 -18 -34 8 -32 C34 -30 50 -18 48 2 C46 22 22 32 -6 31 C-32 30 -48 14 -46 -6 Z";
const MARK = [
  "M-34 -34 C-24 -52 8 -54 26 -42 C42 -31 40 -6 30 16 C19 40 -2 50 -21 45 C-41 40 -48 17 -46 -4 C-45 -17 -41 -26 -34 -34 Z",
  "M37 -3 C52 3 58 22 51 37 C46 48 34 52 21 51 Z",
];
// Stablecoins, bluechips, mercenary: graded sizes.
const SLEEVES = [
  "M-52 -4 C-50 -24 -26 -32 -4 -30 C18 -28 30 -14 28 4 C26 22 6 30 -18 29 C-40 28 -54 14 -52 -4 Z",
  "M30 8 C32 -6 46 -12 58 -8 C68 -4 72 8 68 18 C64 28 50 30 40 27 C31 24 28 16 30 8 Z",
  "M42 -30 C45 -38 54 -40 60 -35 C65 -31 64 -23 58 -20 C51 -17 44 -20 42 -26 Z",
];

type Pt = { x: number; y: number };
type Cue = Pt | null;
type Layout = {
  id: "w" | "t";
  w: number;
  h: number;
  wallet: Pt;
  mark: Pt;
  sleeves: Pt;
  pond: Pt & { rx: number; ry: number };
  rakes: string[];
  toMark: string;
  toSleeves: string[];
  toPond: string[];
  reinvest: string;
  withdraw: string;
  key: Pt & { w: number; size: number };
  cue: { swap: Cue; fees: Cue; reinvest: Cue; withdraw: Cue; rebalance: Cue };
  sleeveTags: Cue[];
};

const wide: Layout = {
  id: "w",
  w: 1200,
  h: 340,
  wallet: { x: 150, y: 150 },
  mark: { x: 455, y: 150 },
  sleeves: { x: 765, y: 150 },
  pond: { x: 1060, y: 150, rx: 80, ry: 44 },
  rakes: Array.from({ length: 10 }, (_, i) => {
    const y = 66 + i * 20;
    return `M0 ${y} C300 ${y - 3} 600 ${y + 3} 900 ${y} S1200 ${y - 2} 1200 ${y}`;
  }),
  toMark: "M205 150 C280 174 330 174 400 150",
  toSleeves: [
    "M510 152 C590 176 650 176 712 160",
    "M510 146 C600 122 700 116 794 142",
    "M510 140 C610 100 740 84 822 112",
  ],
  toPond: [
    "M770 172 C860 200 950 200 1004 166",
    "M834 162 C900 156 960 146 1000 150",
    "M828 112 C910 104 972 114 1006 138",
  ],
  reinvest: "M1016 112 C980 52 880 50 836 96",
  withdraw: "M1060 198 C1060 262 1030 292 980 292 L220 292 C172 292 150 264 150 206",
  key: { x: 455, y: 58, w: 232, size: 10.5 },
  cue: {
    swap: { x: 765, y: 58 },
    fees: { x: 1060, y: 84 },
    reinvest: { x: 928, y: 42 },
    withdraw: { x: 605, y: 322 },
    rebalance: { x: 765, y: 264 },
  },
  sleeveTags: [
    { x: 738, y: 236 },
    { x: 824, y: 236 },
    { x: 842, y: 84 },
  ],
};

// Narrow screens: the same garden, top to bottom, text beside it.
const tall: Layout = {
  id: "t",
  w: 160,
  h: 880,
  wallet: { x: 80, y: 110 },
  mark: { x: 80, y: 330 },
  sleeves: { x: 74, y: 550 },
  pond: { x: 80, y: 770, rx: 60, ry: 36 },
  rakes: Array.from({ length: 7 }, (_, i) => {
    const x = 22 + i * 20;
    return `M${x} 0 C${x - 3} 220 ${x + 3} 440 ${x} 660 S${x - 2} 880 ${x} 880`;
  }),
  toMark: "M80 150 C94 210 94 250 80 285",
  toSleeves: [
    "M80 378 C90 440 76 480 64 518",
    "M84 378 C110 430 126 480 124 530",
    "M88 376 C120 420 136 470 130 500",
  ],
  toPond: [
    "M62 588 C60 650 70 700 76 740",
    "M122 590 C124 660 104 710 90 742",
    "M138 530 C156 610 130 700 100 744",
  ],
  reinvest: "M132 752 C158 720 160 640 148 600",
  withdraw: "M24 782 C8 762 6 732 6 702 L6 160 C6 130 18 116 30 112",
  key: { x: 80, y: 238, w: 150, size: 6.4 },
  cue: { swap: { x: 80, y: 452 }, fees: { x: 80, y: 690 }, reinvest: null, withdraw: null, rebalance: { x: 80, y: 452 } },
  sleeveTags: [null, null, null],
};

const layouts = [wide, tall];
const cueText = {
  swap: scene.swap,
  fees: scene.fees,
  reinvest: scene.reinvest,
  withdraw: scene.withdraw,
  rebalance: scene.rebalance,
};
const holes = (l: Layout) => [
  { ...l.wallet, rx: 96, ry: 70 },
  { ...l.mark, rx: 96, ry: 74 },
  { ...l.sleeves, rx: 118, ry: 76 },
  { x: l.pond.x, y: l.pond.y, rx: l.pond.rx + 26, ry: l.pond.ry + 26 },
];
---
<section class="works" id="works" aria-labelledby="works-title">
  <h2 id="works-title">{heading}</h2>

  <div class="garden">
    {layouts.map((l) => (
      <svg class={`scene scene-${l.id}`} viewBox={`0 0 ${l.w} ${l.h}`} role="img" aria-label={scene.aria}>
        <defs>
          <mask id={`clear-${l.id}`}>
            <rect width={l.w} height={l.h} fill="#fff" />
            {holes(l).map((h) => <ellipse cx={h.x} cy={h.y} rx={h.rx} ry={h.ry} fill="#000" />)}
          </mask>
          <radialGradient id={`sheen-${l.id}`} cx="35%" cy="30%" r="80%">
            <stop offset="0" stop-color="#3a3935" />
            <stop offset="0.55" stop-color="#171715" />
            <stop offset="1" stop-color="#0b0b0a" />
          </radialGradient>
          <radialGradient id={`water-${l.id}`} cx="50%" cy="45%" r="60%">
            <stop offset="0" stop-color="#2f5d50" stop-opacity="0.2" />
            <stop offset="1" stop-color="#2f5d50" stop-opacity="0.06" />
          </radialGradient>
        </defs>

        <g class="rakes" mask={`url(#clear-${l.id})`}>
          {l.rakes.map((d, i) => <path class="rake" d={d} pathLength="1" style={`--i:${i}`} />)}
        </g>

        {holes(l).map((h, i) => (
          <g class="rings" style={`--i:${i}`}>
            {[0, 1].map((r) => (
              <ellipse class="ring" cx={h.x} cy={h.y} rx={h.rx - 26 + r * 14} ry={h.ry - 22 + r * 11} pathLength="1" style={`--r:${r}`} />
            ))}
          </g>
        ))}

        <path class="return" d={l.withdraw} pathLength="1" />

        <g class="feature f-0" style="--i:0">
          <ellipse class="shadow" cx={l.wallet.x + 4} cy={l.wallet.y + 32} rx="44" ry="7" />
          <g class="stone" transform={`translate(${l.wallet.x} ${l.wallet.y})`}>
            <path d={WALLET} fill={`url(#sheen-${l.id})`} />
            <g class="carve">
              <rect x="-16" y="-11" width="32" height="22" rx="3" />
              <path d="M-16 -4 H16" />
              <circle cx="9" cy="3" r="1.8" />
            </g>
          </g>
          <circle class="pulse" cx={l.wallet.x} cy={l.wallet.y} r="56" />
        </g>

        <g class="feature f-1" style="--i:1">
          <ellipse class="shadow" cx={l.mark.x + 4} cy={l.mark.y + 44} rx="46" ry="7" />
          <g class="stone" transform={`translate(${l.mark.x} ${l.mark.y})`}>
            {MARK.map((d) => <path d={d} fill={`url(#sheen-${l.id})`} />)}
          </g>
          <circle class="pulse" cx={l.mark.x} cy={l.mark.y} r="58" />
        </g>

        <g class="feature f-2" style="--i:2">
          <ellipse class="shadow" cx={l.sleeves.x + 4} cy={l.sleeves.y + 32} rx="56" ry="7" />
          <g class="stone sleeves" transform={`translate(${l.sleeves.x} ${l.sleeves.y})`}>
            {SLEEVES.map((d, k) => <path class={`sleeve s-${k}`} d={d} fill={`url(#sheen-${l.id})`} />)}
          </g>
          {l.sleeveTags.map((t, k) =>
            t ? <text class="tag" x={t.x} y={t.y}>{scene.sleeves[k]}</text> : null,
          )}
          <circle class="pulse" cx={l.sleeves.x} cy={l.sleeves.y} r="62" />
        </g>

        <g class="feature f-3" style="--i:3">
          <ellipse class="pond" cx={l.pond.x} cy={l.pond.y} rx={l.pond.rx} ry={l.pond.ry} fill={`url(#water-${l.id})`} />
          {[0.55, 0.3].map((f) => (
            <ellipse class="ripple-still" cx={l.pond.x} cy={l.pond.y} rx={l.pond.rx * f} ry={l.pond.ry * f} />
          ))}
          <ellipse class="splash" cx={l.pond.x} cy={l.pond.y} rx={l.pond.rx * 0.4} ry={l.pond.ry * 0.4} />
          <text class="pond-tag" x={l.pond.x} y={l.pond.y + 4}>USDC</text>
        </g>

        <g class="keychip" transform={`translate(${l.key.x} ${l.key.y})`}>
          <rect x={-l.key.w / 2} y="-13" width={l.key.w} height="26" rx="13" />
          <g transform={`translate(${-l.key.w / 2 + 16} 0)`}>
            <circle cx="0" cy="0" r="4.2" />
            <path d="M4 0 H13 M10 0 V4 M13 0 V3" />
          </g>
          <text x={-l.key.w / 2 + 34} y={l.key.size * 0.36} style={`font-size:${l.key.size}px`}>{scene.key}</text>
        </g>

        <path class="arc" d={l.reinvest} pathLength="1" />

        {(Object.keys(cueText) as (keyof typeof cueText)[]).map((k) => {
          const at = l.cue[k];
          return at ? <text class={`cue cue-${k}`} x={at.x} y={at.y}>{cueText[k]}</text> : null;
        })}

        <path class="lane" d={l.toMark} />
        {l.toSleeves.map((d) => <path class="lane" d={d} />)}
        {l.toPond.map((d) => <path class="lane" d={d} />)}

        <g class="token eth" opacity="0"><polygon points="0,-9 7,0 0,9 -7,0" /></g>
        {[0, 1, 2].map(() => (
          <g class="token eth-part" opacity="0"><polygon points="0,-6 4.6,0 0,6 -4.6,0" /></g>
        ))}
        {[0, 1, 2].map(() => (
          <g class="token fee" opacity="0"><circle r="4.2" /></g>
        ))}
        <g class="token usdc" opacity="0">
          <circle r="8.5" />
          <text y="3.4">$</text>
        </g>
      </svg>
    ))}

    <ol class="steps">
      {moves.map((move, i) => (
        <li class="step" style={`--i:${i}`}>
          <p class="kicker">
            <span class="num">{String(i + 1).padStart(2, "0")}</span>
            <span class="where">{[scene.wallet, scene.agent, scene.strategy, scene.payout][i]}</span>
          </p>
          <h3>{move.title}</h3>
          <p class="body">{move.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>("#works");
  const quiet = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const sleep = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));
  const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2);
  const out = { duration: 700, easing: "cubic-bezier(.2,.8,.2,1)", fill: "forwards" as const };

  // The scene actually displayed at this viewport width.
  const liveScene = () =>
    [...(root?.querySelectorAll<SVGSVGElement>(".scene") ?? [])].find(
      (s) => getComputedStyle(s).display !== "none",
    );

  function travel(el: SVGGElement, path: SVGPathElement, ms: number, back = false) {
    return new Promise<void>((resolve) => {
      const len = path.getTotalLength();
      const t0 = performance.now();
      const tick = (now: number) => {
        const raw = Math.min(1, (now - t0) / ms);
        const at = ease(raw);
        const p = path.getPointAtLength(len * (back ? 1 - at : at));
        const fade = raw < 0.12 ? raw / 0.12 : raw > 0.88 ? (1 - raw) / 0.12 : 1;
        el.setAttribute("transform", `translate(${p.x} ${p.y})`);
        el.setAttribute("opacity", String(fade));
        if (raw < 1) requestAnimationFrame(tick);
        else resolve();
      };
      requestAnimationFrame(tick);
    });
  }

  function pulse(svg: SVGSVGElement, i: number) {
    svg.querySelector(`.f-${i} .pulse`)?.animate(
      [
        { opacity: 0.5, transform: "scale(0.72)" },
        { opacity: 0, transform: "scale(1.4)" },
      ],
      { duration: 1400, easing: "cubic-bezier(.2,.7,.2,1)" },
    );
  }

  async function cue(svg: SVGSVGElement, name: string, ms = 1800) {
    const el = svg.querySelector(`.cue-${name}`);
    if (!el) return;
    el.animate(
      [
        { opacity: 0, transform: "translateY(4px)" },
        { opacity: 1, transform: "none", offset: 0.15 },
        { opacity: 1, transform: "none", offset: 0.8 },
        { opacity: 0, transform: "translateY(-3px)" },
      ],
      { duration: ms, easing: "ease-out" },
    );
  }

  function splash(svg: SVGSVGElement) {
    svg.querySelector(".splash")?.animate(
      [
        { opacity: 0.7, transform: "scale(0.5)" },
        { opacity: 0, transform: "scale(2.1)" },
      ],
      { duration: 1300, easing: "cubic-bezier(.2,.7,.2,1)" },
    );
  }

  async function cycle(svg: SVGSVGElement) {
    const lanes = [...svg.querySelectorAll<SVGPathElement>(".lane")];
    const [toMark, ...rest] = lanes;
    const toSleeves = rest.slice(0, 3);
    const toPond = rest.slice(3, 6);
    const eth = svg.querySelector<SVGGElement>(".eth");
    const parts = [...svg.querySelectorAll<SVGGElement>(".eth-part")];
    const fees = [...svg.querySelectorAll<SVGGElement>(".fee")];
    const usdc = svg.querySelector<SVGGElement>(".usdc");
    const sleeves = [...svg.querySelectorAll<SVGPathElement>(".sleeve")];
    const withdrawPath = svg.querySelector<SVGPathElement>(".return");
    const arc = svg.querySelector<SVGPathElement>(".arc");
    if (!toMark || !eth || !usdc || !withdrawPath || !arc) return;

    // 1. Fund: ETH walks from your wallet to your Mamoru account.
    pulse(svg, 0);
    await travel(eth, toMark, 2200);
    pulse(svg, 1);
    svg.querySelector(".keychip")?.classList.add("on");
    await sleep(600);

    // 2. Allocate: the capital splits into three sleeves on Uniswap.
    cue(svg, "swap", 2600);
    await Promise.all(parts.map((p, k) => sleep(k * 140).then(() => travel(p, toSleeves[k]!, 2000))));
    pulse(svg, 2);
    await sleep(700);

    // 3. Harvest: fees flow into the stablecoin pool.
    cue(svg, "fees", 2400);
    await Promise.all(fees.map((f, k) => sleep(k * 200).then(() => travel(f, toPond[k]!, 1900))));
    splash(svg);
    await sleep(500);

    // 4. Reinvest: the pool feeds the sleeves again.
    cue(svg, "reinvest", 2200);
    await arc.animate([{ strokeDashoffset: 1, opacity: 1 }, { strokeDashoffset: 0, opacity: 1 }, { strokeDashoffset: 0, opacity: 0 }], {
      duration: 1900,
      easing: "ease-in-out",
    }).finished;
    pulse(svg, 2);
    await sleep(900);

    // 5. Withdraw: stablecoins pay first, then the sleeves rebalance.
    cue(svg, "withdraw", 3600);
    sleeves[0]?.animate([{ transform: "scale(1)" }, { transform: "scale(0.88)" }], out);
    await travel(usdc, withdrawPath, 3000);
    pulse(svg, 0);
    await sleep(500);
    cue(svg, "rebalance", 1800);
    sleeves[0]?.animate([{ transform: "scale(0.88)" }, { transform: "scale(1)" }], { ...out, duration: 1300 });
    sleeves.slice(1).forEach((s, k) =>
      s.animate([{ transform: "scale(1)" }, { transform: "scale(0.93)" }, { transform: "scale(1)" }], {
        duration: 1300,
        delay: 140 * (k + 1),
        easing: "ease-in-out",
      }),
    );
    pulse(svg, 2);
    await sleep(2600);
  }

  async function loop() {
    for (;;) {
      const svg = liveScene();
      if (svg) await cycle(svg);
      else await sleep(1000);
    }
  }

  if (root) {
    if (quiet) root.classList.add("live", "still");
    else {
      const io = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          io.disconnect();
          root.classList.add("live");
          sleep(2600).then(loop);
        },
        { threshold: 0.3 },
      );
      io.observe(root);
    }
  }
</script>

<style>
  .works {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    width: 100%;
    min-width: 0;
  }
  h2 {
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 2.7rem);
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1.15;
  }
  .garden {
    display: grid;
    gap: clamp(0.25rem, 1vw, 0.75rem);
  }
  .scene {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .scene-t {
    display: none;
  }

  /* Gravel and rings draw in once. */
  .rake,
  .ring {
    fill: none;
    stroke: var(--wash);
    stroke-width: 1.1;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .live .rake {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1.8s cubic-bezier(0.6, 0, 0.2, 1) calc(var(--i) * 70ms);
  }
  .live .ring {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1.5s cubic-bezier(0.6, 0, 0.2, 1) calc(600ms + var(--i) * 220ms + var(--r) * 120ms);
  }

  /* Stones settle, the pond fills. */
  .feature {
    opacity: 0;
    transform: translateY(-10px);
  }
  .live .feature {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.9s ease calc(300ms + var(--i) * 220ms),
      transform 1.1s cubic-bezier(0.2, 0.8, 0.2, 1) calc(300ms + var(--i) * 220ms);
  }
  .shadow {
    fill: var(--ink);
    opacity: 0.12;
    filter: blur(5px);
  }
  .carve rect,
  .carve path {
    fill: none;
    stroke: color-mix(in srgb, var(--paper) 70%, transparent);
    stroke-width: 1.6;
  }
  .carve circle {
    fill: color-mix(in srgb, var(--paper) 70%, transparent);
  }
  .sleeve {
    transform-box: fill-box;
    transform-origin: center;
  }
  .pond {
    stroke: color-mix(in srgb, var(--emerald) 45%, transparent);
    stroke-width: 1.2;
  }
  .ripple-still {
    fill: none;
    stroke: color-mix(in srgb, var(--emerald) 30%, transparent);
    stroke-width: 1;
  }
  .splash {
    fill: none;
    stroke: var(--emerald);
    stroke-width: 1.4;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }
  .pond-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    fill: var(--emerald);
    text-anchor: middle;
  }
  .pulse {
    fill: none;
    stroke: var(--emerald);
    stroke-width: 1.2;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  /* The withdraw path is always there, quietly. */
  .return {
    fill: none;
    stroke: var(--stone);
    stroke-width: 1;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0.55;
  }
  .live .return {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 2.4s cubic-bezier(0.6, 0, 0.2, 1) 1.4s;
  }
  .arc {
    fill: none;
    stroke: var(--emerald);
    stroke-width: 1.3;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0;
  }
  .lane {
    fill: none;
    stroke: none;
  }

  .keychip {
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  .keychip.on,
  .still .keychip {
    opacity: 1;
  }
  .keychip rect {
    fill: var(--paper);
    stroke: var(--emerald);
    stroke-width: 1;
  }
  .keychip circle,
  .keychip path {
    fill: none;
    stroke: var(--emerald);
    stroke-width: 1.4;
    stroke-linecap: round;
  }
  .keychip text {
    font-family: var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    fill: var(--emerald);
    text-anchor: start;
  }

  .scene text.cue,
  .scene text.tag {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-anchor: middle;
    paint-order: stroke;
    stroke: var(--paper);
    stroke-width: 6px;
    stroke-linejoin: round;
  }
  .cue {
    fill: var(--emerald);
    opacity: 0;
  }
  .cue-withdraw {
    fill: var(--stone);
  }
  .tag {
    fill: var(--stone);
  }
  .scene-t text.cue {
    font-size: 8.5px;
  }

  .eth polygon,
  .eth-part polygon {
    fill: var(--ink);
  }
  .fee circle,
  .usdc circle {
    fill: var(--emerald);
  }
  .usdc text {
    fill: var(--paper);
    font-family: var(--font-serif);
    font-size: 11px;
    text-anchor: middle;
  }

  /* The four steps, under their stones. */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 2rem);
  }
  .step {
    text-align: center;
    opacity: 0;
    transform: translateY(10px);
  }
  .live .step {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.8s ease calc(900ms + var(--i) * 220ms),
      transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) calc(900ms + var(--i) * 220ms);
