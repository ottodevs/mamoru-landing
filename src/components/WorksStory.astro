---
import { OPEN_COPY } from "../open-copy";

const { heading, moves, scene } = OPEN_COPY.works;
const num = (index: number) => String(index + 1).padStart(2, "0");
---
<div class="story">
  <section class="works" id="works" aria-labelledby="works-title">
    <div class="stage" data-step="0">
      <h2 id="works-title">{heading}</h2>
      <div class="rail" aria-hidden="true">
        <ol>
          {moves.map((move, index) => (
            <li>
              <span class="rail-num">{num(index)}</span>
              <span>{move.title}</span>
            </li>
          ))}
        </ol>
        <span class="rail-track"><span class="rail-fill"></span></span>
      </div>

      <svg class="scene" viewBox="0 0 520 320" role="img" aria-label={moves.map((m) => m.title).join(", ")}>
        <path id="story-flow" class="route" d="M128 160 H392" />
        <path id="story-harvest" class="route" d="M448 200 C448 292 72 292 72 200" />

        <path class="link l-connect" pathLength="100" d="M128 160 H204" />
        <path class="link l-fund" pathLength="100" d="M316 160 H392" />
        <path class="link l-harvest" pathLength="100" d="M448 200 C448 292 72 292 72 200" />

        <g class="dots eth">
          {["0s", "-0.8s", "-1.6s"].map((begin) => (
            <circle r="4">
              <animateMotion dur="2.4s" begin={begin} repeatCount="indefinite">
                <mpath href="#story-flow" />
              </animateMotion>
            </circle>
          ))}
        </g>
        <g class="dots usdc">
          {["0s", "-1s", "-2s"].map((begin) => (
            <circle r="4">
              <animateMotion dur="3s" begin={begin} repeatCount="indefinite">
                <mpath href="#story-harvest" />
              </animateMotion>
            </circle>
          ))}
        </g>

        <g class="node n-wallet">
          <rect class="box" x="16" y="120" width="112" height="80" />
          <rect class="glyph" x="52" y="146" width="40" height="28" />
          <path class="glyph" d="M52 154 H92" />
          <circle class="glyph-dot" cx="84" cy="165" r="2.2" />
          <text x="72" y="104">{scene.wallet}</text>
        </g>
        <g class="node n-agent">
          <rect class="box" x="204" y="120" width="112" height="80" />
          <image href="/mark-two-stones.png" x="242" y="142" width="36" height="36" />
          <text x="260" y="104">{scene.agent}</text>
        </g>
        <g class="node n-pools">
          <rect class="box" x="392" y="120" width="112" height="80" />
          <rect class="bar" x="424" y="152" width="10" height="32" />
          <rect class="bar" x="443" y="144" width="10" height="40" />
          <rect class="bar" x="462" y="160" width="10" height="24" />
          <text x="448" y="104">{scene.pools}</text>
        </g>

        <text class="tag t-eth" x="166" y="148">{scene.eth}</text>
        <text class="tag t-usdc" x="260" y="298">{scene.usdc}</text>
      </svg>

      <ol class="steps">
        {moves.map((move, index) => (
          <li class="card">
            <p class="step">{num(index)}</p>
            <h3 class="name">{move.title}</h3>
            <p class="body">{move.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
  <slot />
</div>

<script>
  const works = document.getElementById("works");
  const stage = works?.querySelector<HTMLElement>(".stage");
  const scene = works?.querySelector<SVGSVGElement>(".scene");

  if (works && stage) {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      scene?.pauseAnimations();
    }
    let queued = false;
    const update = () => {
      queued = false;
      const rect = works.getBoundingClientRect();
      const span = rect.height - window.innerHeight;
      const p = span > 0 ? Math.min(1, Math.max(0, -rect.top / span)) : 1;
      stage.style.setProperty("--p", p.toFixed(4));
      const step = String(Math.min(2, Math.floor(p * 3.3)));
      if (stage.dataset.step !== step) stage.dataset.step = step;
    };
    const queue = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };
    window.addEventListener("scroll", queue, { passive: true });
    window.addEventListener("resize", queue);
    update();
  }
</script>

<style>
  .story {
    --nav-h: 4.5rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    width: 100%;
    border-bottom: 1px solid var(--wash);
  }

  .works {
    height: 320vh;
    scroll-margin-top: 0;
  }

  .stage {
    --q: calc(var(--p, 0) * 3.3);
    --s0: clamp(0, var(--q), 1);
    --s1: clamp(0, calc(var(--q) - 1), 1);
    --s2: clamp(0, calc(var(--q) - 2), 1);
    position: sticky;
    top: 0;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2.4vh, 1.6rem);
    padding: calc(var(--nav-h) + clamp(1.25rem, 4vh, 2.5rem)) clamp(1.15rem, 4vw, 3.5rem)
      clamp(1.25rem, 4vh, 2.5rem);
    border-right: 1px solid var(--wash);
    background: color-mix(in srgb, var(--paper) 55%, transparent);
    box-sizing: border-box;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 2.7rem);
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1.15;
  }

  .rail ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }
  .rail li {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    font-size: 1rem;
    color: var(--stone);
    transition: color 0.3s ease;
  }
  .rail-num {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
  }
  .stage[data-step="0"] .rail li:nth-child(-n + 1),
  .stage[data-step="1"] .rail li:nth-child(-n + 2),
  .stage[data-step="2"] .rail li {
    color: var(--ink);
  }
  .stage .rail li .rail-num {
    color: var(--emerald);
  }
  .rail-track {
    display: block;
    height: 1px;
    margin-top: 0.6rem;
    background: var(--wash);
  }
  .rail-fill {
    display: block;
    height: 100%;
    background: var(--emerald);
    transform-origin: left;
    transform: scaleX(min(1, calc(var(--q) / 3)));
  }

  .scene {
    flex: 1 1 0;
    min-height: 8rem;
    width: 100%;
    overflow: visible;
  }
  .route {
    fill: none;
    stroke: none;
  }
  .link {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-dasharray: 100px 100px;
  }
  .l-connect {
    stroke-dashoffset: calc((1 - min(1, var(--s0) * 1.8)) * 100px);
  }
  .l-fund {
    stroke-dashoffset: calc((1 - min(1, var(--s1) * 1.8)) * 100px);
  }
  .l-harvest {
    stroke: var(--emerald);
    stroke-dashoffset: calc((1 - min(1, var(--s2) * 1.6)) * 100px);
  }

  .dots circle {
    fill: var(--ink);
  }
  .dots.usdc circle {
    fill: var(--emerald);
  }
  .dots.eth,
  .t-eth {
    opacity: clamp(0, calc(var(--s1) * 3), 1);
  }
  .dots.usdc,
  .t-usdc {
    opacity: clamp(0, calc(var(--s2) * 3 - 1), 1);
  }

  .box {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 1.2;
  }
  .glyph {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.4;
  }
  .glyph-dot {
    fill: var(--ink);
  }
  .n-agent {
    opacity: calc(0.18 + 0.82 * clamp(0, calc(var(--s0) * 2.5 - 1.2), 1));
  }
  .n-pools {
    opacity: calc(0.18 + 0.82 * clamp(0, calc(var(--s1) * 2.5 - 1), 1));
  }
  .bar {
    fill: var(--emerald);
    transform-box: fill-box;
    transform-origin: bottom;
    transform: scaleY(calc(0.2 + 0.8 * var(--s1)));
  }
  .scene text {
    font-family: var(--font-serif);
    font-size: 15px;
    fill: var(--ink);
    text-anchor: middle;
  }
  .scene .tag {
    font-size: 13px;
    letter-spacing: 0.08em;
    fill: var(--emerald);
  }
  .scene .t-eth {
    fill: var(--ink);
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .card {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.35rem 1.5rem 1.5rem;
    border: 1px solid var(--wash);
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    opacity: 0;
    transform: translateY(0.6rem);
    transition:
      opacity 0.35s ease,
      transform 0.35s ease;
  }
  .stage[data-step="0"] .card:nth-child(1),
  .stage[data-step="1"] .card:nth-child(2),
  .stage[data-step="2"] .card:nth-child(3) {
    opacity: 1;
    transform: none;
  }
  .step {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--emerald);
  }
  .name {
    margin: 0;
    font-size: clamp(1.25rem, 2vw, 1.55rem);
    font-weight: 400;
    line-height: 1.25;
  }
  .card .body {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.45;
  }

  @media (max-width: 760px) {
    .story {
      --nav-h: 6.5rem;
      display: block;
    }
    .works {
      height: 300vh;
    }
    .stage {
      border-right: 0;
      border-bottom: 1px solid var(--wash);
    }
    .rail li {
      font-size: 0.9rem;
    }
    .card .body {
      font-size: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rail li,
    .card {
      transition: none;
    }
    .card {
      transform: none;
    }
    .dots {
      display: none;
    }
  }
</style>
