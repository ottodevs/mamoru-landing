---
/**
 * Minimal teaser email capture (Mode A).
 * Rendered only when SHOW_EMAIL_FORM is true at build time.
 * Secrets never land here — only PUBLIC_TURNSTILE_SITE_KEY.
 */
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
---
<section class="email-capture" aria-labelledby="email-capture-heading">
  <h2 id="email-capture-heading" class="heading">Stay in the loop</h2>
  <p class="hint">Double opt-in. We will only email when there is something real to say.</p>
  <form class="form" id="mamoru-email-form" method="post" action="/api/subscribe" novalidate>
    <label class="sr-only" for="mamoru-email">Email</label>
    <input
      id="mamoru-email"
      class="input"
      type="email"
      name="email"
      autocomplete="email"
      required
      placeholder="you@example.com"
      maxlength="254"
    />
    <div class="turnstile-wrap">
      {
        siteKey ? (
          <div
            class="cf-turnstile"
            data-sitekey={siteKey}
            data-theme="light"
            data-size="normal"
          />
        ) : (
          <p class="missing-key" role="status">
            Turnstile site key not configured (PUBLIC_TURNSTILE_SITE_KEY).
          </p>
        )
      }
    </div>
    <button class="submit" type="submit">Notify me</button>
    <p class="status" id="mamoru-email-status" role="status" aria-live="polite"></p>
  </form>
</section>

{siteKey && (
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
)}

<script>
  const form = document.getElementById("mamoru-email-form");
  const statusEl = document.getElementById("mamoru-email-status");
  if (form instanceof HTMLFormElement && statusEl instanceof HTMLElement) {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      statusEl.textContent = "Sending…";
      const emailInput = form.querySelector("#mamoru-email");
      const email =
        emailInput instanceof HTMLInputElement ? emailInput.value.trim() : "";
      const tokenInput = form.querySelector("[name=cf-turnstile-response]");
      const turnstileToken =
        tokenInput instanceof HTMLInputElement ? tokenInput.value : "";
      if (!email) {
        statusEl.textContent = "Enter an email.";
        return;
      }
      try {
        const res = await fetch("/api/subscribe", {
          method: "POST",
          headers: {
            "content-type": "application/json",
            accept: "application/json",
          },
          body: JSON.stringify({ email, turnstileToken }),
        });
        const data = (await res.json().catch(() => ({}))) as {
          ok?: boolean;
          error?: string;
        };
        if (!res.ok || !data.ok) {
          statusEl.textContent = data.error || "Could not subscribe. Try again.";
          return;
        }
        statusEl.textContent = "Check your inbox to confirm.";
        form.reset();
        // @ts-expect-error Turnstile global from api.js
        if (typeof turnstile !== "undefined") turnstile.reset();
      } catch {
        statusEl.textContent = "Network error. Try again.";
      }
    });
  }
</script>

<style>
  .email-capture {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    max-width: 22rem;
    width: 100%;
  }
  .heading {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 400;
    letter-spacing: 0.02em;
  }
  .hint {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.45;
    color: color-mix(in srgb, var(--ink) 72%, var(--stone));
  }
  .form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .input {
    font: inherit;
    font-size: 1rem;
    padding: 0.7rem 0.85rem;
    border: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
    background: color-mix(in srgb, var(--paper) 92%, white);
    color: var(--ink);
    width: 100%;
  }
  .input:focus {
    outline: 2px solid color-mix(in srgb, var(--emerald) 55%, transparent);
    outline-offset: 1px;
  }
  .submit {
    font: inherit;
    font-size: 0.95rem;
    padding: 0.7rem 1rem;
    border: 1px solid color-mix(in srgb, var(--ink) 18%, transparent);
    background: var(--emerald);
    color: var(--paper);
    cursor: pointer;
    align-self: flex-start;
  }
  .submit:hover {
    filter: brightness(1.05);
  }
  .status {
    margin: 0;
    min-height: 1.25em;
    font-size: 0.85rem;
    color: var(--stone);
  }
  .missing-key {
    margin: 0;
    font-size: 0.8rem;
    color: var(--stone);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
