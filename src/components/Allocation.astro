---
import { OPEN_COPY } from "../open-copy";

interface Props {
  variant?: "page" | "card";
}
const { variant = "page" } = Astro.props;
const mix = OPEN_COPY.mix;
---
<figure class={`mix ${variant}`}>
  <div class="mix-bar" aria-hidden="true">
    {mix.map((seg) => (
      <div class={`mix-seg ${seg.tone}`} style={`flex:${seg.pct}`}>{seg.pct}%</div>
    ))}
  </div>
  <ul class="mix-legend">
    {mix.map((seg) => (
      <li style={`flex:${seg.pct}`}>
        <span class={`mix-tick ${seg.tone}`} aria-hidden="true"><span class="mix-dot"></span></span>
        <span class="mix-text">
          <span class="mix-name">{seg.name}</span>
          <span class="mix-pct">{seg.pct}%</span>
          {seg.note ? <span class="mix-note">{seg.note}</span> : null}
        </span>
      </li>
    ))}
  </ul>
</figure>

<style>
  .mix {
    --mix-navy: #0e1b2e;
    --mix-emerald: #6fa78f;
    --mix-stone: #a7a9ac;
    --bar-w: 8.5rem;
    --bar-h: clamp(22rem, 58vh, 32rem);
    display: grid;
    grid-template-columns: var(--bar-w) minmax(0, 1fr);
    gap: 0 clamp(1rem, 2.5vw, 2rem);
    margin: 0;
  }
  .mix.card {
    --bar-w: 4.5rem;
    --bar-h: 13.5rem;
    margin-top: 1.25rem;
  }

  .mix-bar {
    display: flex;
    flex-direction: column;
    height: var(--bar-h);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
  }
  .mix-seg {
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.15rem;
    letter-spacing: 0.04em;
    color: var(--ink);
  }
  .mix.card .mix-seg {
    font-size: 0.8rem;
  }
  .mix-seg.mercenary { background: var(--mix-emerald); }
  .mix-seg.paired { background: var(--mix-navy); color: var(--paper); }
  .mix-seg.stables { background: var(--mix-stone); }

  .mix-legend {
    list-style: none;
    margin: 0;
    padding: 0;
    height: var(--bar-h);
    display: flex;
    flex-direction: column;
  }
  .mix-legend li {
    min-height: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.85rem;
    align-items: center;
  }
  .mix-tick {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  .mix-tick::before,
  .mix-tick::after {
    content: "";
    width: 1.1rem;
    height: 1px;
    background: color-mix(in srgb, var(--ink) 28%, transparent);
  }
  .mix-dot {
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    display: block;
  }
  .mercenary .mix-dot { background: var(--mix-emerald); }
  .paired .mix-dot { background: var(--mix-navy); }
  .stables .mix-dot { background: var(--mix-stone); }

  .mix-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .mix-name {
    font-size: clamp(1.15rem, 1.8vw, 1.4rem);
    line-height: 1.25;
  }
  .mix-pct {
    font-size: 1rem;
    line-height: 1.25;
    color: var(--emerald);
  }
  .mix-note {
    margin-top: 0.3rem;
    font-size: 0.95rem;
    line-height: 1.4;
    max-width: 16rem;
    color: color-mix(in srgb, var(--ink) 62%, transparent);
  }

  .mix.card .mix-tick::before {
    display: none;
  }
  .mix.card .mix-tick::after {
    width: 0.6rem;
  }
  .mix.card .mix-dot {
    width: 0.65rem;
    height: 0.65rem;
  }
  .mix.card .mix-legend li {
    gap: 0.6rem;
  }
  .mix.card .mix-text {
    flex-flow: row wrap;
    align-items: baseline;
    gap: 0 0.4rem;
  }
  .mix.card .mix-note {
    flex-basis: 100%;
    max-width: none;
  }
  .mix.card .mix-name {
    font-size: 1rem;
  }
  .mix.card .mix-pct {
    font-size: 0.85rem;
  }
  .mix.card .mix-note {
    margin-top: 0.1rem;
    font-size: 0.85rem;
    line-height: 1.35;
  }

  @media (max-width: 760px) {
    .mix {
      --bar-w: 5rem;
      --bar-h: 24rem;
    }
    .mix.card {
      --bar-w: 3.5rem;
      --bar-h: 15rem;
    }
    .mix-tick::before {
      display: none;
    }
  }
</style>
