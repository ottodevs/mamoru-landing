---
import { OPEN_COPY } from "../open-copy";

// Slide 3 v3: one column, 240 x 640 on the 1920 board, its legend centred on each tramo. No seal here: the seal
// signs the end of the page.
const { eyebrow, heading, body, note, mix } = OPEN_COPY.allocation;
const label = mix.map((seg) => `${seg.pct}% ${seg.name}`).join(", ");
const rows = mix.map((seg) => `${seg.pct}fr`).join(" ");
---
<section class="alloc" id="allocation" aria-labelledby="alloc-title">
  <div class="alloc-wrap">
    <p class="eyebrow">{eyebrow}</p>
    <div class="alloc-copy">
      <h2 id="alloc-title">
        {heading.map((line) => <span>{line}</span>)}
      </h2>
      <p class="lead">{body}</p>
      <p class="note">{note}</p>
    </div>

    <figure class="board" role="img" aria-label={label} style={`grid-template-rows:${rows}`}>
      <div class="column" aria-hidden="true" style={`grid-row:1 / span ${mix.length}`}>
        {mix.map((seg) => <span class={`seg ${seg.tone}`} style={`flex:${seg.pct}`}></span>)}
      </div>
      {mix.map((seg, index) => (
        <p class={`key ${seg.tone}`} style={`grid-row:${index + 1}`} aria-hidden="true">
          {seg.pct}% {seg.name}
        </p>
      ))}
    </figure>
  </div>
</section>

<style>
  .alloc {
    --tone-growth: #9fc4b0;
    --tone-balance: #8aa4c0;
    --tone-stables: #3d5a80;
    width: 100%;
    padding: clamp(4rem, 9vw, 7rem) clamp(1.15rem, 5vw, 4.5rem);
    box-sizing: border-box;
    scroll-margin-top: var(--nav-h, 4.5rem);
  }
  .alloc-wrap {
    max-width: 72rem;
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  /* Eyebrow on its own row, so the column starts level with the headline. */
  .eyebrow {
    grid-column: 1;
  }
  .alloc-copy {
    grid-column: 1;
    grid-row: 2;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: clamp(2rem, 8vw, 12rem);
    margin: 0 0 clamp(1.75rem, 4vw, 3.25rem);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--emerald);
  }
  .eyebrow::after {
    content: "";
    width: 2.5rem;
    height: 1px;
    background: currentColor;
  }
  /* Four lines, as on the slide: Three / positions. / One growing / reserve. */
  h2 {
    margin: 0;
    max-width: 7em;
    font-size: clamp(2.6rem, 5.6vw, 5.5rem);
    font-weight: 400;
    letter-spacing: 0.005em;
    line-height: 1.1;
  }
  h2 span {
    display: block;
  }
  .lead {
    margin: clamp(1.5rem, 3vw, 2.25rem) 0 0;
    max-width: 22rem;
    font-size: clamp(1.125rem, 1.5vw, 1.35rem);
    line-height: 1.5;
    color: color-mix(in srgb, var(--ink) 62%, var(--paper));
  }
  /* One quiet fact under the lead, set like the eyebrow. */
  .note {
    margin: clamp(1.5rem, 3vw, 2rem) 0 0;
    padding-top: 1rem;
    max-width: 22rem;
    border-top: 1px solid var(--wash);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--emerald);
  }

  /* The column sits level with the headline, the legend to its right. */
  .board {
    --col-w: clamp(7rem, 12.5vw, 15rem);
    grid-column: 2;
    grid-row: 2;
    margin: 0;
    display: grid;
    grid-template-columns: var(--col-w) auto;
    column-gap: clamp(1.5rem, 3.3vw, 4rem);
    justify-content: center;
  }
  .column {
    grid-column: 1;
    display: flex;
    flex-direction: column;
    aspect-ratio: 240 / 640;
    border-radius: clamp(0.9rem, 1.25vw, 1.5rem);
    overflow: hidden;
    /* A thin cut of paper between tramos, so the blocks breathe and never touch. */
    gap: clamp(2px, 0.2vw, 3px);
  }
  /* Soft-light grain over each solid tramo, as in the slide. */
  .seg {
    display: block;
    min-height: 0;
    background-image: url("/grain-softlight-tile.webp");
    background-size: 512px 512px;
    background-blend-mode: soft-light;
  }
  .seg.growth {
    background-color: var(--tone-growth);
  }
  .seg.balance {
    background-color: var(--tone-balance);
  }
  .seg.stables {
    background-color: var(--tone-stables);
  }

  .key {
    grid-column: 2;
    align-self: center;
    margin: 0;
    font-size: clamp(1.6rem, 2.95vw, 3.5rem);
    line-height: 1.1;
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .alloc-wrap {
      grid-template-columns: 1fr;
    }
    /* On the phone the rule closes the section, under the column. */
    .alloc-copy {
      display: contents;
    }
    h2 {
      grid-row: 2;
    }
    .lead {
      grid-row: 3;
    }
    .board {
      grid-column: 1;
      grid-row: 4;
      margin-top: 2.75rem;
    }
    .note {
      grid-row: 5;
      margin-top: 2.5rem;
    }
    .eyebrow {
      gap: 1.25rem;
    }
    .board {
      --col-w: 7.5rem;
      justify-content: start;
    }
  }
</style>
