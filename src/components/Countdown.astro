---
/** ETHGlobal Tokyo 2026 end — Amy confirmed. Event: https://ethglobal.com/events/tokyo2026 */
const TARGET_ISO = "2026-09-27T09:00:00+09:00";
const EVENT_URL = "https://ethglobal.com/events/tokyo2026";
---
<div class="countdown" data-target={TARGET_ISO} aria-live="polite">
  <a class="event-title" href={EVENT_URL} target="_blank" rel="noopener noreferrer">
    <img
      class="avatar"
      src="/tokyo-2026-mark.png"
      width="32"
      height="32"
      alt=""
    />
    <span class="name">ETHGlobal Tokyo 2026</span>
  </a>
  <div class="grid" role="timer" aria-label="Countdown to ETHGlobal Tokyo 2026 — 27 Sep 2026 09:00 JST">
    <div class="cell"><span class="num" data-unit="days">--</span><span class="unit">days</span></div>
    <div class="cell"><span class="num" data-unit="hours">--</span><span class="unit">hrs</span></div>
    <div class="cell"><span class="num" data-unit="mins">--</span><span class="unit">min</span></div>
    <div class="cell"><span class="num" data-unit="secs">--</span><span class="unit">sec</span></div>
  </div>
  <p class="when"><time datetime={TARGET_ISO}>2026-09-27 09:00 JST</time></p>
</div>

<script>
  const root = document.querySelector(".countdown");
  if (root instanceof HTMLElement) {
    const target = Date.parse(root.dataset.target || "");
    const nums = {
      days: root.querySelector('[data-unit="days"]'),
      hours: root.querySelector('[data-unit="hours"]'),
      mins: root.querySelector('[data-unit="mins"]'),
      secs: root.querySelector('[data-unit="secs"]'),
    };
    const pad = (n: number) => String(Math.max(0, n)).padStart(2, "0");
    const tick = () => {
      const diff = target - Date.now();
      if (diff <= 0) {
        if (nums.days) nums.days.textContent = "00";
        if (nums.hours) nums.hours.textContent = "00";
        if (nums.mins) nums.mins.textContent = "00";
        if (nums.secs) nums.secs.textContent = "00";
        // One reload. If the server is already open, / is the site page.
        // If it is not, the key stops a reload loop and the zeros stay.
        try {
          if (!sessionStorage.getItem("mamoru-open-reload")) {
            sessionStorage.setItem("mamoru-open-reload", "1");
            window.location.replace("/");
          }
        } catch {
          // Storage can be blocked. The zeros are enough.
        }
        return;
      }
      const s = Math.floor(diff / 1000);
      const days = Math.floor(s / 86400);
      const hours = Math.floor((s % 86400) / 3600);
      const mins = Math.floor((s % 3600) / 60);
      const secs = s % 60;
      if (nums.days) nums.days.textContent = pad(days);
      if (nums.hours) nums.hours.textContent = pad(hours);
      if (nums.mins) nums.mins.textContent = pad(mins);
      if (nums.secs) nums.secs.textContent = pad(secs);
    };
    tick();
    setInterval(tick, 1000);
  }
</script>

<style>
  .countdown {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: min(28rem, 100%);
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
  }
  .event-title {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    max-width: 100%;
    min-width: 0;
    text-decoration: none;
    color: inherit;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    line-height: 1.2;
  }
  .event-title:hover .name,
  .event-title:focus-visible .name {
    color: var(--ink);
  }
  .avatar {
    display: block;
    width: 1.2em;
    height: 1.2em;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  .name {
    margin: 0;
    font-weight: 600;
    color: var(--ink);
    max-width: 100%;
    overflow-wrap: anywhere;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }
  .cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    padding: 0.85rem 0.7rem 0.75rem;
    min-width: 0;
    background: color-mix(in srgb, var(--wash) 55%, transparent);
    border: 1px solid color-mix(in srgb, var(--ink) 8%, transparent);
  }
  .num {
    font-family: var(--font-mono);
    font-size: clamp(1.4rem, 4vw, 1.85rem);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    color: var(--ink);
  }
  .unit {
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--stone);
  }
  .when {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--emerald);
  }
</style>
