---
import { OPEN_COPY } from "../open-copy";

// The launch film's allocation scene (mamoru-video films/v12-launch, v19), on Kami A: USDC streams into the column,
// which fills tramo by tramo; then the yield of Growth and Balance flows into Stables, which grows. No words inside
// the film. It is a recorded loop, not a live canvas: the canvas version did not paint in Brave (2026-10-27), and a
// video plays the same everywhere, like slide 3 of the deck. One loop is 12 s; the caption follows its clock.
// Sources: frames of the canvas version, rendered frame by frame (wide 1920x800, tall 704x646, the column on its side).
const { eyebrow, lines, aria } = OPEN_COPY.flow;
const films = [
  { id: "wide", w: 1920, h: 800 },
  { id: "tall", w: 704, h: 646 },
];
---
<section class="flow-story" id="works" aria-labelledby="works-title">
  <h2 class="eyebrow" id="works-title">{eyebrow}</h2>
  {films.map((f) => (
    <video
      class={`stage stage-${f.id}`}
      width={f.w}
      height={f.h}
      muted
      autoplay
      loop
      playsinline
      preload="metadata"
      poster={`/flow-media/flow-${f.id}.webp`}
      aria-label={aria}
    >
      <source src={`/flow-media/flow-${f.id}.webm`} type="video/webm" />
      <source src={`/flow-media/flow-${f.id}.mp4`} type="video/mp4" />
    </video>
  ))}
  <p class="caption">
    {lines.map((line, index) => <span data-line={index}>{line}</span>)}
  </p>
</section>

<script>
  // The yield phase of the loop starts at 5.4 s: the second line goes with it.
  const YIELD_AT = 5.4;
  const root = document.querySelector<HTMLElement>(".flow-story");
  const films = [...(root?.querySelectorAll<HTMLVideoElement>(".stage") ?? [])];

  // The loop is how the product works, slow and without flashes: it plays even with reduced motion, like the
  // deck's slide 3. It starts as soon as the page loads (muted autoplay is allowed everywhere) and pauses only
  // while it is off screen. If a browser still refuses, the first tap, click or key on the page starts it.
  if (root && films.length) {
    const live = () => films.find((v) => getComputedStyle(v).display !== "none");
    let offscreen = false;
    let refused = false;
    const sync = () => {
      const v = live();
      films.forEach((f) => f !== v && !f.paused && f.pause());
      if (!v) return;
      if (offscreen) {
        if (!v.paused) v.pause();
        return;
      }
      if (v.paused) {
        v.muted = true;
        v.play().then(
          () => (refused = false),
          () => (refused = true),
        );
      }
    };
    films.forEach((v) => {
      v.muted = true;
      v.addEventListener("timeupdate", () => {
        if (v === live()) root.dataset.line = v.currentTime < YIELD_AT ? "0" : "1";
      });
      // A paused frame never stays: whatever paused it, the loop resumes while on screen.
      v.addEventListener("pause", () => !offscreen && v === live() && !v.ended && setTimeout(sync, 300));
    });
    const nudge = () => refused && sync();
    for (const type of ["pointerdown", "touchstart", "keydown"]) window.addEventListener(type, nudge, { passive: true });
    new IntersectionObserver(
      (entries) => {
        offscreen = !entries.some((e) => e.isIntersecting);
        sync();
      },
      { threshold: 0 },
    ).observe(root);
    window.matchMedia("(max-width: 760px)").addEventListener("change", sync);
    sync();
  }
</script>

<style>
  .flow-story {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    min-width: 0;
    text-align: center;
  }
  .eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 400;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--emerald);
  }
  .stage {
    display: block;
    width: 100%;
    max-width: 60rem;
    aspect-ratio: 960 / 400;
    height: auto;
    margin: clamp(1.75rem, 4vw, 3rem) auto clamp(1.5rem, 3vw, 2.25rem);
    background: transparent;
    /* Drawn on Kami A too: no frame, its edges fade into the page's paper, as on slide 3 of the deck. */
    -webkit-mask-image: radial-gradient(ellipse 72% 68% at 50% 50%, #000 70%, transparent 100%);
    mask-image: radial-gradient(ellipse 72% 68% at 50% 50%, #000 70%, transparent 100%);
  }
  .stage-tall {
    display: none;
    max-width: 22.5rem;
    aspect-ratio: 704 / 646;
  }
  /* Both lines share one cell; the one in play fades in. */
  .caption {
    display: grid;
    margin: 0;
    font-size: clamp(1.4rem, 2.6vw, 2.1rem);
    line-height: 1.25;
  }
  /* The line in play leaves first; the next one comes in after it. */
  .caption span {
    grid-area: 1 / 1;
    opacity: 0;
    transition: opacity 0.45s ease;
  }
  .flow-story:not([data-line]) .caption span[data-line="0"],
  .flow-story[data-line="0"] .caption span[data-line="0"],
  .flow-story[data-line="1"] .caption span[data-line="1"] {
    opacity: 1;
    transition: opacity 0.7s ease 0.45s;
  }

  @media (max-width: 760px) {
    .stage-wide {
      display: none;
    }
    .stage-tall {
      display: block;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .caption span {
      transition: none;
    }
  }
</style>
