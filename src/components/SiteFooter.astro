---
import { OPEN_COPY as copy } from "../open-copy";

const emailHref = `mailto:${copy.footer.email}`;
---
<footer class="foot">
  <div class="row">
    <div class="who">
      <p class="foot-sign">
        <img class="seal" src="/seal-mamoru.png" width="40" height="40" alt="" />
        <span class="seal-word">{copy.footer.name}</span>
      </p>
      <p class="line">{copy.footer.line}</p>
    </div>
    <div class="foot-links">
      <a class="mail" href={emailHref}>{copy.footer.email}</a>
      <a
        class="mail x-link"
        href={copy.footer.x.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${copy.footer.x.handle} on X`}
      >
        <svg class="x-logo" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
        </svg>
        <span>{copy.footer.x.handle}</span>
      </a>
    </div>
  </div>
  <div class="row small">
    <span>{copy.footer.licence}</span>
    <nav class="legal" aria-label="Legal">
      {copy.footer.legal.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
  </div>
</footer>

<style>
  /* Two rows on the FAQ's column: who and contact, then licence and legal. Stacks to the left on a phone. */
  .foot {
    width: 100%;
    max-width: 68rem;
    margin-inline: auto;
    box-sizing: content-box;
    padding: 1.5rem clamp(1.15rem, 5vw, 4.5rem) 2.5rem;
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem 2rem;
  }
  .who {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
  }
  .line {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.45;
  }
  .foot-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
  }
  .mail {
    color: var(--emerald);
    text-underline-offset: 0.16em;
  }
  .mail:hover {
    color: var(--ink);
  }
  .x-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .x-logo {
    width: 0.95rem;
    height: 0.95rem;
    fill: currentColor;
    flex: none;
  }
  /* The seal signs the end of the page, as on the dashboard. */
  .foot-sign {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }
  .seal {
    width: 2.25rem;
    height: auto;
    display: block;
  }
  .seal-word {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.45em;
    text-transform: uppercase;
    color: var(--stone);
  }
  .small {
    margin-top: 1.25rem;
    gap: 0.5rem 2rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--stone);
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
  }
  .legal a {
    color: var(--stone);
    text-decoration: none;
  }
  .legal a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .mail:focus-visible,
  .legal a:focus-visible {
    outline: 2px solid var(--emerald);
    outline-offset: 3px;
  }

  @media (max-width: 760px) {
    .row {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
