---
import { OPEN_COPY as copy } from "../open-copy";

const emailHref = `mailto:${copy.footer.email}`;
---
<footer class="foot">
  <p class="line">{copy.footer.line}</p>
  <div class="foot-links">
    <a class="mail" href={emailHref}>{copy.footer.email}</a>
    <a
      class="mail x-link"
      href={copy.footer.x.href}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`${copy.footer.x.handle} on X`}
    >
      <svg class="x-logo" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
      </svg>
      <span>{copy.footer.x.handle}</span>
    </a>
  </div>
  <p class="foot-sign">
    <img class="seal" src="/seal-mamoru.png" width="40" height="40" alt="" />
    <span class="seal-word">{copy.footer.name}</span>
  </p>
  <nav class="legal" aria-label="Legal">
    {copy.footer.legal.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
</footer>

<style>
  /* One centred column signed by the seal, as on the dashboard. No rule on top: the band above closes the page. */
  .foot {
    width: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
    padding: 2.5rem clamp(1.15rem, 5vw, 4.5rem) 3rem;
  }
  .line {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.45;
  }
  .foot-links {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
  }
  .mail {
    color: var(--emerald);
    text-underline-offset: 0.16em;
  }
  .mail:hover {
    color: var(--ink);
  }
  .x-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .x-logo {
    width: 0.95rem;
    height: 0.95rem;
    fill: currentColor;
    flex: none;
  }
  /* The seal signs the end of the page, as on the dashboard. */
  .foot-sign {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
  }
  .seal {
    width: 2.5rem;
    height: auto;
    display: block;
  }
  .seal-word {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.45em;
    text-transform: uppercase;
    color: var(--stone);
  }
  /* Terms, privacy and risks: small and quiet under the seal, where the sector puts them. */
  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }
  .legal a {
    color: var(--stone);
    text-decoration: none;
  }
  .legal a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .mail:focus-visible,
  .legal a:focus-visible {
    outline: 2px solid var(--emerald);
    outline-offset: 3px;
  }
</style>
