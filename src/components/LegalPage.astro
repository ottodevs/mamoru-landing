---
import Base from "../layouts/Base.astro";
import SiteFooter from "./SiteFooter.astro";
import { APP_HREF, OPEN_COPY as copy } from "../open-copy";
import type { LegalDoc } from "../legal-copy";

interface Props {
  doc: LegalDoc;
}
const { doc } = Astro.props;
---
<Base title={`${doc.title} — Mamoru`} description={doc.summary} canonical={`https://mamoru.lol${doc.path}`}>
  <header class="top">
    <a class="brand" href="/">
      <img src="/mark-two-stones.png" width="28" height="28" alt="" />
      <span>Mamoru</span>
    </a>
    <a class="cta" href={APP_HREF}>{copy.cta}</a>
  </header>

  <main class="doc" id="content">
    <h1>{doc.title}</h1>
    <p class="updated">Last updated {doc.updated}</p>
    <p class="summary">{doc.summary}</p>
    {doc.sections.map((section) => (
      <section>
        <h2>{section.heading}</h2>
        {section.body.map((para) => <p>{para}</p>)}
      </section>
    ))}
  </main>

  <SiteFooter />
</Base>

<style>
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem clamp(1rem, 4vw, 2rem);
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 8%, transparent);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--ink);
    font-size: 1.05rem;
    line-height: 1;
  }
  .brand img {
    width: 1.75rem;
    height: auto;
    display: block;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    padding: 0.7rem 1.15rem;
    background: var(--ink);
    color: var(--paper);
    text-decoration: none;
    font-size: 0.95rem;
    line-height: 1;
    white-space: nowrap;
  }
  .cta:hover {
    background: var(--emerald);
  }
  .brand:focus-visible,
  .cta:focus-visible {
    outline: 2px solid var(--emerald);
    outline-offset: 3px;
  }

  /* One reading column, the landing's serif; the mono only for the date. */
  .doc {
    width: 100%;
    max-width: 42rem;
    margin: 0 auto;
    padding: clamp(2.5rem, 7vw, 4.5rem) clamp(1.15rem, 5vw, 2rem) clamp(2rem, 4vw, 3rem);
    box-sizing: border-box;
  }
  h1 {
    margin: 0;
    font-weight: 400;
    font-size: clamp(2rem, 5vw, 2.75rem);
    line-height: 1.1;
  }
  .updated {
    margin: 0.75rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--stone);
  }
  .summary {
    margin: 1.75rem 0 0;
    font-size: 1.2rem;
    line-height: 1.5;
  }
  section {
    margin-top: 2.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
  }
  h2 {
    margin: 0;
    font-weight: 400;
    font-size: 1.3rem;
    line-height: 1.3;
  }
  section p {
    margin: 0.75rem 0 0;
    font-size: 1.05rem;
    line-height: 1.6;
  }
</style>
